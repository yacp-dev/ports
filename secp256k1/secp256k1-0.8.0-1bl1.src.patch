--- origsrc/secp256k1-0.8.0/Makefile.am	2026-08-03 21:51:27.000000000 +0000
+++ src/secp256k1-0.8.0/Makefile.am	2026-10-25 01:22:41.360715200 +0000
@@ -125,7 +125,7 @@ noinst_PROGRAMS += noverify_tests
 noverify_tests_SOURCES = src/tests.c
 noverify_tests_CPPFLAGS = $(SECP_CONFIG_DEFINES) $(TEST_DEFINES)
 noverify_tests_LDADD = $(COMMON_LIB) $(PRECOMPUTED_LIB)
-noverify_tests_LDFLAGS = -static
+noverify_tests_LDFLAGS = 
 if !ENABLE_COVERAGE
 TESTS += tests
 noinst_PROGRAMS += tests
@@ -152,7 +152,7 @@ exhaustive_tests_CPPFLAGS += -DVERIFY
 endif
 # Note: do not include $(PRECOMPUTED_LIB) in exhaustive_tests (it uses runtime-generated tables).
 exhaustive_tests_LDADD = $(COMMON_LIB)
-exhaustive_tests_LDFLAGS = -static
