HOMEPAGE="https://github.com/tbeu/${PN}"
GIT_URI="https://github.com/tbeu/${PN}.git"
GIT_TAG="v${PV}"
PATCH_URI="
	https://sources.debian.org/data/main/libm/libmatio/1.6.0-2/debian/patches/big-endian.patch
"

CATEGORY="Libs"
SUMMARY="Library for reading and writing matlab files"
DESCRIPTION="matio is an C library for reading and writing Matlab MAT files."

LICENSE="BSD-2-Clause"
LICENSE_SPDX="SPDX-License-Identifier: BSD-2-Clause"
LICENSE_URI="COPYING"

BUILD_REQUIRES="
	gcc-fortran
	libhdf5-devel
	zlib-devel
"

export CPPFLAGS="${CPPFLAGS} -D_GNU_SOURCE"
export LT_LDFLAGS="-no-undefined"

inherit git

CYGCONF_ARGS="
	--enable-maintainer-mode
	--enable-fortran
"

DIFF_EXCLUDES="
	testsuite
	package.m4
"

PKG_NAMES="
	${PN}
	lib${PN}14
	lib${PN}-devel
"
matio_CONTENTS="
	usr/bin/*.exe
	usr/share/doc
"
libmatio14_CONTENTS="
	usr/bin/cyg*-14.dll
"
libmatio_devel_CONTENTS="
	usr/include
	usr/lib
	usr/share/man
"
matio_SUMMARY="${SUMMARY} (utilities)"
libmatio14_SUMMARY="${SUMMARY} (runtime)"
libmatio_devel_SUMMARY="${SUMMARY} (development)"
