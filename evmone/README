  /usr/share/doc/evmone/CHANGELOG.md
  /usr/share/doc/evmone/LICENSE
  /usr/share/doc/evmone/README.md

(libevmone0.25)
  /usr/bin/cygevmone-0.25.dll

(libevmone-devel)
  /usr/include/evmone/evmone.h
  /usr/lib/libevmone.dll.a
  /usr/lib/pkgconfig/evmone.pc

