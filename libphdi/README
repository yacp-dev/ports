  /usr/share/doc/libphdi/ChangeLog
  /usr/share/doc/libphdi/Parallels Hard Disk image format.asciidoc
  /usr/share/doc/libphdi/README
  /usr/share/man/man1/phdiinfo.1.gz
  /usr/share/man/man1/phdimount.1.gz

(libphdi1)
  /usr/bin/cygphdi-1.dll

(libphdi-devel)
  /usr/include/libphdi.h
  /usr/include/libphdi/codepage.h
  /usr/include/libphdi/definitions.h
  /usr/include/libphdi/error.h
  /usr/include/libphdi/extern.h
  /usr/include/libphdi/features.h
  /usr/include/libphdi/types.h
  /usr/lib/libphdi.dll.a
  /usr/lib/pkgconfig/libphdi.pc
  /usr/share/man/man3/libphdi.3.gz

(python312-libphdi)
  /usr/lib/python3.12/site-packages/pyphdi.cpython-312-x86_64-cygwin.dll

