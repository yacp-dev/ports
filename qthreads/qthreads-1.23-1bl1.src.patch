+#elif defined(QTHREADS_CYGWIN)
+// Cygwin has no futex; use the Win32 WaitOnAddress family
+// (libsynchronization). Unlike a futex, WaitOnAddress takes a pointer to
+// the expected value.
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
+#define qt_wait_on_address(a, expected)                                        \
+  do {                                                                         \
+    uint32_t qt_expected_ = (expected);                                        \
+    WaitOnAddress((volatile VOID *)(a), &qt_expected_, 4, INFINITE);           \
+  } while (0)
+
+#define qt_wake_all(a)                                                         \
+  do { WakeByAddressAll((PVOID)(a)); } while (0)
+
+#define qt_wake_one(a)                                                         \
+  do { WakeByAddressSingle((PVOID)(a)); } while (0)
+
