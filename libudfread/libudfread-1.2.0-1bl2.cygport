HOMEPAGE="https://code.videolan.org/videolan/${PN}"
SRC_URI="https://code.videolan.org/videolan/${PN}/-/archive/${PV}/${P}.tar.bz2"

CATEGORY="Libs"
SUMMARY="UDF reader library"
DESCRIPTION="This library allows reading UDF filesystems, like raw devices and image files."

LICENSE="LGPL-2.1-or-later"
LICENSE_SPDX="SPDX-License-Identifier: LGPL-2.1-or-later"
LICENSE_URI="COPYING"

inherit meson

CYGMESON_ARGS="
	-Denable_examples=true
	-Ddefault_library=shared
"

src_install()
{
	cd ${S}
	meson_install

	dobin  _build.${CHOST}/examples/*.exe
}

src_test()
{
	cd ${S}/_build.${CHOST}
	export PATH=${S}/_build.${CHOST}/src:${PATH}

	# the examples print their usage and exit 255 when given no arguments
	for exe in udfcat udfls
	do
		rc=0
		out=$(verbose ./examples/${exe}.exe 2>&1) || rc=$?
		echo "${out}"
		if [ ${rc} -ne 255 ] || ! echo "${out}" | grep -q "^usage: ${exe}"
		then
			error "${exe}.exe did not print its usage (exit ${rc})"
		fi
	done
}

PKG_NAMES="
	libudfread
	libudfread3
	libudfread-devel
"
libudfread_CONTENTS="
	usr/bin/*.exe
	usr/share
"
libudfread3_CONTENTS="
	usr/bin/cyg*-3.dll
"
libudfread_devel_CONTENTS="
	usr/include
	usr/lib
"
libudfread_SUMMARY="${SUMMARY} (utilities)"
libudfread3_SUMMARY="${SUMMARY} (runtime)"
libudfread_devel_SUMMARY="${SUMMARY} (development)"
