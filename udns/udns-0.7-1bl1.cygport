HOMEPAGE="https://www.corpit.ru/mjt/${PN}.html"
SRC_URI="
	https://www.corpit.ru/mjt/${PN}/${P}.tar.gz
	CMakeLists.txt
	udns.pc.in
"

CATEGORY="Net"
SUMMARY="DNS resolver library"
DESCRIPTION="UDNS is a stub DNS resolver library with ability to perform both syncronous
and asyncronous DNS queries."

LICENSE="LGPL-2.1-or-later"
LICENSE_SPDX="SPDX-License-Identifier: LGPL-2.1-or-later"
LICENSE_URI="COPYING.LGPL"

inherit cmake

src_test()
{
	cd ${B}
	./dnsget.exe -h
}

DOCS="
	COPYING.LGPL
"

PKG_NAMES="
	${PN}
	lib${PN}0
	lib${PN}-devel
"
udns_CONTENTS="
	usr/bin/*.exe
	usr/share/doc
	usr/share/man/man1
"
libudns0_CONTENTS="
	usr/bin/cyg*-0.dll
"
libudns_devel_CONTENTS="
	usr/include
	usr/lib
	usr/share/man/man3
"
udns_SUMMARY="${SUMMARY} (utilities)"
libudns0_SUMMARY="${SUMMARY} (runtime)"
libudns_devel_SUMMARY="${SUMMARY} (development)"
