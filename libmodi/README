  /usr/include/libmodi/features.h
  /usr/include/libmodi/types.h
  /usr/lib/libmodi.dll.a
  /usr/lib/pkgconfig/libmodi.pc
  /usr/share/man/man3/libmodi.3.gz

(python312-libmodi)
  /usr/lib/python3.12/site-packages/pymodi.cpython-312-x86_64-cygwin.dll

