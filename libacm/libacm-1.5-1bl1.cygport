HOMEPAGE="https://github.com/markokr/${PN}"
SRC_URI="https://github.com/markokr/${PN}/archive/refs/tags/${PN}_v${PV}.tar.gz"
SRC_DIR="${PN}-${PN}_v${PV}"

CATEGORY="Libs"
SUMMARY="Library for InterPlay ACM Audio format"
DESCRIPTION="${SUMMARY}"

LICENSE="ISC"
LICENSE_SPDX="SPDX-License-Identifier: ISC"
LICENSE_URI="COPYING"

BUILD_REQUIRES="
	libao-devel
"

PKG_NAMES="
	libacm
	libacm1
	libacm-devel
"
libacm_CONTENTS="
	usr/bin/*.exe
	usr/share
"
libacm1_CONTENTS="
	usr/bin/cyg*-1.dll
"
libacm_devel_CONTENTS="
	usr/include
	usr/lib
"
libacm_SUMMARY="${SUMMARY} (licensing & readmes)"
libacm1_SUMMARY="${SUMMARY} (runtime)"
libacm_devel_SUMMARY="${SUMMARY} (development)"

CYGPORT_USE_UNSTABLE_API=1
src_patch_hook()
{
	cd ${origsrcdir}/${SRC_DIR}
	verbose sed -i -e "s/AC_INIT(\[libacm\],\[[^]]*\]/AC_INIT([libacm],[${PV}]/" configure.ac
}
