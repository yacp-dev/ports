+++ src/sagittarius-0.9.15/ext/socket/selector-poll.c	2026-11-09 16:00:38.314990500 +0000
@@ -0,0 +1,77 @@
+/* selector-poll.c                                 -*- mode:c; coding:utf-8; -*-
+ *
+ * poll(2) based socket selector for Cygwin, which has neither epoll nor kqueue.
+ * Modeled after selector-epoll.c; distributed under the same terms as
+ * Sagittarius itself (see COPYING).
+ */
+
+#include <sagittarius.h>
+#define LIBSAGITTARIUS_EXT_BODY
+#include <sagittarius/extend.h>
+#include "socket-selector.h"
+#include <string.h>
+#include <fcntl.h>
+#include <poll.h>
+
+#include "unix-socket-selector.incl"
+
+/* poll(2) needs no kernel object, but the context wants a closable fd. */
+static int make_selector()
+{
+  return open("/dev/null", O_RDONLY);
+}
+
+static SgObject wait_selector(unix_context_t *ctx, int nsock,
+			      SgObject sockets, struct timespec *sp,
+			      int *err)
+{
+  int n = nsock + 1, i, c, timeout = -1;
+  SgObject r = SG_NIL, cp;
+  struct pollfd *fds, local_fds[128];
+  SgObject *slots, local_slots[128];
+
+  if (n > 128) {
+    fds = SG_NEW_ATOMIC2(struct pollfd *, n * sizeof(struct pollfd));
+    slots = SG_NEW_ARRAY(SgObject, n);
+  } else {
+    fds = local_fds;
+    slots = local_slots;
+  }
+  if (sp) {
+    timeout = (int)(sp->tv_sec * 1000 + (sp->tv_nsec + 999999) / 1000000);
+  }
+
+  i = 0;
+  fds[i].fd = ctx->stop_fd;
+  fds[i].events = POLLIN;
+  fds[i].revents = 0;
+  slots[i++] = SG_FALSE;
+  SG_FOR_EACH(cp, sockets) {
+    SgObject slot = SG_CAR(cp);
+    fds[i].fd = SG_SOCKET(SG_CAR(slot))->socket;
+    fds[i].events = POLLIN;
+    fds[i].revents = 0;
+    slots[i++] = slot;
+  }
+
+  c = poll(fds, n, timeout);
+  /* timeout and signal are expected, as epoll does */
+  if (c < 0 && errno != EINTR) {
+    *err = errno;
+    return SG_FALSE;
+  }
+  if (c <= 0) return r;
+
+  for (i = 0; i < n; i++) {
+    if (fds[i].revents & POLLNVAL) {
+      *err = EBADF;
+      return SG_FALSE;
+    }
+    if (SG_FALSEP(slots[i])) {
+      if (fds[i].revents) interrupted_unix_stop(ctx);
+    } else if (fds[i].revents & (POLLIN | POLLHUP | POLLERR)) {
+      r = Sg_Cons(slots[i], r);
+    }
+  }
+  return r;
+}
