@@ -15,6 +15,22 @@ from http.server import HTTPServer, Base
 from pathlib import Path
 
 
+class TLSHTTPServer(HTTPServer):
+    """HTTPServer that wraps each accepted connection in TLS.
+
+    Wrapping the listening socket instead fails on Cygwin: ssl.wrap_socket()
+    probes it with recv(1), which Cygwin answers with EAGAIN rather than
+    ENOTCONN/EINVAL, so Python raises BlockingIOError.
+    """
+    ssl_context = None
+
+    def get_request(self):
+        sock, addr = self.socket.accept()
+        if self.ssl_context is not None:
+            sock = self.ssl_context.wrap_socket(sock, server_side=True)
+        return sock, addr
+
+
 class JWKSHandler(BaseHTTPRequestHandler):
     """HTTP handler for JWKS and discovery endpoints."""
     
