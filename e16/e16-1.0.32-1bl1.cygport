HOMEPAGE="https://www.enlightenment.org/${PN}"
SRC_URI="https://prdownloads.sourceforge.net/enlightenment/${P}.tar.gz"
PATCH_URI="
	https://raw.githubusercontent.com/gentoo/gentoo/refs/heads/master/x11-wm/${PN}/files/${PN}-1.0.31-fix-docdir.patch
"

CATEGORY="X11"
SUMMARY="Predecessor of the current E24 Enlightenment Window Manager"
DESCRIPTION="E16 is predecessor of the current E24 Enlightenment Window Manager, which is
rather complete rewrite than incremental update of E16. Although most of the
current development focus goes to E24, E16 is still under independent active
development and some users prefer it to E24. In this sense E16 will keep its
name while incrementing the versions from 1.0.0 unlike the mainstream
Enlightenment manager, which is likely going to increment its E-suffix number.
This page should summarize the links related to E16."

LICENSE="MIT"
LICENSE_SPDX="SPDX-License-Identifier: MIT"
LICENSE_URI="COPYING"

BUILD_REQUIRES="
	asciidoc
	gettext-devel
	libdbus1-devel
	libGL-devel
	libglib2.0-devel
	libGLU-devel
	libICE-devel
	libiconv-devel
	libImlib2-devel
	libintl-devel
	libpango1.0-devel
	libpulse-devel
	libSM-devel
	libsndfile-devel
	libX11-devel
	libXcomposite-devel
	libXdamage-devel
	libXext-devel
	libXfixes-devel
	libXft-devel
	libXi-devel
	libXinerama-devel
	libXpresent-devel
	libXrandr-devel
	libXrender-devel
	libXss-devel
"

CYGCONF_ARGS="
	--enable-dbus
	--enable-hints-gnome
	--enable-xi2
	--enable-glx
	--enable-xpresent
	--enable-xscrnsaver
	--disable-libhack
"

src_install() {
	cd ${B}
	cyginstall

	# Upstream's misc/Makefile.am (install-data-hook) points
	# /usr/bin/starte16 at the absolute /usr/share/e16/misc/starte16.
	# Without e16 installed on the build system, `readlink -f` on it
	# fails, which makes cygport's __list_deps abort silently and
	# `cygport dep` print nothing.  Point it relatively instead; drop
	# this once cygport guards that readlink -f.
	verbose rm -f ${D}/usr/bin/starte16
	dosym ../share/e16/misc/starte16 /usr/bin/starte16
}
