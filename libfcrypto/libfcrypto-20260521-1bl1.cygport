HOMEPAGE="https://github.com/libyal/${PN}"
SRC_URI="https://github.com/libyal/${PN}/archive/refs/tags/${PV}.tar.gz"

CATEGORY="Libs"
SUMMARY="Library for encryption formats"
DESCRIPTION="libfcrypto is a library for encryption formats."

LICENSE="LGPL-3.0-or-later"
LICENSE_SPDX="SPDX-License-Identifier: LGPL-3.0-or-later"
LICENSE_URI="COPYING.LESSER"

BUILD_REQUIRES="
	gettext-devel
	libcerror-devel
	python3-devel
"

CYGCONF_ARGS="
	--enable-python
"

CYGPORT_USE_UNSTABLE_API=1
src_patch_hook()
{
	cd ${origsrcdir}/${SRC_DIR}
	chmod -R u+x tests/*.{py,sh}
}

src_test()
{
	cd ${B}
	pushd tests
		for sh in ${S}/tests/*.{py,sh}
		do
			cp -f ${sh} .
		done
	popd
	pushd pyfcrypto/.libs
		python_tag=$(python3 -c 'import sysconfig; print(sysconfig.get_config_var("EXT_SUFFIX"))')
		cp -a pyfcrypto.dll pyfcrypto${python_tag}
		cp -a pyfcrypto.dll ${B}/tests/
		cp -a pyfcrypto${python_tag} ${B}/tests/
	popd
	PATH="${B}/libfcrypto/.libs:${B}/pyfcrypto/.libs:${PATH}" \
	PYTHON=python3 \
	CHECK_WITH_STDERR=1 \
	cygtest
	rm -f tests/*.{py,sh} tests/pyfcrypto*
}

src_install()
{
	cd ${B}
	cyginstall

	pushd ${D}/usr/lib/python3.12/site-packages
		python_tag=$(python3 -c 'import sysconfig; print(sysconfig.get_config_var("EXT_SUFFIX"))')
		cp -a pyfcrypto.dll pyfcrypto${python_tag}
	popd
}

DOCS="
	COPYING.LESSER
"

PKG_NAMES="
	${PN}
	${PN}1
	${PN}-devel
	python312-${PN}
"
libfcrypto_CONTENTS="
	usr/share/doc
"
libfcrypto1_CONTENTS="
	usr/bin/cyg*-1.dll
"
libfcrypto_devel_CONTENTS="
	usr/include
	usr/lib/lib*.dll.a
	usr/lib/pkgconfig
	usr/share/man
"
python312_libfcrypto_CONTENTS="
	usr/lib/python3.12
"
libfcrypto_SUMMARY="${SUMMARY} (licensing & readmes)"
libfcrypto1_SUMMARY="${SUMMARY} (runtime)"
libfcrypto_devel_SUMMARY="${SUMMARY} (development)"
python312_libfcrypto_SUMMARY="${SUMMARY} (python312 bindings)"
