Cygwin: libglnx's libcontainer (sys/prctl.h, Linux namespaces) is Linux-only and
libgsystem does not use it; its -lattr is not needed. Cygwin has no
sendfile() or _IOW, and its unistd.h lacks TEMP_FAILURE_RETRY, so define
replacements; copy_bytes() takes its read()/write() fallback. gio.h does not
include gfiledescriptorbased.h any more. Drop -Werror=declaration-after-statement:
it also applies to the C file g-ir-scanner generates, which mixes declarations
and code.

--- a/configure.ac
+++ b/configure.ac
@@ -19,8 +19,7 @@
 		-Werror=implicit-function-declaration \
 		-Werror=pointer-arith -Werror=init-self -Werror=format=2 \
 		-Werror=format-security \
-		-Werror=missing-include-dirs -Werror=aggregate-return \
-		-Werror=declaration-after-statement"
+		-Werror=missing-include-dirs -Werror=aggregate-return"
 fi
 changequote([,])dnl
 AC_SUBST(WARN_CFLAGS)
--- a/libglnx/glnx-fdio.c
+++ b/libglnx/glnx-fdio.c
@@ -28,11 +28,28 @@
 #include <stdint.h>
 #include <stdbool.h>
 #include <sys/ioctl.h>
-#include <sys/sendfile.h>
 #include <errno.h>
+#ifdef __CYGWIN__
+/* Cygwin has no sendfile(); copy_bytes() falls back to read()/write() */
+#define sendfile(out, in, offset, count) (errno = ENOSYS, -1)
+#else
+#include <sys/sendfile.h>
+#endif
 /* See linux.git/fs/btrfs/ioctl.h */
 #define BTRFS_IOCTL_MAGIC 0x94
+#ifdef _IOW
 #define BTRFS_IOC_CLONE _IOW(BTRFS_IOCTL_MAGIC, 9, int)
+#else
+/* Cygwin has no _IOW; the value is _IOW(0x94, 9, int) on Linux */
+#define BTRFS_IOC_CLONE 0x40049409
+#endif
+#ifndef TEMP_FAILURE_RETRY
+#define TEMP_FAILURE_RETRY(expression) \
+  ({ long int __result; \
+     do __result = (long int) (expression); \
+     while (__result == -1L && errno == EINTR); \
+     __result; })
+#endif
 
 #include <glnx-fdio.h>
 #include <glnx-dirfd.h>
--- a/libglnx/libglnx.h
+++ b/libglnx/libglnx.h
@@ -30,7 +30,6 @@
 #include <glnx-dirfd.h>
 #include <glnx-shutil.h>
 #include <glnx-xattrs.h>
-#include <glnx-libcontainer.h>
 #include <glnx-console.h>
 #include <glnx-fdio.h>
 
