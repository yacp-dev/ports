HOMEPAGE="https://github.com/ktakashi/${PN}"
SRC_URI="https://github.com/ktakashi/${PN}/releases/download/v${PV}/sagittarius-${PV}.tar.gz"
SRC_DIR="sagittarius-${PV}"

CATEGORY="Scheme"
SUMMARY="Free Scheme implementation supporting R6RS and R7RS"
DESCRIPTION="${SUMMARY}"

LICENSE="BSD-2-Clause AND BSD-3-Clause AND CC0-1.0 AND MIT AND Unlicense"
LICENSE_SPDX="SPDX-License-Identifier: BSD-2-Clause AND BSD-3-Clause AND CC0-1.0 AND MIT AND Unlicense"
LICENSE_URI="COPYING"

BUILD_REQUIRES="
	libffi-devel
	libgc-devel
	libiodbc-devel
	libssl-devel
	zlib-devel
"

inherit cmake

CYGCMAKE_ARGS="
	-DODBC_LIBRARIES:STRING=iodbc
"

src_install()
{
	cd ${B}
	ninja_install

	# Extension modules are only dlopen()ed; nothing links against their import libraries
	rm -f ${D}/usr/lib/sagittarius/${PV}/x86_64-pc-cygwin/*.dll.a
}

# cygport check takes about 28 minutes on the CI runner (crypto/vector tests)
YACP_CHECK_TIMEOUT_MINUTES=35

src_test()
{
	cd ${B}
	ninja_test
}

PKG_IGNORE="
	usr/lib/cygsagittarius-${PV}.dll
	usr/lib/cygsagittarius.dll
	usr/lib/sagittarius/${PV}/x86_64-pc-cygwin/compile-sagittarius
	usr/lib/sagittarius/${PV}/x86_64-pc-cygwin/cygsagittarius-${PV}.dll
	usr/lib/sagittarius/${PV}/x86_64-pc-cygwin/sagittarius-config
	usr/lib/sagittarius/${PV}/x86_64-pc-cygwin/sagittarius-package
	usr/lib/sagittarius/${PV}/x86_64-pc-cygwin/sagittarius.exe
	usr/lib/sagittarius/${PV}/x86_64-pc-cygwin/sash
"

PKG_NAMES="
	sagittarius-scheme
	libsagittarius${PV}
	libsagittarius-devel
"
sagittarius_scheme_CONTENTS="
	usr/bin/*.exe
	usr/bin/sash
	usr/lib/sagittarius/${PV}/x86_64-pc-cygwin/sagittarius--*.dll
	usr/share/doc
	usr/share/sagittarius/${PV}/lib
	usr/share/sagittarius/${PV}/sitelib
"
libsagittarius0_9_15_CONTENTS="
	usr/bin/cygsagittarius-${PV}.dll
"
libsagittarius_devel_CONTENTS="
	usr/bin/compile-*
	usr/bin/sagittarius-*
	usr/include
	usr/lib/lib*.dll.a
	usr/lib/pkgconfig
	usr/lib/sagittarius/${PV}/include
	usr/share/sagittarius/${PV}/CMakeLists.txt.template
	usr/share/sagittarius/${PV}/cmake*
	usr/share/sagittarius/${PV}/doc
	usr/share/sagittarius/${PV}/template*
"
sagittarius_scheme_SUMMARY="${SUMMARY} (utilities)"
libsagittarius0_9_15_SUMMARY="${SUMMARY} (runtime)"
libsagittarius_devel_SUMMARY="${SUMMARY} (development)"
