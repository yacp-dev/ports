HOMEPAGE="https://github.com/${PN}/${PN}"
SRC_URI="https://github.com/${PN}/${PN}/archive/refs/tags/v${PV}.tar.gz"

CATEGORY="Libs"
SUMMARY="HTML Renderer library"
DESCRIPTION="The lexbor project is being developed using the C language, without
dependencies."

LICENSE="Apache-2.0 AND BSD-2-Clause"
LICENSE_SPDX="SPDX-License-Identifier: Apache-2.0 AND BSD-2-Clause"
LICENSE_URI="LICENSE"

inherit cmake

CYGCMAKE_ARGS="
	-DLEXBOR_BUILD_STATIC:BOOL=OFF
	-DLEXBOR_BUILD_TESTS:BOOL=ON
"

src_test()
{
	cd ${B}
	PATH=${B}:${B}/test:${PATH} ninja_test
}

PKG_NAMES="
	lexbor
	liblexbor3
	liblexbor-devel
"
lexbor_CONTENTS="
	usr/share
"
liblexbor3_CONTENTS="
	usr/bin/cyg*-3.dll
"
liblexbor_devel_CONTENTS="
	usr/include
	usr/lib
"
lexbor_SUMMARY="${SUMMARY} (licensing & readmes)"
liblexbor3_SUMMARY="${SUMMARY} (runtime)"
liblexbor_devel_SUMMARY="${SUMMARY} (development)"
