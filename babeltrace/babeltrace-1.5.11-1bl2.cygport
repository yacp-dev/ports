HOMEPAGE="https://babeltrace.org/"
SRC_URI="https://www.efficios.com/files/${PN}/${P}.tar.bz2"
PATCH_URI="
	https://sources.debian.org/data/main/b/babeltrace/1.5.11-6.1/debian/patches/Fix-handle-NULL-list-pointer-to-avoid-Python-segfaul.patch
	https://sources.debian.org/data/main/b/babeltrace/1.5.11-6.1/debian/patches/Print-a-clear-error-when-reading-a-CTF-2-trace.patch
	babeltrace-1.5.11-python-helper-dll.patch
"

CATEGORY="Libs"
SUMMARY="Trace Viewer and Converter, mainly for the Common Trace Format"
DESCRIPTION="This project provides trace read and write libraries, as well as a trace
converter. A plugin can be created for any trace format to allow its conversion
to/from another trace format."

LICENSE="MIT"
LICENSE_SPDX="SPDX-License-Identifier: MIT"
LICENSE_URI="mit-license.txt"

BUILD_REQUIRES="
	libglib2.0-devel
	libpopt-devel
	libuuid-devel
	python3-devel
	swig
"

CYGCONF_ARGS="
	--enable-maintainer-mode
	--enable-python-bindings
	--disable-debug-info
"

PKG_NAMES="
	${PN}
	lib${PN}1
	lib${PN}-devel
	python312-${PN}
"
babeltrace_CONTENTS="
	usr/bin/*.exe
	usr/share
"
libbabeltrace1_CONTENTS="
	usr/bin/cyg*-1.dll
"
libbabeltrace_devel_CONTENTS="
	usr/include
	usr/lib/lib${PN}*
	usr/lib/pkgconfig
"
python312_babeltrace_CONTENTS="
	usr/lib/python3.12
"
babeltrace_SUMMARY="${SUMMARY} (utilities)"
libbabeltrace1_SUMMARY="${SUMMARY} (runtime)"
libbabeltrace_devel_SUMMARY="${SUMMARY} (development)"
python312_babeltrace_SUMMARY="${SUMMARY} (python3.12 bindings)"
