HOMEPAGE="https://github.com/libpwquality/${PN}"
SRC_URI="https://github.com/libpwquality/${PN}/releases/download/${P}/${P}.tar.bz2"
PATCH_URI="
	https://src.fedoraproject.org/rpms/${PN}/raw/25ca6c50b3b7e529dd99f71d9641f23054d60e6e/f/setuptools.patch
	libpwquality-1.4.5-setup-py-srcdir.patch
"

CATEGORY="Libs"
SUMMARY="Library for password generation and password quality checking"
DESCRIPTION="The libpwquality library purpose is to provide common functions for
password quality checking and also scoring them based on their apparent
randomness. The library also provides a function for generating random passwords
with good pronounceability. The library supports reading and parsing of a
configuration file."

LICENSE="BSD-3-Clause OR GPL-2.0-or-later"
LICENSE_SPDX="SPDX-License-Identifier: BSD-3-Clause OR GPL-2.0-or-later"
LICENSE_URI="COPYING"

BUILD_REQUIRES="
	gettext-devel
	libcrack-devel
	python3-devel
	python312-setuptools
"

CYGCONF_ARGS="
	--disable-static
"

# python/setup.py and src/pwquality.pc are generated by configure from *.in
DIFF_EXCLUDES="
	pwquality.pc
	setup.py
"

PKG_NAMES="
	${PN}
	${PN}1
	${PN}-devel
	python312-${PN}
"
libpwquality_CONTENTS="
	etc
	usr/bin/*.exe
	usr/share/doc
	usr/share/man/man1
	usr/share/man/man5
"
libpwquality1_CONTENTS="
	usr/bin/cygpwquality-1.dll
	usr/share/locale
"
libpwquality_devel_CONTENTS="
	usr/include
	usr/lib/libpwquality.dll.a
	usr/lib/pkgconfig
	usr/share/man/man3
"
python312_libpwquality_CONTENTS="
	usr/lib/python3.12
"

libpwquality_SUMMARY="${SUMMARY} (utilities)"
libpwquality1_SUMMARY="${SUMMARY} (runtime)"
libpwquality_devel_SUMMARY="${SUMMARY} (development)"
python312_libpwquality_SUMMARY="${SUMMARY} (python312 binding)"
