HOMEPAGE="https://github.com/macosforge/${PN}"
GIT_URI="https://github.com/macosforge/${PN}.git"
GIT_REV="c38887c5c5e64a4b31108733bd79ca9b2496d987"

CATEGORY="Audio"
SUMMARY="Apple Lossless Audio Codec"
DESCRIPTION="The Apple Lossless Audio Codec (ALAC) is an audio codec developed by Apple and
supported on iPhone, iPad, most iPods, Mac and iTunes. ALAC is a data
compression method which reduces the size of audio files with no loss of
information. A decoded ALAC stream is bit-for-bit identical to the original
uncompressed audio file."

LICENSE="Apache-2.0"
LICENSE_SPDX="SPDX-License-Identifier: Apache-2.0"
LICENSE_URI="LICENSE"

inherit cmake
inherit git

SRC_URI+="
	CMakeLists.txt
	alac.pc.in
"

DOCS="
	ALACMagicCookieDescription.txt
	ReadMe.txt
"

# Upstream has no tests: check that alacconvert starts and prints its usage
# (-h exits with 1 after the usage).
src_test() {
	cd ${B}
	local rc=0
	verbose ./alacconvert.exe -h > usage.txt || rc=$?
	[ ${rc} -eq 1 ] || return 1
	verbose grep -q '^Usage:' usage.txt
}

PKG_NAMES="
	${PN}
	lib${PN}0
	lib${PN}-devel
"
alac_CONTENTS="
	usr/bin/*.exe
	usr/share
"
libalac0_CONTENTS="
	usr/bin/cyg*-0.dll
"
libalac_devel_CONTENTS="
	usr/include
	usr/lib
"
alac_SUMMARY="${SUMMARY} (utilities)"
libalac0_SUMMARY="${SUMMARY} (runtime)"
libalac_devel_SUMMARY="${SUMMARY} (development)"
