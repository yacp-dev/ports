HOMEPAGE="https://github.com/libyal/${PN}"
SRC_URI="https://github.com/libyal/${PN}/archive/refs/tags/${PV}.tar.gz"

CATEGORY="Libs"
SUMMARY="Library for Windows Property Store data types"
DESCRIPTION="libfwps is a library for Windows Property Store data types."

LICENSE="LGPL-3.0-or-later"
LICENSE_SPDX="SPDX-License-Identifier: LGPL-3.0-or-later"
LICENSE_URI="COPYING.LESSER"

BUILD_REQUIRES="
	gettext-devel
	libcdata-devel
	libcerror-devel
	libclocale-devel
	libcnotify-devel
	libcthreads-devel
	libfdatetime-devel
	libfguid-devel
	libuna-devel
	python3-devel
"

CYGPORT_USE_UNSTABLE_API=1
src_patch_hook()
{
	cd ${origsrcdir}/${SRC_DIR}
	chmod u+x tests/*.{py,sh}
}

CYGCONF_ARGS="
	--enable-python
"

src_test()
{
	cd ${B}
	pushd tests
		for f in ${S}/tests/*.{py,sh}
		do
			cp -f ${f} .
		done
		cp -f ${B}/pyfwps/.libs/pyfwps.dll .
	popd
	CHECK_WITH_STDERR=1 PYTHON=python3 PATH=${B}/${PN}/.libs:${B}/pyfwps/.libs:${PATH} cygtest
	rm -f tests/*.{py,sh} tests/pyfwps.dll
}

DOCS="
	COPYING.LESSER
"

PKG_NAMES="
	${PN}
	${PN}1
	${PN}-devel
	python312-${PN}
"
libfwps_CONTENTS="
	usr/share/doc
"
libfwps1_CONTENTS="
	usr/bin/cyg*-1.dll
"
libfwps_devel_CONTENTS="
	usr/include
	usr/lib/lib*.dll.a
	usr/lib/pkgconfig
	usr/share/man
"
python312_libfwps_CONTENTS="
	usr/lib/python3.12
"
libfwps_SUMMARY="${SUMMARY} (licensing & readmes)"
libfwps1_SUMMARY="${SUMMARY} (runtime)"
libfwps_devel_SUMMARY="${SUMMARY} (development)"
python312_libfwps_SUMMARY="${SUMMARY} (python312 bindings)"
