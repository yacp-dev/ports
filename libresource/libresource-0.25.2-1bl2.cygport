HOMEPAGE="https://github.com/sailfishos/${PN}"
GIT_URI="https://github.com/sailfishos/${PN}.git"
GIT_TAG="${PV}"

CATEGORY="Libs"
SUMMARY="Libplayback replacement library"
DESCRIPTION="${SUMMARY}"

LICENSE="LGPL-2.1-or-later AND (AFL-2.1 OR GPL-2.0-or-later)"
LICENSE_SPDX="SPDX-License-Identifier: LGPL-2.1-or-later AND (AFL-2.1 OR GPL-2.0-or-later)"
LICENSE_URI="COPYING"

BUILD_REQUIRES="
	dbus
	libdbus1-devel
	libglib2.0-devel
"

inherit git 

CYGPORT_USE_UNSTABLE_API=1
src_patch_hook()
{
	cd ${origsrcdir}/${SRC_DIR}
	echo ${PV} > .tarball-version
}

src_test()
{
	cd ${B}
	# tests/Makefile.am lists TESTS = resource-test, which no rule builds
	verbose cygmake -C dbus-gmain check DBUS_RUN_SESSION=dbus-run-session
}

DIFF_EXCLUDES="
	.version
"

PKG_NAMES="
	${PN}
	${PN}0
	${PN}-devel
"
libresource_CONTENTS="
	usr/bin/*.exe
	usr/share
"
libresource0_CONTENTS="
	usr/bin/cyg*-0.dll
"
libresource_devel_CONTENTS="
	usr/include
	usr/lib
"
libresource_SUMMARY="${SUMMARY} (utilities)"
libresource0_SUMMARY="${SUMMARY} (runtime)"
libresource_devel_SUMMARY="${SUMMARY} (development)"
