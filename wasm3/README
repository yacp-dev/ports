  /usr/share/doc/wasm3/Installation.md
  /usr/share/doc/wasm3/Interpreter.md
  /usr/share/doc/wasm3/LICENSE
  /usr/share/doc/wasm3/Performance.md
  /usr/share/doc/wasm3/README.md
  /usr/share/doc/wasm3/Testing.md
  /usr/share/doc/wasm3/Troubleshooting.md
  /usr/share/doc/wasm3/Validation.md

