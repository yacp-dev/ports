HOMEPAGE="https://github.com/libyal/${PN}"
SRC_URI="https://github.com/libyal/${PN}/archive/refs/tags/${PV}.tar.gz"

CATEGORY="Libs"
SUMMARY="Library for Mac OS data types"
DESCRIPTION="libfmos is a library for Mac OS data types."

LICENSE="LGPL-3.0-or-later"
LICENSE_SPDX="SPDX-License-Identifier: LGPL-3.0-or-later"
LICENSE_URI="COPYING.LESSER"

BUILD_REQUIRES="
	gettext-devel
	libcerror-devel
	libcnotify-devel
	libcthreads-devel
	python3-devel
"

CYGPORT_USE_UNSTABLE_API=1
src_patch_hook()
{
	cd ${origsrcdir}/${SRC_DIR}/tests
	chmod u+x *.sh *.py
}

CYGCONF_ARGS="
	--enable-python
"

src_test()
{
	cd ${B}
	pushd tests
		for sh in ${S}/tests/*.sh ${S}/tests/*.py
		do
			cp -f ${sh} .
		done
	popd
	CHECK_WITH_STDERR=1 PYTHON=python3 PYTHONPATH=${B}/pyfmos/.libs PATH=${B}/libfmos/.libs:${B}/pyfmos/.libs:${PATH} cygtest
	rm -f tests/*.sh tests/*.py
}

PKG_NAMES="
	libfmos
	libfmos1
	libfmos-devel
	python312-libfmos
"
libfmos_CONTENTS="
	usr/share/doc
"
libfmos1_CONTENTS="
	usr/bin/cyg*-1.dll
"
libfmos_devel_CONTENTS="
	usr/include
	usr/lib/lib*.dll.a
	usr/lib/pkgconfig
	usr/share/man/man3
"
python312_libfmos_CONTENTS="
	usr/lib/python3.12
"
libfmos_SUMMARY="${SUMMARY} (licensing & readmes)"
libfmos1_SUMMARY="${SUMMARY} (runtime)"
libfmos_devel_SUMMARY="${SUMMARY} (development)"
python312_libfmos_SUMMARY="${SUMMARY} (python312 bindings)"
