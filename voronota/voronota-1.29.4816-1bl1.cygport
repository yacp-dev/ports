HOMEPAGE="https://github.com/kliment-olechnovic/${PN}"
SRC_URI="https://github.com/kliment-olechnovic/${PN}/archive/refs/tags/v${PV}.tar.gz"
PATCH_URI="
	https://sources.debian.org/data/main/${PN:0:1}/${PN}/${PV}%2Bds-1/debian/patches/use-system-packages.patch
"

CATEGORY="Science"
SUMMARY="Voronoi diagram-based tool to find atom contacts"
DESCRIPTION="Voronota is a software tool for analyzing three-dimensional structures of
biological macromolecules using the Voronoi diagram of atomic balls."

LICENSE="MIT AND Apache-2.0 AND BSD-2-Clause AND BSD-3-Clause AND Unlicense AND Zlib"
LICENSE_SPDX="SPDX-License-Identifier: MIT AND Apache-2.0 AND BSD-2-Clause AND BSD-3-Clause AND Unlicense AND Zlib"
LICENSE_URI="LICENSE.txt"

BUILD_REQUIRES="
	libduktape-devel
	libGL-devel
	libGLEW-devel
	libglfw-devel
	glm-devel
	liblinenoise-devel
	liblodepng-devel
	libXrandr-devel
"

inherit cmake

CYGCMAKE_ARGS="
	-DEXPANSION_GL:BOOL=ON
	-DEXPANSION_JS:BOOL=ON
	-DEXPANSION_LT:BOOL=ON
"

src_install()
{
	cd ${B}
	ninja_install

	# the bundled libraries' license texts are all named LICENSE
	cd ${S}
	newdoc expansion_js/src/dependencies/gemmi/third_party/fast_float/LICENSE LICENSE.Apache-2.0
	newdoc expansion_js/src/dependencies/linenoise/LICENSE LICENSE.BSD-2-Clause
	newdoc expansion_js/src/dependencies/lodepng/LICENSE LICENSE.Zlib
	newdoc expansion_js/src/dependencies/tinf/LICENSE LICENSE.Zlib.tinf
}

src_test()
{
	cd ${B}
	# voronota prints its usage and exits 1 when given no command
	# (src/voronota.cpp); show the output so the check log has it
	local status=0 out
	out=$(verbose ./${PN}.exe --help 2>&1) || status=$?
	echo "${out}"
	echo "exit status: ${status}"
	grep -q "^Voronota version ${PV%.*}$" <<<"${out}" || return 1
	[[ ${status} == 1 ]]
}
