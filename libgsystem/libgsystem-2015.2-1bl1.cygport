inherit gnome2

# The submodule libglnx, at the commit v${PV} pins; the GitLab archive omits it.
LIBGLNX_REV="e72bbdebb03f5d39c7f32869299ca4284786344c"

HOMEPAGE="https://wiki.gnome.org/Projects/LibGSystem"
SRC_URI="
	https://gitlab.gnome.org/Archive/${PN}/-/archive/v${PV}/${PN}-v${PV}.tar.gz
	https://gitlab.gnome.org/GNOME/libglnx/-/archive/${LIBGLNX_REV}/libglnx-${LIBGLNX_REV}.tar.gz
"
PATCH_URI="
	libgsystem-cygwin.patch
"
SRC_DIR="${PN}-v${PV}"

CATEGORY="Libs"
SUMMARY="GIO-based library with Unix/Linux specific API"
DESCRIPTION="LibGSystem is a GIO-based library, targeted primarily for use by operating
system components."

LICENSE="LGPL-2.0-or-later"
LICENSE_SPDX="SPDX-License-Identifier: LGPL-2.0-or-later"
LICENSE_URI="COPYING"

BUILD_REQUIRES="
	gnome-common
	gobject-introspection
	gtk-doc
	libglib2.0-devel
"

CYGPORT_USE_UNSTABLE_API=1
src_unpack_hook()
{
	verbose rmdir ${origsrcdir}/${SRC_DIR}/libglnx
	verbose mv ${origsrcdir}/libglnx-${LIBGLNX_REV} ${origsrcdir}/${SRC_DIR}/libglnx
}

PKG_NAMES="
	${PN}
	${PN}0
	${PN}-devel
	girepository-GSystem1.0
"
libgsystem_CONTENTS="
	usr/share/doc
"
libgsystem0_CONTENTS="
	usr/bin/cyg*-0.dll
"
libgsystem_devel_CONTENTS="
	usr/include
	usr/lib/${PN}*
	usr/lib/pkgconfig
"
girepository_GSystem1_0_CONTENTS="
	usr/lib/girepository-1.0
	usr/share/gir-1.0
"
libgsystem_SUMMARY="${SUMMARY} (licensing & readmes)"
libgsystem0_SUMMARY="${SUMMARY} (runtime)"
libgsystem_devel_SUMMARY="${SUMMARY} (development)"
girepository_GSystem1_0_SUMMARY="${SUMMARY} (GObject Introspection data)"
