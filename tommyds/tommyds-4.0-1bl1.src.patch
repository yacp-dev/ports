--- origsrc/tommyds-4.0/CMakeLists.txt	1970-01-01 00:00:00.000000000 +0000
+++ src/tommyds-4.0/CMakeLists.txt	2026-11-24 13:21:30.229774300 +0000
@@ -0,0 +1,40 @@
+cmake_minimum_required(VERSION 3.28)
+
+file(STRINGS Makefile _version_line REGEX "^VERSION = ")
+string(REGEX REPLACE "^VERSION = *" "" _version "${_version_line}")
+if(NOT _version)
+  set(_version 3.0)
+endif()
+
+project(tommyds
+  VERSION ${_version}
+  DESCRIPTION "C library of hashtables and tries designed to store objects with high performance"
+  HOMEPAGE_URL "https://github.com/amadvance/tommyds")
+
+include(GNUInstallDirs)
+include(CTest)
+
+add_library(tommyds SHARED "tommyds/tommy.c")
+if (DEFINED SOVERSION)
+  set_target_properties(tommyds PROPERTIES SOVERSION ${SOVERSION})
+endif()
+install(TARGETS tommyds
+  RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
+  ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR})
+
+add_executable(tommycheck check.c)
+target_link_libraries(tommycheck tommyds)
+
+add_test(NAME tommycheck
+  COMMAND tommycheck
+  WORKING_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR})
+
+file(GLOB_RECURSE HEADERS "tommyds/*.h")
+install(FILES ${HEADERS} DESTINATION ${CMAKE_INSTALL_INCLUDEDIR})
+
+set(prefix ${CMAKE_INSTALL_PREFIX})
+set(exec_prefix ${CMAKE_INSTALL_PREFIX})
+set(libdir ${CMAKE_INSTALL_PREFIX}/lib)
+set(includedir ${CMAKE_INSTALL_PREFIX}/include)
+configure_file(${CMAKE_SOURCE_DIR}/tommyds.pc.in ${CMAKE_BINARY_DIR}/tommyds.pc @ONLY)
+install(FILES ${CMAKE_BINARY_DIR}/tommyds.pc DESTINATION ${CMAKE_INSTALL_LIBDIR}/pkgconfig)
--- origsrc/tommyds-4.0/check.c	2026-11-12 20:59:01.000000000 +0000
+++ src/tommyds-4.0/check.c	2026-11-24 13:21:30.229248200 +0000
@@ -25,8 +25,8 @@
 #if defined(__linux)
 #include <stdint.h>
 #include <unistd.h>
-#include <sys/time.h>
 #endif
+#include <sys/time.h>
 
 #if defined(__FreeBSD__)
 #include <sys/time.h>
--- origsrc/tommyds-4.0/tommyds.pc.in	1970-01-01 00:00:00.000000000 +0000
+++ src/tommyds-4.0/tommyds.pc.in	2026-11-24 13:21:30.229774300 +0000
@@ -0,0 +1,10 @@
+prefix=@prefix@
+exec_prefix=@exec_prefix@
+libdir=@libdir@
+includedir=@includedir@
+
+Name: tommyds
+Description: C library of hashtables and tries designed to store objects with high performance
+Version: @PROJECT_VERSION@
+Libs: -L${libdir} -ltommyds
+Cflags: -I${includedir}
