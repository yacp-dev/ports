HOMEPAGE="https://sourceforge.net/projects/${PN}/"
SRC_URI="https://www.arrl.org/tqsl/tqsl-${PV}.tar.gz"
PATCH_URI="
	https://src.fedoraproject.org/rpms/${PN}/raw/035682b3886d58a64e3271dba345243abf2fbd3e/f/tqsl-tqsllib.patch
"
SRC_DIR="tqsl-${PV}"

CATEGORY="Libs"
SUMMARY="Tool for digitally signing Amateur Radio QSO records"
DESCRIPTION="The TrustedQSL library is used for generating digitally signed QSO records
(records of Amateur Radio contacts). This package contains the library and
configuration files needed to run TrustedQSL applications."

LICENSE="LicenseRef-ARRL AND BSD-4-Clause"
LICENSE_SPDX="SPDX-License-Identifier: LicenseRef-ARRL AND BSD-4-Clause"
LICENSE_URI="LICENSE.txt"

BUILD_REQUIRES="
	libcurl-devel
	libexpat-devel
	libsqlite3-devel
	libssl-devel
	libwx_baseu3.1-devel
	libwx_gtk3u3.1-devel
	zlib-devel
"

inherit cmake

CYGCMAKE_ARGS="
	-DwxWidgets_CONFIG_OPTIONS:STRING=--prefix=/usr
"

PKG_NAMES="
	${PN}
	libtqsllib2.8.6
	libtqsllib-devel
"
trustedqsl_CONTENTS="
	etc
	usr/bin/*.exe
	usr/share
"
libtqsllib2_8_6_CONTENTS="
	usr/bin/cyg*-2.8.6.dll
"
libtqsllib_devel_CONTENTS="
	usr/include
	usr/lib
"
trustedqsl_SUMMARY="${SUMMARY} (utilities)"
libtqsllib2_8_6_SUMMARY="${SUMMARY} (runtime)"
libtqsllib_devel_SUMMARY="${SUMMARY} (development)"
