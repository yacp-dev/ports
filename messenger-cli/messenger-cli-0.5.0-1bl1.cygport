HOMEPAGE="https://www.gnunet.org/en/applications.html"
SRC_URI="mirror://gnu/gnunet/${P}.tar.gz"

CATEGORY="Net"
SUMMARY="CLI for the Messenger service of GNUnet"
DESCRIPTION="${SUMMARY}"

LICENSE="AGPL-3.0-or-later"
LICENSE_SPDX="SPDX-License-Identifier: AGPL-3.0-or-later"
LICENSE_URI="COPYING"

BUILD_REQUIRES="
	libgnunet-devel
	libgnunetchat-devel
	libncurses-devel
	libsecret1-devel
"

inherit meson
