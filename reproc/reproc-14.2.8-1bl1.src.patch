@@ -30,6 +30,21 @@ int main(void)
     current += *current == '\n';
   }
 
+#if defined(__CYGWIN__)
+  // Cygwin always adds SYSTEMROOT and WINDIR to a child's environment.
+  const char *forced[] = { "SYSTEMROOT=", "WINDIR=" };
+
+  for (size_t i = 0; i < 2; i++) {
+    size_t size = strlen(forced[i]);
+
+    if (strncmp(current, forced[i], size) == 0) {
+      current += strcspn(current, "\r\n");
+      current += *current == '\r';
+      current += *current == '\n';
+    }
+  }
+#endif
+
   ASSERT_EQ_SIZE(strlen(current), (size_t) 0);
 
   reproc_free(output);
