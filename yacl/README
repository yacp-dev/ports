(libyacl-devel)
  /usr/include/yacl-1.1/yacl.h
  /usr/lib/libyacl.dll.a
  /usr/lib/pkgconfig/yacl.pc

(guile-yacl)
  /usr/share/guile/site/3.0/cryptotronix/yacl.scm

