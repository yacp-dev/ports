--- origsrc/wiredtiger-11.3.1/src/os_linux/os_futex.c	2024-11-14 22:24:41.000000000 +0000
+++ src/wiredtiger-11.3.1/src/os_linux/os_futex.c	2026-11-12 03:50:52.210549700 +0000
@@ -7,6 +7,73 @@
 
 #include "wt_internal.h"
 
+#if defined(__CYGWIN__)
+#include <errno.h>
+#include <pthread.h>
+#include <time.h>
+
+static pthread_mutex_t __wt_cygwin_futex_mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t __wt_cygwin_futex_cond = PTHREAD_COND_INITIALIZER;
+
+/*
+ * __wt_futex_wait --
+ *     Wait on the futex. The timeout is in microseconds and MUST be greater than zero.
+ */
+int
+__wt_futex_wait(
+  volatile WT_FUTEX_WORD *addr, WT_FUTEX_WORD expected, time_t usec, WT_FUTEX_WORD *wake_valp)
+{
+    struct timespec ts;
+    int ret;
+
+    WT_ASSERT(NULL, usec > 0);
+
+    pthread_mutex_lock(&__wt_cygwin_futex_mutex);
+    if (*addr != expected) {
+        *wake_valp = *addr;
+        pthread_mutex_unlock(&__wt_cygwin_futex_mutex);
+        return (0);
+    }
+
+    (void)clock_gettime(CLOCK_REALTIME, &ts);
+    ts.tv_sec += usec / WT_MILLION;
+    ts.tv_nsec += (long)((usec % WT_MILLION) * WT_THOUSAND);
+    if (ts.tv_nsec >= WT_BILLION) {
+        ts.tv_sec += 1;
+        ts.tv_nsec -= WT_BILLION;
+    }
+
+    ret = pthread_cond_timedwait(&__wt_cygwin_futex_cond, &__wt_cygwin_futex_mutex, &ts);
+    *wake_valp = *addr;
+    pthread_mutex_unlock(&__wt_cygwin_futex_mutex);
+
+    if (ret != 0) {
+        errno = ret;
+        return (-1);
+    }
+    return (0);
+}
+
+/*
+ * __wt_futex_wake --
+ *     Wake the futex.
+ */
+int
+__wt_futex_wake(volatile WT_FUTEX_WORD *addr, WT_FUTEX_WAKE wake, WT_FUTEX_WORD wake_val)
+{
+    WT_ASSERT(NULL, wake == WT_FUTEX_WAKE_ONE || wake == WT_FUTEX_WAKE_ALL);
+
+    pthread_mutex_lock(&__wt_cygwin_futex_mutex);
+    *addr = wake_val;
+    if (wake == WT_FUTEX_WAKE_ALL)
+        pthread_cond_broadcast(&__wt_cygwin_futex_cond);
+    else
+        pthread_cond_signal(&__wt_cygwin_futex_cond);
+    pthread_mutex_unlock(&__wt_cygwin_futex_mutex);
+
+    return (0);
+}
+#else
 #include <linux/futex.h>
 #include <sys/syscall.h>
 
@@ -49,3 +116,4 @@ __wt_futex_wake(volatile WT_FUTEX_WORD *
 
     return ((int)((sysret >= 0) ? 0 : sysret));
 }
+#endif
