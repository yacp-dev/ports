HOMEPAGE="https://clpbar.sourceforge.net/"
SRC_URI="mirror://sourceforge/clpbar/clpbar/bar-1.11.1/bar_1.11.1.tar.gz"
SRC_DIR="bar-1.11.1"

CATEGORY="Utils"
SUMMARY="Show information about a data transfer"
DESCRIPTION="Bar is a simple tool to process a stream of data and print a
display for the user on stderr showing the amount of data passed, the throughput
of the data transfer, and, if the total size of the data stream is known,
estimated time remaining, percent complete, and a progress bar."

