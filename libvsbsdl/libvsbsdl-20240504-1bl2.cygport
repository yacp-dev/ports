HOMEPAGE="https://github.com/libyal/${PN}"
SRC_URI="https://github.com/libyal/${PN}/archive/refs/tags/${PV}.tar.gz"

CATEGORY="Libs"
SUMMARY="Library and tools to access BSD disklabel volume system format"
DESCRIPTION="libvsbsdl is a library to access the BSD disklabel volume system format."

LICENSE="LGPL-3.0-or-later"
LICENSE_SPDX="SPDX-License-Identifier: LGPL-3.0-or-later"
LICENSE_URI="COPYING.LESSER"

BUILD_REQUIRES="
	gettext-devel
	libbfio-devel
	libcdata-devel
	libcerror-devel
	libcfile-devel
	libclocale-devel
	libcnotify-devel
	libcpath-devel
	libcsplit-devel
	libcthreads-devel
	libfcache-devel
	libfdata-devel
	libuna-devel
	python3-devel
"

CYGPORT_USE_UNSTABLE_API=1
src_patch_hook()
{
	cd ${origsrcdir}/${SRC_DIR}
	chmod u+x tests/*.{py,sh}
}

CYGCONF_ARGS="
	--enable-python
	--enable-wide-character-type
"

src_test()
{
	cd ${B}
	pushd tests
		for f in ${S}/tests/*.{py,sh}
		do
			ln -fs ${f} .
		done
		cp -f ${B}/pyvsbsdl/.libs/pyvsbsdl.dll ./pyvsbsdl.cpython-312-x86_64-cygwin.dll
		cp -f ${B}/pyvsbsdl/.libs/pyvsbsdl.dll ./pyvsbsdl.dll
	popd
	pushd pyvsbsdl/.libs
		cp -f pyvsbsdl.dll pyvsbsdl.cpython-312-x86_64-cygwin.dll
	popd
	CHECK_WITH_STDERR=1 PYTHON=python3 PATH="${B}/libvsbsdl/.libs:${B}/pyvsbsdl/.libs:${PATH}" cygtest
	rm -f tests/*.{py,sh} tests/*.dll pyvsbsdl/.libs/pyvsbsdl.cpython-312-x86_64-cygwin.dll
}

DOCS="
	COPYING.LESSER
	documentation/*
"

PKG_NAMES="
	${PN}
	${PN}1
	${PN}-devel
	python312-${PN}
"
libvsbsdl_CONTENTS="
	usr/bin/*.exe
	usr/share/doc
	usr/share/man/man1
"
libvsbsdl1_CONTENTS="
	usr/bin/cyg*-1.dll
"
libvsbsdl_devel_CONTENTS="
	usr/include
	usr/lib/lib*.dll.a
	usr/lib/pkgconfig
	usr/share/man/man3
"
python312_libvsbsdl_CONTENTS="
	usr/lib/python3.12
"
libvsbsdl_SUMMARY="${SUMMARY} (utilities)"
libvsbsdl1_SUMMARY="${SUMMARY} (runtime)"
libvsbsdl_devel_SUMMARY="${SUMMARY} (development)"
python312_libvsbsdl_SUMMARY="${SUMMARY} (python312 bindings)"
