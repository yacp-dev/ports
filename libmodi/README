  /usr/share/doc/libmodi/ChangeLog
  /usr/share/doc/libmodi/Mac OS disk image types.asciidoc
  /usr/share/doc/libmodi/README
  /usr/share/man/man1/modiinfo.1.gz
  /usr/share/man/man1/modimount.1.gz

(libmodi1)
  /usr/bin/cygmodi-1.dll

(libmodi-devel)
  /usr/include/libmodi.h
  /usr/include/libmodi/codepage.h
  /usr/include/libmodi/definitions.h
