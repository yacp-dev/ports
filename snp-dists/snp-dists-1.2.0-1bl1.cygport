HOMEPAGE="https://github.com/tseemann/${PN}"
SRC_URI="https://github.com/tseemann/${PN}/archive/v${PV}.tar.gz"

CATEGORY="Science"
SUMMARY="Pairwise SNP distance matrix from a FASTA sequence alignment"
DESCRIPTION="${SUMMARY}"

LICENSE="GPL-3.0-only AND MIT"
LICENSE_SPDX="SPDX-License-Identifier: GPL-3.0-only AND MIT"
LICENSE_URI="LICENSE"

BUILD_REQUIRES="
	zlib-devel
"

src_compile()
{
	cd ${B}
	lndirs
	cygmake
}

src_install()
{
	cd ${B}
	dobin ${PN}.exe

	cd ${S}
	mkdir -p ${D}/usr/share/${PN}
	cp -R test ${D}/usr/share/${PN}
	rm -f ${D}/usr/share/${PN}/test/huge.afa.gz
}
