HOMEPAGE="https://codeberg.org/chrisn/${PN}"
SRC_URI="https://codeberg.org/chrisn/${PN}/archive/${PV}.tar.gz"
SRC_DIR="${PN}"

CATEGORY="Audio"
SUMMARY="C++ program to generate waveform data and render waveform images from audio files"
DESCRIPTION="audiowaveform is a C++ command-line application that generates waveform data
from either MP3, WAV, or FLAC format audio files. Waveform data can be used to
produce a visual rendering of the audio, similar in appearance to audio
editing applications."

LICENSE="GPL-3.0-or-later"
LICENSE_SPDX="SPDX-License-Identifier: GPL-3.0-or-later"
LICENSE_URI="COPYING"

BUILD_REQUIRES="
	libboost-devel
	libgd-devel
	libgmock-devel
	libgtest-devel
	libid3tag-devel
	libmad-devel
	libsndfile-devel
"

inherit cmake

DOCS="
	*.md
	doc/DataFormat.md
	doc/example.png
"

DIFF_EXCLUDES="
	build
"

# The tests open their data as ../test/data/... and run ./audiowaveform, i.e.
# they expect to run from a build directory directly under the source tree.
src_test() {
	mkdir -p ${S}/build
	cd ${S}/build
	cp -f ${B}/audiowaveform.exe .
	${B}/audiowaveform_tests
}
