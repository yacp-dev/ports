HOMEPAGE="https://github.com/libyal/${PN}"
SRC_URI="https://github.com/libyal/${PN}/archive/refs/tags/${PV}.tar.gz"

CATEGORY="Libs"
SUMMARY="Library and tools to access the Windows 9x/Me Registry File (CREG) format"
DESCRIPTION="libcreg is a library to access the Windows 9x/Me Registry File (CREG) format."

LICENSE="LGPL-3.0-or-later"
LICENSE_SPDX="SPDX-License-Identifier: LGPL-3.0-or-later"
LICENSE_URI="COPYING.LESSER"

BUILD_REQUIRES="
	gettext-devel
	libbfio-devel
	libcdata-devel
	libcerror-devel
	libcfile-devel
	libclocale-devel
	libcnotify-devel
	libcpath-devel
	libcsplit-devel
	libcthreads-devel
	libfcache-devel
	libfdata-devel
	libuna-devel
	python3-devel
"

CYGPORT_USE_UNSTABLE_API=1
src_patch_hook()
{
	cd ${origsrcdir}/${SRC_DIR}
	chmod u+x tests/*.{py,sh}
}

CYGCONF_ARGS="
	--enable-python
"

src_test()
{
	cd ${B}
	pushd tests
		for f in ${S}/tests/*.{py,sh}
		do
			cp -f ${f} .
		done
		cp -f ${B}/pycreg/.libs/pycreg.dll .
	popd
	CHECK_WITH_STDERR=1 PYTHON=python3 PATH=${B}/${PN}/.libs:${B}/pycreg/.libs:${PATH} cygtest
	rm -f tests/*.{py,sh} tests/pycreg.dll
}

DOCS="
	COPYING.LESSER
"

PKG_NAMES="
	${PN}
	${PN}1
	${PN}-devel
	python312-${PN}
"
libcreg_CONTENTS="
	usr/bin/*.exe
	usr/share/doc
	usr/share/man/man1
"
libcreg1_CONTENTS="
	usr/bin/cyg*-1.dll
"
libcreg_devel_CONTENTS="
	usr/include
	usr/lib/lib*.dll.a
	usr/lib/pkgconfig
	usr/share/man/man3
"
python312_libcreg_CONTENTS="
	usr/lib/python3.12
"
libcreg_SUMMARY="${SUMMARY} (utilities)"
libcreg1_SUMMARY="${SUMMARY} (runtime)"
libcreg_devel_SUMMARY="${SUMMARY} (development)"
python312_libcreg_SUMMARY="${SUMMARY} (python312 bindings)"
