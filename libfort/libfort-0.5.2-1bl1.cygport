HOMEPAGE="https://github.com/seleznevae/${PN}"
SRC_URI="https://github.com/seleznevae/${PN}/archive/v${PV}.tar.gz"

CATEGORY="Libs"
SUMMARY="C/C++ library to create formatted ASCII tables for console applications"
DESCRIPTION="${SUMMARY}"

LICENSE="MIT"
LICENSE_SPDX="SPDX-License-Identifier: MIT"
LICENSE_URI="LICENSE"

inherit cmake

CYGCMAKE_ARGS="
	-DBUILD_SHARED_LIBS:BOOL=ON
"

CYGPORT_USE_UNSTABLE_API=1
src_patch_hook()
{
	cd ${origsrcdir}/${SRC_DIR}
	sed -i -e "/^project(libfort /s/VERSION [0-9.]*/VERSION ${PV}/" CMakeLists.txt
}

src_test()
{
	cd ${B}
	PATH=${B}/lib:${B}/src:${PATH} ninja_test
}

DOCS="
	*.md
"

PKG_NAMES="
	libfort
	libfort${PV[1]}.${PV[2]}
	libfort-devel
"
libfort_CONTENTS="
	usr/share
"
libfort0_5_CONTENTS="
	usr/bin/cyg*-0.5.dll
"
libfort_devel_CONTENTS="
	usr/include
	usr/lib
"
libfort_SUMMARY="${SUMMARY} (licensing & readmes)"
libfort0_5_SUMMARY="${SUMMARY} (runtime)"
libfort_devel_SUMMARY="${SUMMARY} (development)"
