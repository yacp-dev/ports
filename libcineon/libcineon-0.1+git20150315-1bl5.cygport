HOMEPAGE="https://github.com/inequation/${PN}"
GIT_URI="https://github.com/inequation/${PN}.git"
GIT_REV="d4498137563114dc9103ce015dc29287308be048"

CATEGORY="Libs"
SUMMARY="Cineon image format reader/writer library"
DESCRIPTION="Cineon image format reader/writer library written in portable C++."

LICENSE="BSD-3-Clause"
LICENSE_SPDX="SPDX-License-Identifier: BSD-3-Clause"
LICENSE_URI="COPYING"

BUILD_REQUIRES="
	libtiff-devel
"

inherit git

src_test()
{
	cd ${B}/tools
	local t status
	for t in cineonheader cineon2tiff
	do
		status=0
		verbose ./${t}/${t}.exe > ${t}.out || status=$?
		cat ${t}.out
		# run without arguments: prints its usage and exits with 1
		[ ${status} -eq 1 ] && grep -q '^usage: ' ${t}.out || return 1
	done
}

PKG_NAMES="
	${PN}
	${PN}0
	${PN}-devel
"
libcineon_CONTENTS="
	usr/bin/*.exe
	usr/share
"
libcineon0_CONTENTS="
	usr/bin/cyg*-0.dll
"
libcineon_devel_CONTENTS="
	usr/include
	usr/lib
"
libcineon_SUMMARY="${SUMMARY} (utilities)"
libcineon0_SUMMARY="${SUMMARY} (runtime)"
libcineon_devel_SUMMARY="${SUMMARY} (development)"
