@@ -615,6 +615,8 @@ s_can_connect (zctx_t *ctx, void **serve
     assert (port_nbr > 0);
     int rc = zsocket_connect (*client, "tcp://127.0.0.1:%d", port_nbr);
     assert (rc == 0);
+    //  A PUSH socket blocks while it has no peer; see zauth.c
+    zsocket_set_sndtimeo (*server, 200);
     zstr_send (*server, "Hello, World");
     zpoller_t *poller = zpoller_new (*client, NULL);
     bool success = (zpoller_wait (poller, 200) == *client);
