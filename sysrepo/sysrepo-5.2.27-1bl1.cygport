HOMEPAGE="https://github.com/${PN}/${PN}"
SRC_URI="https://github.com/${PN}/${PN}/archive/refs/tags/v${PV}.tar.gz"

CATEGORY="Libs"
SUMMARY="YANG-based configuration and operational state data store"
DESCRIPTION="Sysrepo is a YANG-based configuration and operational state data store for
Unix/Linux applications."

LICENSE="BSD-3-Clause"
LICENSE_SPDX="SPDX-License-Identifier: BSD-3-Clause"
LICENSE_URI="LICENSE"

BUILD_REQUIRES="
	libcmocka-devel
	libyang-devel
"

inherit cmake

CYGCMAKE_ARGS="
	-DENABLE_TESTS:BOOL=ON
	-DREPO_SHM_SETUP:BOOL=OFF
	-DNOTIFD_SETUP:BOOL=OFF
"

src_test()
{
	cd ${B}
	PATH=${B}:${PATH} ninja_test
}

PKG_NAMES="
	sysrepo
	libsysrepo8
	libsysrepo-devel
"
sysrepo_CONTENTS="
	usr/bin/*.exe
	usr/share
"
libsysrepo8_CONTENTS="
	usr/bin/cyg*-8.dll
"
libsysrepo_devel_CONTENTS="
	usr/include
	usr/lib
"
sysrepo_SUMMARY="${SUMMARY} (utilities)"
libsysrepo8_SUMMARY="${SUMMARY} (runtime)"
libsysrepo_devel_SUMMARY="${SUMMARY} (development)"
