HOMEPAGE="https://github.com/libyal/${PN}"
SRC_URI="https://github.com/libyal/${PN}/archive/refs/tags/${PV}.tar.gz"

CATEGORY="Libs"
SUMMARY="Library and tools to access the Windows Prefetch File (SCCA) format"
DESCRIPTION="libscca is a library to access the Windows Prefetch File (SCCA) format."

LICENSE="LGPL-3.0-or-later"
LICENSE_SPDX="SPDX-License-Identifier: LGPL-3.0-or-later"
LICENSE_URI="COPYING.LESSER"

CYGPORT_USE_UNSTABLE_API=1
src_patch_hook()
{
	cd ${origsrcdir}/${SRC_DIR}
	chmod u+x tests/*.{py,sh}
}

BUILD_REQUIRES="
	gettext-devel
	libbfio-devel
	libcdata-devel
	libcerror-devel
	libcfile-devel
	libclocale-devel
	libcnotify-devel
	libcpath-devel
	libcsplit-devel
	libcthreads-devel
	libfcache-devel
	libfdata-devel
	libfdatetime-devel
	libfvalue-devel
	libfwnt-devel
	libuna-devel
	python3-devel
"

export PYTHON=python3

CYGCONF_ARGS="
	--enable-python
	--enable-wide-character-type
"

src_test()
{
	cd ${B}
	pushd tests
		for f in ${S}/tests/*.{py,sh}
		do
			ln -fs ${f} .
		done
		cp -f ${B}/pyscca/.libs/pyscca.dll ./pyscca.cpython-312-x86_64-cygwin.dll
		cp -f ${B}/pyscca/.libs/pyscca.dll ./pyscca.dll
	popd
	pushd pyscca/.libs
		cp -f pyscca.dll pyscca.cpython-312-x86_64-cygwin.dll
	popd
	CHECK_WITH_STDERR=1 PYTHON=python3 PATH="${B}/libscca/.libs:${B}/pyscca/.libs:${PATH}" cygtest
	rm -f tests/*.{py,sh} tests/*.dll pyscca/.libs/pyscca.cpython-312-x86_64-cygwin.dll
}

DOCS="
	COPYING.LESSER
"

PKG_NAMES="
	${PN}
	${PN}1
	${PN}-devel
	python312-${PN}
"
libscca_CONTENTS="
	usr/bin/*.exe
	usr/share/doc
	usr/share/man/man1
"
libscca1_CONTENTS="
	usr/bin/cyg*-1.dll
"
libscca_devel_CONTENTS="
	usr/include
	usr/lib/lib*.dll.a
	usr/lib/pkgconfig
	usr/share/man/man3
"
python312_libscca_CONTENTS="
	usr/lib/python3.12
"
libscca_SUMMARY="${SUMMARY} (utilities)"
libscca1_SUMMARY="${SUMMARY} (runtime)"
libscca_devel_SUMMARY="${SUMMARY} (development)"
python312_libscca_SUMMARY="${SUMMARY} (python312 bindings)"
