 namespace zlibcomplete {
 
+// zlib 1.2.9 and later refuse a raw deflate stream with an 8-bit window
+// (deflateInit2 returns Z_STREAM_ERROR), so take 8 as 9, as zlib itself
+// does for zlib streams. An inflater with a larger window still reads
+// streams written with a smaller one.
+static int rawWindowBits(int windowBits) {
+  return windowBits == 8 ? 9 : windowBits;
+}
+
 RawDeflater::RawDeflater(int level, flush_parameter autoFlush,
                                int windowBits) :
-  ZLibBaseCompressor(level, autoFlush, -windowBits) {
+  ZLibBaseCompressor(level, autoFlush, -rawWindowBits(windowBits)) {
 }
 
