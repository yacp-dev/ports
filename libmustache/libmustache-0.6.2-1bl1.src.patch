--- origsrc/libmustache/CMakeLists.txt	2026-10-18 12:13:38.000000000 +0000
+++ src/libmustache/CMakeLists.txt	2026-10-18 12:13:41.659720700 +0000
@@ -2,6 +2,12 @@ cmake_minimum_required(VERSION 3.18)
 
 project(mustache VERSION 0.6.2 LANGUAGES CXX)
 
+# newlib hides POSIX declarations such as fileno and ftruncate under the
+# strict -std=c++17 this project uses. CMAKE_CXX_FLAGS also reaches try_run.
+if(CYGWIN)
+    string(APPEND CMAKE_CXX_FLAGS " -D_GNU_SOURCE")
+endif()
+
 # Quoted public-header includes would select this file before the build header.
 if(NOT CMAKE_CURRENT_SOURCE_DIR STREQUAL CMAKE_CURRENT_BINARY_DIR AND
         EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/src/mustache_config.h")
