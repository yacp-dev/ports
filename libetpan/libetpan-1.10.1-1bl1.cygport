HOMEPAGE="https://github.com/dinhvh/${PN}"
SRC_URI="https://github.com/dinhvh/${PN}/archive/refs/tags/${PV}.tar.gz"
PATCH_URI="
	https://sources.debian.org/data/main/${PN:0:4}/${PN}/1.10.0-1.1/debian/patches/12_add_dummy_readme.diff
	https://sources.debian.org/data/main/${PN:0:4}/${PN}/1.10.0-1.1/debian/patches/14_fix_encoding.diff
	https://sources.debian.org/data/main/${PN:0:4}/${PN}/1.10.0-1.1/debian/patches/17-Replace-Cyrus-SASL-MD5-with-Colin-Plumb-s-MD5.patch
	https://sources.debian.org/data/main/${PN:0:4}/${PN}/1.10.0-1.1/debian/patches/18_Prevent-overwriting-build_headers.list.patch
	https://src.fedoraproject.org/rpms/${PN}/raw/rawhide/f/${PN}-1.9.2-cryptopolicy.patch
"

CATEGORY="Libs"
SUMMARY="Mail Framework for C Language"
DESCRIPTION="The purpose of this mail library is to provide a portable, efficient framework
for different kinds of mail access: IMAP, SMTP, POP and NNTP."

LICENSE="BSD-3-Clause"
LICENSE_SPDX="SPDX-License-Identifier: BSD-3-Clause"
LICENSE_URI="COPYRIGHT"

BUILD_REQUIRES="
	libdb-devel
	libiconv-devel
	libsasl2-devel
	libssl-devel
	zlib-devel
"

src_compile()
{
	cd ${S}
	cygautoreconf
	cd ${B}
	lndirs
	cygconf
	cygmake
}

CYGCONF_ARGS="
	--enable-maintainer-mode
"

DIFF_EXCLUDES="
	libetpan_version.h
"

PKG_NAMES="
	libetpan
	libetpan26
	libetpan-devel
"
libetpan_CONTENTS="
	usr/share
"
libetpan26_CONTENTS="
	usr/bin/cyg*-26.dll
"
libetpan_devel_CONTENTS="
	usr/include
	usr/lib
"
libetpan_SUMMARY="${SUMMARY} (licensing & readmes)"
libetpan26_SUMMARY="${SUMMARY} (runtime)"
libetpan_devel_SUMMARY="${SUMMARY} (development)"
