HOMEPAGE="https://github.com/google/${PN}"
SRC_URI="
    https://github.com/google/${PN}/archive/refs/tags/v${PV}.tar.gz
    https://src.fedoraproject.org/rpms/${PN}/raw/883707f378f1c9eb8a05e003e0edd2da7adc415e/f/flatc.1
"
PATCH_URI="
    https://src.fedoraproject.org/rpms/${PN}/raw/883707f378f1c9eb8a05e003e0edd2da7adc415e/f/flatbuffers_mingw-lib.patch
"

CATEGORY="Libs"
SUMMARY="Memory Efficient Serialization Library"
DESCRIPTION="FlatBuffers is a serialization library for games and other memory constrained
apps."

LICENSE="Apache-2.0"
LICENSE_SPDX="SPDX-License-Identifier: Apache-2.0"
LICENSE_URI="LICENSE"

export CPPFLAGS="${CPPFLAGS} -D_GNU_SOURCE"

inherit cmake

CYGCMAKE_ARGS="
    -DFLATBUFFERS_BUILD_FLATLIB:BOOL=OFF
    -DFLATBUFFERS_BUILD_SHAREDLIB:BOOL=ON
    -DFLATBUFFERS_BUILD_TESTS:BOOL=ON
"

src_install()
{
    cd ${B}
    ninja_install

    cd ${S}
    doman flatc.1
}

DOCS="
    CHANGELOG.md
"

PKG_NAMES="
    ${PN}
    lib${PN}${PV}
    lib${PN}-devel
"
flatbuffers_CONTENTS="
    usr/bin/*.exe
    usr/share
"
libflatbuffers25_12_19_CONTENTS="
    usr/bin/cyg*-${PV}.dll
"
libflatbuffers_devel_CONTENTS="
    usr/include
    usr/lib
"
flatbuffers_SUMMARY="${SUMMARY} (utilities)"
libflatbuffers25_12_19_SUMMARY="${SUMMARY} (runtime)"
libflatbuffers_devel_SUMMARY="${SUMMARY} (development)"
libflatbuffers_devel_REQUIRES="flatbuffers"
