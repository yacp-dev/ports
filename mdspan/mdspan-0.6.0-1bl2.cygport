HOMEPAGE="https://github.com/kokkos/${PN}"
SRC_URI="https://github.com/kokkos/${PN}/archive/refs/tags/${P}.tar.gz"
SRC_DIR="${PN}-${P}"

CATEGORY="Devel"
SUMMARY="Reference implementation of mdspan targeting C++23"
DESCRIPTION="${SUMMARY}"

LICENSE="Apache-2.0 WITH LLVM-exception"
LICENSE_SPDX="SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception"
LICENSE_URI="LICENSE"

BUILD_REQUIRES="
	libgmock-devel
	libgtest-devel
"

inherit cmake

CYGCMAKE_ARGS="
	-DMDSPAN_ENABLE_TESTS:BOOL=ON
	-DMDSPAN_USE_SYSTEM_GTEST:BOOL=ON
"

DOCS="
	README.md
"
