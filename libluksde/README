  /usr/share/doc/libluksde/README
  /usr/share/man/man1/luksdeinfo.1.gz
  /usr/share/man/man1/luksdemount.1.gz

(libluksde1)
  /usr/bin/cygluksde-1.dll

(libluksde-devel)
  /usr/include/libluksde.h
