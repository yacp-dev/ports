HOMEPAGE="https://github.com/${PN}-io/${PN}"
SRC_URI="https://github.com/${PN}-io/${PN}/archive/refs/tags/${PV}.tar.gz"
PATCH_URI="
	https://sources.debian.org/data/main/${PN:0:1}/${PN}/9.1.2-1/debian/patches/0002-Add-CPPFLAGS-to-upstream-makefiles.patch
	https://sources.debian.org/data/main/${PN:0:1}/${PN}/9.1.2-1/debian/patches/0003-Use-get_current_dir_name-over-PATHMAX.patch
"

CATEGORY="Net"
SUMMARY="Flexible distributed key-value datastore"
DESCRIPTION="Valkey is a high-performance data structure server that primarily serves
key/value workloads. It supports a wide range of native structures and an
extensible plugin system for adding new data structures and access patterns."

LICENSE="BSD-3-Clause AND BSD-2-Clause AND ISC AND MIT AND Zlib AND (Apache-2.0 OR BSL-1.0 OR MIT)"
LICENSE_SPDX="SPDX-License-Identifier: BSD-3-Clause AND BSD-2-Clause AND ISC AND MIT AND Zlib AND (Apache-2.0 OR BSL-1.0 OR MIT)"
LICENSE_URI="COPYING"

BUILD_REQUIRES="
	libfpconv-devel
	libhdr_histogram-devel
	liblinenoise-devel
	libssl-devel
	libvalkey-devel
	libvalkey_tls-devel
	libtcmalloc-devel
	tcl
"

export CPPFLAGS="${CPPFLAGS} -D_GNU_SOURCE -DUSE_SYSTEM_HDR_HISTOGRAM -DUSE_SYSTEM_LINENOISE"

inherit cmake

CYGCMAKE_ARGS="
	-DBUILD_EXAMPLE_MODULES:BOOL=ON
	-DBUILD_MALLOC:STRING=tcmalloc
	-DBUILD_TEST_MODULES:BOOL=ON
	-DBUILD_TLS:BOOL=ON
"

src_test()
{
	# The tests put a Unix socket under tests/tmp, and the path to the
	# build tree is too long for sun_path (108): run them from a copy.
	local rc=0 t=$(mktemp -d /tmp/valkey-test.XXXXXX)
	cp -r ${S}/tests ${t}/tests
	cd ${t}
	VALKEY_BIN_DIR=${B}/bin tclsh tests/test_helper.tcl --clients 4 \
		--single unit/type/string \
		--single unit/type/list \
		--single unit/type/hash \
		--single unit/type/set \
		--single unit/type/zset \
		--single unit/expire || rc=$?
	cd ${B}
	rm -rf ${t}
	return ${rc}
}

src_install()
{
	cd ${B}
	ninja_install

	cd ${D}
	rm -rf usr/bin/lib*.dll.a
	# The Lua engine, linked into valkey-server as a whole archive
	rm -f usr/lib/libvalkeylua.a
	mkdir -p usr/lib/valkey
	mv usr/bin/*.dll usr/lib/valkey
}

DOCS="
	00-RELEASENOTES
	README.md
"

DIFF_EXCLUDES="
	jemalloc
	tmp
"
