ping_pong.pl builds mirror.pl's path as $PWD/$srcdir, which is wrong when
srcdir is absolute, as it is when configure is run by its absolute path. Perl
then can't open mirror.pl, the "end" message never comes and the test hangs.

--- a/tests/pilot/ping_pong.pl
+++ b/tests/pilot/ping_pong.pl
@@ -1,6 +1,7 @@
 #!/usr/bin/perl -w -I../../Perl-Module/lib
 use strict;
 
+use File::Spec;
 use TakTuk::Pilot;
 
 sub output_callback(%) {
@@ -33,8 +34,9 @@
                       fields=>['host', 'rank', 'line']);
 $taktuk->add_callback(callback=>\&message_callback, stream=>'message',
                       fields=>['from', 'line']);
+my $srcdir = File::Spec->rel2abs($ENV{srcdir});
 $taktuk->send_command(
-                 "broadcast taktuk_perl [ -w -- $ENV{PWD}/$ENV{srcdir}/mirror.pl 1 2 3 ]");
+                 "broadcast taktuk_perl [ -w -- $srcdir/mirror.pl 1 2 3 ]");
 $taktuk->send_command("broadcast message [ Salut ]");
 print "Starting taktuk...\n";
 $taktuk->run(command=>"../../taktuk -s -m ".join(" -m ", @ARGV));
