HOMEPAGE="https://github.com/pete4abw/${PN}"
SRC_URI="https://github.com/pete4abw/${PN}/archive/refs/tags/${P}.tar.gz"
SRC_DIR="${PN}-${P}"

CATEGORY="Utils"
SUMMARY="Utility for removing files based on when they were last accessed"
DESCRIPTION="The tmpwatch utility recursively searches through specified
directories and removes files which have not been accessed in a
specified period of time.  Tmpwatch is normally used to clean up
directories which are used for temporarily holding files (for example,
/tmp).  Tmpwatch ignores symlinks, won't switch filesystems and only
removes empty directories and regular files."

LICENSE="GPL-2.0-only"
LICENSE_SPDX="SPDX-License-Identifier: GPL-2.0-only"
LICENSE_URI="COPYING"

src_test()
{
	cd ${B}
	# 2.13 has no --help: without arguments it prints its usage and exits 1
	local status=0
	verbose ./${PN}.exe > usage.out 2>&1 || status=$?
	[ ${status} -eq 1 ] && grep -q '<hours-untouched> <dirs>' usage.out
}
