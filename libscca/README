(libscca1)
  /usr/bin/cygscca-1.dll

(libscca-devel)
  /usr/include/libscca.h
  /usr/include/libscca/codepage.h
  /usr/include/libscca/definitions.h
  /usr/include/libscca/error.h
  /usr/include/libscca/extern.h
  /usr/include/libscca/features.h
  /usr/include/libscca/types.h
  /usr/lib/libscca.dll.a
  /usr/lib/pkgconfig/libscca.pc
  /usr/share/man/man3/libscca.3.gz

(python312-libscca)
  /usr/lib/python3.12/site-packages/pyscca.dll

