+#ifdef __CYGWIN__
+static int
+_m_msg_client_connect_wait (int sd)
+{
+/*  Waits for a nonblocking connect() on socket [sd] to complete.
+ *  Returns 0 on success, or -1 on error (with errno set).
+ */
+    struct pollfd  pfd;
+    int            n;
+    int            e;
+    socklen_t      len;
+
+    pfd.fd = sd;
+    pfd.events = POLLOUT;
+    do {
+        n = poll (&pfd, 1, MUNGE_SOCKET_TIMEOUT_MSECS);
+    } while ((n < 0) && (errno == EINTR));
+
+    if (n < 0) {
+        return (-1);
+    }
+    if (n == 0) {
+        errno = ETIMEDOUT;
+        return (-1);
+    }
+    len = sizeof (e);
+    if (getsockopt (sd, SOL_SOCKET, SO_ERROR, &e, &len) < 0) {
+        return (-1);
+    }
+    if (e != 0) {
+        errno = e;
+        return (-1);
+    }
+    return (0);
+}
+#endif /* __CYGWIN__ */
