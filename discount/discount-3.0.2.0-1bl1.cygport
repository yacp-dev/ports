HOMEPAGE="https://github.com/Orc/${PN}"
SRC_URI="https://github.com/Orc/${PN}/archive/refs/tags/v${PV}.tar.gz"

CATEGORY="Text"
SUMMARY="My C implementation of John Gruber's Markdown markup language"
DESCRIPTION="${SUMMARY}"

LICENSE="BSD-3-Clause"
LICENSE_SPDX="SPDX-License-Identifier: BSD-3-Clause"
LICENSE_URI="COPYRIGHT"

inherit cmake

src_compile()
{
	cd ${B}
	: ${CYGCMAKE_GENERATOR=Ninja}
	CYGCMAKE_SOURCE="${S}/cmake" cygcmake
	cygninja
}

# The CMake build doesn't build the test framework or run tests/*.t;
# do what "make test" in the configure.sh build does.
src_test()
{
	local t rc=0

	cd ${B}
	# 300.c and rep.c are K&R C (rep.c leaves argc's type implicit)
	for t in 300 cols echo rep space2nl
	do
		${CC} ${CFLAGS} -std=gnu89 -o ${t} ${S}/tools/${t}.c || error "${t} build failed"
	done
	${CC} ${CFLAGS} -I${B} -I${S} -o pandoc_headers \
		${S}/tools/pandoc_headers.c ${S}/gethopt.c ${S}/notspecial.c \
		-L${B} -lmarkdown || error "pandoc_headers build failed"
	ln -sfn ${S}/tests tests

	for t in tests/*.t
	do
		sh ${t} || rc=1
	done
	[ ${rc} -eq 0 ] || error "tests failed"
}

CYGCMAKE_ARGS="
	-DBUILD_SHARED_LIBS:BOOL=ON
	-DCMAKE_POLICY_VERSION_MINIMUM:STRING=3.5
	-DSOVERSION:STRING=${PV[1]}
"

DIFF_EXCLUDES="
	blocktags
	*.c
	*.h
"

PKG_NAMES="
	discount
	libmarkdown3
	libmarkdown-devel
"
discount_CONTENTS="
	usr/bin/*.exe
	usr/share
"
libmarkdown3_CONTENTS="
	usr/bin/cyg*-3.dll
"
libmarkdown_devel_CONTENTS="
	usr/include
	usr/lib
"
discount_SUMMARY="${SUMMARY} (utilities)"
libmarkdown3_SUMMARY="${SUMMARY} (runtime)"
libmarkdown_devel_SUMMARY="${SUMMARY} (development)"
