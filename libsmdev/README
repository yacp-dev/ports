(libsmdev1)
  /usr/bin/cygsmdev-1.dll

(libsmdev-devel)
  /usr/include/libsmdev.h
  /usr/include/libsmdev/codepage.h
  /usr/include/libsmdev/definitions.h
  /usr/include/libsmdev/error.h
  /usr/include/libsmdev/extern.h
  /usr/include/libsmdev/features.h
  /usr/include/libsmdev/types.h
  /usr/lib/libsmdev.dll.a
  /usr/lib/pkgconfig/libsmdev.pc
  /usr/share/man/man3/libsmdev.3.gz

(python312-libsmdev)
  /usr/lib/python3.12/site-packages/pysmdev.cpython-312-x86_64-cygwin.dll

