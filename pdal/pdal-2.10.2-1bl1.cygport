HOMEPAGE="https://github.com/PDAL/PDAL"
SRC_URI="https://github.com/PDAL/PDAL/releases/download/${PV}/PDAL-${PV}-src.tar.gz"
PATCH_URI="
	https://src.fedoraproject.org/rpms/PDAL/raw/fc5d7fa7b23d04e458b1b5f6d83f1a02224cc3ff/f/PDAL_unbundle.patch
	https://src.fedoraproject.org/rpms/PDAL/raw/fc5d7fa7b23d04e458b1b5f6d83f1a02224cc3ff/f/PDAL_gdalinc.patch
	https://src.fedoraproject.org/rpms/PDAL/raw/fc5d7fa7b23d04e458b1b5f6d83f1a02224cc3ff/f/PDAL_cstdint.patch
"
SRC_DIR="PDAL-${PV}-src"

CATEGORY="Libs"
SUMMARY="Point Data Abstraction Library"
DESCRIPTION="PDAL is Point Data Abstraction Library. It is a C/C++ open source library and
applications for translating and processing point cloud data. It is not
limited to LiDAR data, although the focus and impetus for many of the tools in
the library have their origins in LiDAR."

LICENSE="Apache-2.0 AND BSD-2-Clause AND BSD-3-Clause AND BSL-1.0 AND CC0-1.0 AND MIT"
LICENSE_SPDX="SPDX-License-Identifier: Apache-2.0 AND BSD-2-Clause AND BSD-3-Clause AND BSL-1.0 AND CC0-1.0 AND MIT"
LICENSE_URI="LICENSE.txt vendor/arbiter/LICENSE vendor/utfcpp/LICENSE"

BUILD_REQUIRES="
	eigen3
	hdf5
	libaec-devel
	libcpd-devel
	libcurl-devel
	libdraco-devel
	libE57Format-devel
	libgdal-devel
	libgeotiff-devel
	libgtest-devel
	libhdf5-devel
	libpq-devel
	libproj-devel
	libssl-devel
	libxml2-devel
	zlib-devel
"

export CPPFLAGS="${CPPFLAGS} -D_GNU_SOURCE"

inherit cmake

CYGCMAKE_ARGS="
	-DBUILD_PLUGIN_CPD:BOOL=ON
	-DBUILD_PLUGIN_DRACO:BOOL=ON
	-DBUILD_PLUGIN_E57:BOOL=ON
	-DBUILD_PLUGIN_HDF:BOOL=ON
	-DBUILD_PLUGIN_ICEBRIDGE:BOOL=ON
	-DBUILD_PLUGIN_PGPOINTCLOUD:BOOL=ON
	-DWITH_BACKTRACE:BOOL=OFF
	-DWITH_COMPLETION:BOOL=ON
	-DWITH_TESTS:BOOL=OFF
"

src_test()
{
	cd ${B}
	PATH=${B}/bin:${PATH} ./bin/pdal.exe --version
}

DIFF_EXCLUDES="
	data
	temp
"

PKG_NAMES="
	pdal
	libpdal20
	libpdal-devel
"
pdal_CONTENTS="
	usr/bin/*.exe
	usr/share
"
libpdal20_CONTENTS="
	usr/bin/cyg*-20.dll
"
libpdal_devel_CONTENTS="
	usr/bin/*-config
	usr/include
	usr/lib
"
pdal_SUMMARY="${SUMMARY} (utilities)"
libpdal20_SUMMARY="${SUMMARY} (runtime)"
libpdal_devel_SUMMARY="${SUMMARY} (development)"
