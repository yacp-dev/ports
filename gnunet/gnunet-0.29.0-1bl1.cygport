HOMEPAGE="https://www.${PN}.org/en/"
SRC_URI="mirror://gnu/${PN}/${P}.tar.gz"

CATEGORY="Net"
SUMMARY="Framework for distributed, secure and privacy-preserving applications"
DESCRIPTION="GNUnet is peer-to-peer framework providing a network abstractions and
applications focusing on security and privacy.  So far, we have
created applications for anonymous file-sharing, decentralized naming
and identity management, decentralized and confidential telephony and
tunneling IP traffic over GNUnet.  GNUnet is currently developed by a
worldwide group of independent free software developers.  GNUnet is a
GNU package (https://www.gnu.org/)."

LICENSE="AGPL-3.0-or-later AND MIT AND 0BSD"
LICENSE_SPDX="SPDX-License-Identifier: AGPL-3.0-or-later AND MIT AND 0BSD"
LICENSE_URI="COPYING"

BUILD_REQUIRES="
	gettext-devel
	libcurl-devel
	libextractor-devel
	libgcrypt-devel
	libgmp-devel
	libgnutls-devel
	libidn2-devel
	libintl-devel
	libjansson-devel
	libjose-devel
	libmicrohttpd-devel
	libogg-devel
	libopus-devel
	libpq-devel
	libpq5
	libpulse-devel
	libsodium-devel
	libsqlite3-devel
	libunistring-devel
	libzbar-devel
	zlib-devel
"

export CPPFLAGS="${CPPFLAGS} -DICMP_ECHO=0x08"

inherit meson

src_install() {
	cd ${S}
	meson_install

	# Move DLLs from /usr/lib to /usr/bin (Cygwin convention)
	mv ${D}/usr/lib/*.dll ${D}/usr/bin/

	# Plugins are only dlopen()ed; nothing links against their import libraries
	rm -f ${D}/usr/lib/gnunet/*.dll.a

	rm -fr ${D}/usr/share/doc/gnunet/html
}

DIFF_EXCLUDES="
	gnunet_config.h
	gnunet.conf.5
	peerstore.conf
	*.po
	*.pot
	disabled_jobs
"

