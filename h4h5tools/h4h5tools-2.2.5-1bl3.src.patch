--- origsrc/h4h5tools-2.2.5/lib/src/h4toh5apicompatible.h	2020-03-10 14:33:18.000000000 +0000
+++ src/h4h5tools-2.2.5/lib/src/h4toh5apicompatible.h	2026-11-21 07:35:55.321523300 +0000
@@ -54,5 +54,39 @@
     
 #endif
 
+/* HDF4 4.4 dropped Vgetnamelen()/Vgetclassnamelen() and gave Vgetname()/
+   Vgetclass() a size_t *buf_size argument. Emulate the old API on top of it. */
+#ifndef H4H5_VGET_COMPAT
+#define H4H5_VGET_COMPAT
+static inline int h4h5_vget_len(int32 id, uint16 *len, int cls)
+{
+    size_t n = 0;
+    int    r = cls ? Vgetclass(id, NULL, &n) : Vgetname(id, NULL, &n);
+    if (r != FAIL)
+        *len = (uint16)n;
+    return r;
+}
+static inline int h4h5_vgetname(int32 id, char *buf)
+{
+    size_t n = 0;
+    if (Vgetname(id, NULL, &n) == FAIL)
+        return FAIL;
+    n++;
+    return Vgetname(id, buf, &n);
+}
+static inline int h4h5_vgetclass(int32 id, char *buf)
+{
+    size_t n = 0;
+    if (Vgetclass(id, NULL, &n) == FAIL)
+        return FAIL;
+    n++;
+    return Vgetclass(id, buf, &n);
+}
+#define Vgetnamelen(id, lenp) h4h5_vget_len((id), (lenp), 0)
+#define Vgetclassnamelen(id, lenp) h4h5_vget_len((id), (lenp), 1)
+#define Vgetname(id, buf) h4h5_vgetname((id), (buf))
+#define Vgetclass(id, buf) h4h5_vgetclass((id), (buf))
+#endif
+
 #endif
 
