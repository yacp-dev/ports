--- origsrc/snapraid-15.2/os/unix.c	2026-11-11 20:58:59.000000000 +0000
+++ src/snapraid-15.2/os/unix.c	2026-11-24 23:31:09.645948500 +0000
@@ -930,6 +930,97 @@ static void exec_unlock(void)
 	pthread_mutex_unlock(&exec_mutex);
 }
 
+#if defined(__CYGWIN__)
+/*
+ * Cygwin has no waitid(). Emulate the only forms used here, P_PID with
+ * WEXITED and optionally WNOHANG and WNOWAIT, with waitpid(). A child
+ * can't be observed without reaping it, so its status is kept in a
+ * small table until the following waitpid() call returns it.
+ */
+#ifndef P_PID
+#define P_PID 1
+#endif
+#ifndef WEXITED
+#define WEXITED 4
+#endif
+#ifndef WNOWAIT
+#define WNOWAIT 0x01000000
+#endif
+
+#define WAIT_CACHE_MAX 64
+
+static pthread_mutex_t wait_cache_mutex = PTHREAD_MUTEX_INITIALIZER;
+static pid_t wait_cache_pid[WAIT_CACHE_MAX];
+static int wait_cache_status[WAIT_CACHE_MAX];
+
+static int cygwin_waitid(int idtype, id_t id, siginfo_t* info, int options)
+{
+	pid_t pid = (pid_t)id;
+	pid_t ret;
+	int status;
+	int i;
+
+	(void)idtype;
+
+	pthread_mutex_lock(&wait_cache_mutex);
+	for (i = 0; i < WAIT_CACHE_MAX; ++i) {
+		if (wait_cache_pid[i] == pid) {
+			pthread_mutex_unlock(&wait_cache_mutex);
+			info->si_pid = pid;
+			return 0;
+		}
+	}
+	pthread_mutex_unlock(&wait_cache_mutex);
+
+	ret = waitpid(pid, &status, (options & WNOHANG) ? WNOHANG : 0);
+	if (ret < 0)
+		return -1;
+	if (ret == 0) {
+		info->si_pid = 0;
+		return 0;
+	}
+
+	pthread_mutex_lock(&wait_cache_mutex);
+	for (i = 0; i < WAIT_CACHE_MAX; ++i) {
+		if (wait_cache_pid[i] == 0) {
+			wait_cache_pid[i] = pid;
+			wait_cache_status[i] = status;
+			break;
+		}
+	}
+	pthread_mutex_unlock(&wait_cache_mutex);
+
+	if (i == WAIT_CACHE_MAX) {
+		errno = EAGAIN;
+		return -1;
+	}
+
+	info->si_pid = pid;
+	return 0;
+}
+
+static pid_t cygwin_waitpid(pid_t pid, int* status, int options)
+{
+	int i;
+
+	pthread_mutex_lock(&wait_cache_mutex);
+	for (i = 0; i < WAIT_CACHE_MAX; ++i) {
+		if (wait_cache_pid[i] == pid && pid > 0) {
+			wait_cache_pid[i] = 0;
+			*status = wait_cache_status[i];
+			pthread_mutex_unlock(&wait_cache_mutex);
+			return pid;
+		}
+	}
+	pthread_mutex_unlock(&wait_cache_mutex);
+
+	return waitpid(pid, status, options);
+}
+
+#define waitid(idtype, id, info, options) cygwin_waitid(idtype, id, info, options)
+#define waitpid(pid, status, options) cygwin_waitpid(pid, status, options)
+#endif
+
