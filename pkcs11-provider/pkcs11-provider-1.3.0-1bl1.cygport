HOMEPAGE="https://github.com/latchset/${PN}"
SRC_URI="https://github.com/latchset/${PN}/archive/refs/tags/v${PV}.tar.gz"

CATEGORY="Security"
SUMMARY="PKCS11 provider for OpenSSL 3.0+"
DESCRIPTION="${SUMMARY}"

LICENSE="Apache-2.0"
LICENSE_SPDX="SPDX-License-Identifier: Apache-2.0"
LICENSE_URI="COPYING"

BUILD_REQUIRES="
	libnss-devel
	libp11-kit-devel
	libssl-devel
	nss
	opensc
"

inherit meson

DOCS="
	HOWTO.md
	LICENSES/*
"

PKG_CONTENTS="
	usr/lib/ossl-modules/pkcs11.dll
	usr/share
"

src_install() {
	cd ${S}
	meson_install
	rm -f ${D}/usr/lib/ossl-modules/pkcs11.dll.a
}
