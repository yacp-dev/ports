HOMEPAGE="https://github.com/mongodb/${PN}"
SRC_URI="https://github.com/mongodb/${PN}/archive/refs/tags/r${PV}.tar.gz"
SRC_DIR="${PN}-r${PV}"

CATEGORY="Libs"
SUMMARY="C++ Driver for MongoDB"
DESCRIPTION="${SUMMARY}"

LICENSE="Apache-2.0"
LICENSE_SPDX="SPDX-License-Identifier: Apache-2.0"
LICENSE_URI="LICENSE"

BUILD_REQUIRES="
	libCatch2-devel
	libbson2-devel
	libmongoc2-devel
"

inherit cmake

CYGCMAKE_ARGS="
	-DBUILD_TESTING:BOOL=ON
	-DBUILD_VERSION:STRING=${PV}
	-DENABLE_TESTS:BOOL=ON
"

src_test()
{
	cd ${B}
	PATH=${B}/src/bsoncxx/test:${B}/src/mongocxx/test:${PATH} ninja_test
}

src_install()
{
	cd ${B}
	ninja_install

	cd ${D}
	rm -f usr/share/mongo-cxx-driver/LICENSE
	rm -f usr/share/mongo-cxx-driver/README.md
	rm -f usr/share/mongo-cxx-driver/THIRD-PARTY-NOTICES
}

DOCS="
	CHANGELOG.md
	CONTRIBUTING.md
	THIRD-PARTY-NOTICES
"

PKG_NAMES="
	mongo-cxx-driver
	libmongocxx1_1
	libmongocxx1-devel
	libbsoncxx1_1
	libbsoncxx1-devel
"
mongo_cxx_driver_CONTENTS="
	usr/share
"
libmongocxx1_1_CONTENTS="
	usr/bin/cygmongocxx1-1.dll
"
libmongocxx1_devel_CONTENTS="
	usr/include/mongocxx
	usr/lib/cmake/mongocxx-${PV}
	usr/lib/libmongocxx1.dll.a
	usr/lib/pkgconfig/libmongocxx1.pc
"
libbsoncxx1_1_CONTENTS="
	usr/bin/cygbsoncxx1-1.dll
"
libbsoncxx1_devel_CONTENTS="
	usr/include/bsoncxx
	usr/lib/cmake/bsoncxx-${PV}
	usr/lib/libbsoncxx1.dll.a
	usr/lib/pkgconfig/libbsoncxx1.pc
"
mongo_cxx_driver_SUMMARY="${SUMMARY} (licensing and readmes)"
libmongocxx1_1_SUMMARY="${SUMMARY} (runtime)"
libmongocxx1_devel_SUMMARY="${SUMMARY} (development)"
libbsoncxx1_1_SUMMARY="MongoDB C++11 BSON Library (runtime)"
libbsoncxx1_devel_SUMMARY="MongoDB C++11 BSON Library (development)"
libmongocxx1_devel_REQUIRES="libmongoc2-devel"
libbsoncxx1_devel_REQUIRES="libbson2-devel"
