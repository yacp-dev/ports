HOMEPAGE="https://github.com/ziman/${PN}"
SRC_URI="https://github.com/ziman/${PN}/archive/refs/tags/${PV}.tar.gz"
PATCH_URI="
	https://aur.archlinux.org/cgit/aur.git/plain/file-type-detection.patch?h=bfdff49e60acdc52d294eb1df8768bd1597ad18d
	https://raw.githubusercontent.com/pld-linux/rarcrack/925f023d28b83c16fc3523c25466f1c167d4e6c3/rarcrack-cflags.patch
"

CATEGORY="Security"
SUMMARY="Use brute force algorithm to find the correct password for rar, 7z, zip archives"
DESCRIPTION="Use brute force algorithm to find the correct password for rar, 7z, zip
archives."

LICENSE="GPL-2.0-or-later"
LICENSE_SPDX="SPDX-License-Identifier: GPL-2.0-or-later"
LICENSE_URI="LICENSE"

BUILD_REQUIRES="
	libxml2-devel
"

src_compile()
{
	cd ${B}
	lndirs
	cygmake
}

src_test()
{
	cd ${B}
	verbose ./${PN}.exe --version
}

DOCS="
	CHANGELOG
	RELEASE_NOTES
"
HTMLDOCS="
	*.html
"

src_install()
{
	cd ${B}
	dobin ${PN}.exe
}
