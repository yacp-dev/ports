+// A forced x86 codec runs whether or not the CPU has its instructions, and
+// the short test string below never reaches the SIMD loop, so check the CPU:
+static int
+cpu_supported (int flags)
+{
+#if defined(__GNUC__) && (defined(__x86_64__) || defined(__i386__))
+	__builtin_cpu_init();
+	if (flags & BASE64_FORCE_AVX2)
+		return __builtin_cpu_supports("avx2");
+	if (flags & BASE64_FORCE_SSSE3)
+		return __builtin_cpu_supports("ssse3");
+	if (flags & BASE64_FORCE_SSE41)
+		return __builtin_cpu_supports("sse4.1");
+	if (flags & BASE64_FORCE_SSE42)
+		return __builtin_cpu_supports("sse4.2");
+	if (flags & BASE64_FORCE_AVX)
+		return __builtin_cpu_supports("avx");
+	if (flags & BASE64_FORCE_AVX512)
+		return __builtin_cpu_supports("avx512vl")
+			&& __builtin_cpu_supports("avx512vbmi");
+#endif
+	return 1;
+}
+
 int
 codec_supported (int flags)
 {
+	if (!cpu_supported(flags))
+		return 0;
