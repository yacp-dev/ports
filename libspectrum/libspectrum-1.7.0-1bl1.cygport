HOMEPAGE="http://fuse-emulator.sf.net/${PN}.php"
SRC_URI="mirror://sourceforge/fuse-emulator/${P}.tar.gz"

CATEGORY="Libs"
SUMMARY="ZX Spectrum emulator support library"
DESCRIPTION="libspectrum is a library designed to make the input and output of some ZX
Spectrum emulator files slightly easier."

LICENSE="GPL-2.0-or-later AND MIT"
LICENSE_SPDX="SPDX-License-Identifier: GPL-2.0-or-later AND MIT"
LICENSE_URI="COPYING"

BUILD_REQUIRES="
	libaudiofile-devel
	libbz2-devel
	libgcrypt-devel
	libglib2.0-devel
	zlib-devel
"

CYGCONF_ARGS="
	--enable-audiofiletest
"

DIFF_EXCLUDES="
	.libs
	*.tzx
"

src_test()
{
	cd ${B}
	PATH=${B}/.libs:${PATH} cygtest
}

PKG_NAMES="
	${PN}
	${PN}21
	${PN}-devel
"
libspectrum_CONTENTS="
	usr/share/doc
"
libspectrum21_CONTENTS="
	usr/bin/cyg*-21.dll
"
libspectrum_devel_CONTENTS="
	usr/include
	usr/lib
	usr/share/man
"
libspectrum_SUMMARY="${SUMMARY} (licensing & readmes)"
libspectrum21_SUMMARY="${SUMMARY} (runtime)"
libspectrum_devel_SUMMARY="${SUMMARY} (development)"
