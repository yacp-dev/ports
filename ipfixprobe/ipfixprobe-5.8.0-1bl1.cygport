HOMEPAGE="https://github.com/CESNET/${PN}"
SRC_URI="https://github.com/CESNET/${PN}/archive/refs/tags/v${PV}.tar.gz"
PATCH_URI="
	ipfixprobe-5.8.0-cygwin.patch
"

CATEGORY="Net"
SUMMARY="IPFIX flow exporter"
DESCRIPTION="This application creates biflows from packet input and exports them to output
interface."

LICENSE="BSD-3-Clause"
LICENSE_SPDX="SPDX-License-Identifier: BSD-3-Clause"
LICENSE_URI="LICENSE"

BUILD_REQUIRES="
	git
	liblz4-devel
	libssl-devel
	libtelemetry-devel
	libunwind-devel
"

# pthread_setname_np, pthread_setaffinity_np and CPU_ZERO need _GNU_SOURCE
export CFLAGS="${CFLAGS} -D_GNU_SOURCE"
export CXXFLAGS="${CXXFLAGS} -D_GNU_SOURCE"

inherit cmake

CYGCMAKE_ARGS="
	-DENABLE_RPMBUILD:BOOL=OFF
"

src_compile()
{
	cd ${B}
	: ${CYGCMAKE_GENERATOR=Ninja}
	# libatomic lives in gcc's own directory, which find_library doesn't search
	local atomic=$(${CC:-gcc} -print-file-name=libatomic.dll.a)
	cygcmake -DATOMIC_LIBRARY:FILEPATH=${atomic}
	cygninja
}
