HOMEPAGE="https://github.com/DataDog/${PN}"
SRC_URI="https://github.com/DataDog/${PN}/archive/refs/tags/${PV}.tar.gz"

CATEGORY="Libs"
SUMMARY="Datadog's implementation of a WAF engine"
DESCRIPTION="libddwaf is Datadog's implementation of a Web Application Firewall (WAF)
engine, with a goal of low performance and memory overhead, and embeddability
in a wide variety of language runtimes through a C API."

LICENSE="(Apache-2.0 OR BSD-3-Clause) AND Apache-2.0 AND BSD-3-Clause AND BSD-4-Clause AND MIT"
LICENSE_SPDX="SPDX-License-Identifier: (Apache-2.0 OR BSD-3-Clause) AND Apache-2.0 AND BSD-3-Clause AND BSD-4-Clause AND MIT"
LICENSE_URI="LICENSE"

BUILD_REQUIRES="
	git
	libiconv-devel
	libintl-devel
	libgmock-devel
	libgtest-devel
	libyaml-cpp-devel
"

export CPPFLAGS="${CPPFLAGS} -D_GNU_SOURCE -DRAPIDJSON_HAS_STDSTRING=1"

inherit cmake

CYGCMAKE_ARGS="
	-DGIT_COMMIT:STRING=510d0e15501776157f6dff52a280b0a85b9c307d
	-DLIBDDWAF_BUILD_STATIC:BOOL=OFF
	-DSOVERSION:STRING=${PV[1]}
"

# cygport check takes ~14 min to compile and run the test suite
YACP_CHECK_TIMEOUT_MINUTES=20

src_test()
{
	cd ${B}
	ninja_test
}

src_install()
{
	cd ${B}
	ninja_install

	cd ${D}
	verbose rm -fr usr/lib/.build-id
}

DOCS="
	CONTRIBUTING.md
	LICENSE-3rdparty.csv
	NOTICE
	UPGRADING.md
	docs/changelog/*.md
"

DIFF_EXCLUDES="
	base_path.hpp
	version.hpp
"

PKG_NAMES="
	libddwaf
	libddwaf${PV[1]}
	libddwaf-devel
"
libddwaf_CONTENTS="
	usr/share
"
libddwaf2_CONTENTS="
	usr/bin/cyg*-${PV[1]}.dll
"
libddwaf_devel_CONTENTS="
	usr/include
	usr/lib
"
libddwaf_SUMMARY="${SUMMARY} (licensing & readmes)"
libddwaf2_SUMMARY="${SUMMARY} (runtime)"
libddwaf_devel_SUMMARY="${SUMMARY} (development)"
