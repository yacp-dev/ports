  /usr/include/dnswire/dnstap.pb-c.h
  /usr/include/dnswire/dnswire.h
  /usr/include/dnswire/encoder.h
  /usr/include/dnswire/reader.h
  /usr/include/dnswire/trace.h
  /usr/include/dnswire/version.h
  /usr/include/dnswire/writer.h
  /usr/lib/libdnswire.dll.a
