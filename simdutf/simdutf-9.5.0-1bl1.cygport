HOMEPAGE="https://github.com/${PN}/${PN}"
SRC_URI="https://github.com/${PN}/${PN}/archive/refs/tags/v${PV}.tar.gz"

CATEGORY="Libs"
SUMMARY="Unicode validation and transcoding at billions of characters per second"
DESCRIPTION="${SUMMARY}"

LICENSE="(Apache-2.0 OR MIT) AND BSD-3-Clause"
LICENSE_SPDX="SPDX-License-Identifier: (Apache-2.0 OR MIT) AND BSD-3-Clause"
LICENSE_URI="LICENSE-APACHE"

BUILD_REQUIRES="
	libbase64-devel
	libiconv-devel
	libintl-devel
"

# GCC can't realign the stack for 64-byte AVX512 spills on x86_64 Windows
# (GCC PR 54412), so vmovdqa64 to the stack faults in the icelake base64
# decoder; have the assembler emit unaligned moves instead.
CXXFLAGS+=" -Wa,-muse-unaligned-vector-move"

inherit cmake

CYGCMAKE_ARGS="
	-DBUILD_SHARED_LIBS:BOOL=ON
	-DSIMDUTF_BENCHMARKS:BOOL=ON
"

src_test()
{
	cd ${B}
	PATH=${B}/src:${PATH} ninja_test
}

DOCS="
	LICENSE-*
"

PKG_NAMES="
	simdutf
	libsimdutf39
	libsimdutf-devel
"
simdutf_CONTENTS="
	usr/bin/*.exe
	usr/bin/fastbase64.coreutils
	usr/share
"
libsimdutf39_CONTENTS="
	usr/bin/cygsimdutf-39.dll
"
libsimdutf_devel_CONTENTS="
	usr/include
	usr/lib
"
simdutf_SUMMARY="${SUMMARY} (utilities)"
libsimdutf39_SUMMARY="${SUMMARY} (runtime)"
libsimdutf_devel_SUMMARY="${SUMMARY} (development)"
