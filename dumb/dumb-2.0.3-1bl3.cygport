HOMEPAGE="https://github.com/kode54/${PN}"
SRC_URI="https://github.com/kode54/${PN}/archive/refs/tags/${PV}.tar.gz"
PATCH_URI="
	https://raw.githubusercontent.com/gentoo/gentoo/0ad96e879b651cc7e8214159d5841d6b633bef8a/media-libs/dumb/files/dumb-2.0.3-cmake4.patch
	https://raw.githubusercontent.com/gentoo/gentoo/0ad96e879b651cc7e8214159d5841d6b633bef8a/media-libs/dumb/files/dumb-2.0.3-pkg-config.patch
"

CATEGORY="Libs"
SUMMARY="Module/tracker based music format parser and player library"
DESCRIPTION="DUMB is a module audio renderer library. It reads module files and outputs
audio that can be dumped to the actual audio playback library."

LICENSE="Zlib"
LICENSE_SPDX="SPDX-License-Identifier: Zlib"
LICENSE_URI="LICENSE"

BUILD_REQUIRES="
	libSDL2-devel
	libargtable2-devel
"

inherit cmake

CYGCMAKE_ARGS="
	-DBUILD_ALLEGRO4:BOOL=OFF
	-DBUILD_SHARED_LIBS:BOOL=ON
"

src_test()
{
	cd ${B}

	# both print their usage and exit 1
	local out prog
	for prog in dumbout dumbplay
	do
		out=$(verbose ./${prog}.exe --help 2>&1) || :
		echo "${out}"
		grep -q "^Usage:" <<<"${out}"
	done
}

src_install()
{
	cd ${B}
	ninja_install

	# upstream sets DUMB_VERSION to major.minor only
	verbose sed -i -e "s|^Version: .*|Version: ${PV}|" ${D}/usr/lib/pkgconfig/dumb.pc
}

DOCS="
	*.md
"

PKG_NAMES="
	dumb
	libdumb2
	libdumb-devel
"
dumb_CONTENTS="
	usr/bin/*.exe
	usr/share
"
libdumb2_CONTENTS="
	usr/bin/cyg*-2.dll
"
libdumb_devel_CONTENTS="
	usr/include
	usr/lib
"
dumb_SUMMARY="${SUMMARY} (utilities)"
libdumb2_SUMMARY="${SUMMARY} (runtime)"
libdumb_devel_SUMMARY="${SUMMARY} (development)"
