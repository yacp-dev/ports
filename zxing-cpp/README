  /usr/include/ZXing/GTIN.h
  /usr/include/ZXing/ImageView.h
  /usr/include/ZXing/Point.h
  /usr/include/ZXing/Quadrilateral.h
  /usr/include/ZXing/ReadBarcode.h
  /usr/include/ZXing/ReaderOptions.h
  /usr/include/ZXing/Version.h
  /usr/include/ZXing/WriteBarcode.h
  /usr/include/ZXing/ZXVersion.h
  /usr/include/ZXing/ZXingC.h
  /usr/include/ZXing/ZXingCpp.h
  /usr/include/ZXing/ZXingQt.h
  /usr/lib/cmake/ZXing/ZXingConfig.cmake
  /usr/lib/cmake/ZXing/ZXingConfigVersion.cmake
  /usr/lib/cmake/ZXing/ZXingTargets-relwithdebinfo.cmake
  /usr/lib/cmake/ZXing/ZXingTargets.cmake
  /usr/lib/libZXing.dll.a
