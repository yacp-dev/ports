@@ -422,6 +422,9 @@ s_z85_decode (const char *data, size_t *
     assert (length % 5 == 0);
     *size = 4 * length / 5 + 1;
     byte *bytes = (byte *) zmalloc (*size);
+    //  libzmq >= 4.3 rejects an empty string, which is a valid (empty) Z85 input
+    if (length == 0)
+        return bytes;
     uint8_t *result = zmq_z85_decode (bytes, (char *) data);
     if (result == NULL) {
         free (bytes);
--- origsrc/czmq-3.0.2/src/zauth.c	2015-06-08 07:29:29.000000000 +0000
+++ src/czmq-3.0.2/src/zauth.c	2026-11-17 01:23:09.555036600 +0000
@@ -462,6 +462,10 @@ s_can_connect (zsock_t **server, zsock_t
     int rc = zsock_connect (*client, "tcp://127.0.0.1:%d", port_nbr);
     assert (rc == 0);
 
+    //  A PUSH socket blocks while it has no peer. libzmq >= 4.2 only attaches
+    //  the peer once the handshake (ZAP) has passed, so a denied client
+    //  would block this send forever.
+    zsock_set_sndtimeo (*server, 200);
     zstr_send (*server, "Hello, World");
     zpoller_t *poller = zpoller_new (*client, NULL);
     assert (poller);
--- origsrc/czmq-3.0.2/src/zauth_v2.c	2015-06-08 07:29:29.000000000 +0000
