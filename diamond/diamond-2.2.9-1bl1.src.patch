+#ifdef __CYGWIN__
+// Cygwin's fma() is computed as (x * y) + z with two roundings, so a result that
+// lies on a rounding boundary (e.g. 96.85) differs from the fused one by one ulp
+// and is printed as a different digit. Compute the fused result in software:
+// an exact product by Veltkamp/Dekker splitting and a compensated sum.
+static double fused_multiply_add(double x, double y, double z) {
+	const double p = x * y;
+	const double split = 134217729.0; // 2^27 + 1
+	double t = split * x;
+	const double xh = t - (t - x), xl = x - xh;
+	t = split * y;
+	const double yh = t - (t - y), yl = y - yh;
+	const double e = ((xh * yh - p) + xh * yl + xl * yh) + xl * yl; // p + e == x * y
+	const double s = p + z;
+	const double b = s - p;
+	const double err = (p - (s - b)) + (z - b);
+	return s + (err + e);
+}
+#else
+static inline double fused_multiply_add(double x, double y, double z) {
+	return std::fma(x, y, z);
+}
+#endif
