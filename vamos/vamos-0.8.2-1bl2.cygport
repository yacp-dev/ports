HOMEPAGE="https://${PN}.sourceforge.net/"
SRC_URI="mirror://sourceforge/${PN}/${P}.tar.gz"

CATEGORY="Libs"
SUMMARY="Automotive simulation framework"
DESCRIPTION="Vamos is an automotive simulation framework with an emphasis on thorough
physical modeling and good C++ design. Vamos includes a real-time,
first-person, 3D driving application."

LICENSE="GPL-3.0-or-later"
LICENSE_SPDX="SPDX-License-Identifier: GPL-3.0-or-later"
LICENSE_URI="COPYING"

BUILD_REQUIRES="
	autoconf-archive
	libalut-devel
	libboost-devel
	libboost_python3-devel
	libGL-devel
	libGLU-devel
	libglut-devel
	libopenal-devel
	libpng-devel
	libSDL-devel
	pkgconf
	python3-devel
	zlib-devel
"

CYGPORT_USE_UNSTABLE_API=1
src_patch_hook()
{
	cd ${origsrcdir}/${SRC_DIR}
	rm -f acinclude.m4
}

HTMLDOCS="
	doc/*.htm
"

DIFF_EXCLUDES="
	config.py
"

PKG_NAMES="
	${PN}
	lib${PN}0
	lib${PN}-devel
"
vamos_CONTENTS="
	usr/bin/*.exe
	usr/bin/${PN}
	usr/lib/python*
	usr/share/doc
	usr/share/${PN}
"
libvamos0_CONTENTS="
	usr/bin/cyg*-0.dll
"
libvamos_devel_CONTENTS="
	usr/include
	usr/lib/lib*.dll.a
	usr/share/info
"

vamos_SUMMARY="${SUMMARY} (utilities)"
libvamos0_SUMMARY="${SUMMARY} (runtime)"
libvamos_devel_SUMMARY="${SUMMARY} (development)"
