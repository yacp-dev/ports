+
+set(prefix ${CMAKE_INSTALL_PREFIX})
+set(exec_prefix ${CMAKE_INSTALL_PREFIX})
+set(libdir ${CMAKE_INSTALL_PREFIX}/lib)
+set(includedir ${CMAKE_INSTALL_PREFIX}/include)
+file(WRITE "${CMAKE_BINARY_DIR}/libefp.pc"
+"prefix=${prefix}
+exec_prefix=\${prefix}
+libdir=\${exec_prefix}/lib
+includedir=\${prefix}/include
+
+Name: libefp
+Description: Effective Fragment Potential method
+Version: ${PROJECT_VERSION}
+Libs: -L\${libdir} -lefp
+Cflags: -I\${includedir}
+")
+install(FILES ${CMAKE_BINARY_DIR}/libefp.pc DESTINATION ${CMAKE_INSTALL_PREFIX}/lib/pkgconfig)
+
+option(LIBEFP_ENABLE_EFPMD "Build standalone efpmd executable" ON)
