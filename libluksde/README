  /usr/lib/libluksde.dll.a
  /usr/lib/pkgconfig/libluksde.pc
  /usr/share/man/man3/libluksde.3.gz

(python312-libluksde)
  /usr/lib/python3.12/site-packages/pyluksde.cpython-312-x86_64-cygwin.dll

