HOMEPAGE="https://github.com/${PN}/${PN}"
# the git submodules the build uses, which the tag's tarball leaves empty:
# testdata for the tests, sjpeg and skcms compiled in. Keep them at the
# commits the tag points to; the other submodules are system libraries here
TESTDATA_REV="73695d303670c90e4d506ea89d9901b081385089"
SJPEG_REV="dd4d9857c58a25713711a46d37385ad23ca2177e"
SKCMS_REV="96d9171c94b937a1b5f0293de7309ac16311b722"
SRC_URI="
	https://github.com/${PN}/${PN}/archive/refs/tags/v${PV}.tar.gz#/${P}.tar.gz
	https://github.com/${PN}/testdata/archive/${TESTDATA_REV}.tar.gz#/testdata-${TESTDATA_REV}.tar.gz
	https://github.com/webmproject/sjpeg/archive/${SJPEG_REV}.tar.gz#/sjpeg-${SJPEG_REV}.tar.gz
	https://github.com/google/skcms/archive/${SKCMS_REV}.tar.gz#/skcms-${SKCMS_REV}.tar.gz
"

CATEGORY="Libs"
SUMMARY="JPEG XL image format reference implementation"
DESCRIPTION="${SUMMARY}"

LICENSE="Apache-2.0 AND BSD-3-Clause AND Zlib"
LICENSE_SPDX="SPDX-License-Identifier: Apache-2.0 AND BSD-3-Clause AND Zlib"
LICENSE_URI="LICENSE"

BUILD_REQUIRES="
	libavif-devel
	libbrotli-devel
	libgif-devel
	libgtest-devel
	libhwy-devel
	libjpeg-devel
	libopenexr-devel
	libpng-devel
	libwebp-devel
"

export CPPFLAGS="${CPPFLAGS} -D_GNU_SOURCE"
# gcc keeps the stack only 16-byte aligned here, yet spills Highway's
# AVX2/AVX-512 vectors with aligned moves (cjxl crashed in
# N_AVX3_DL::HistogramDistance); have the assembler make them unaligned
export CFLAGS="${CFLAGS} -Wa,-muse-unaligned-vector-move"
export CXXFLAGS="${CXXFLAGS} -Wa,-muse-unaligned-vector-move"

CYGPORT_USE_UNSTABLE_API=1
src_unpack_hook()
{
	cd ${origsrcdir}/${SRC_DIR}
	verbose rmdir testdata third_party/sjpeg third_party/skcms
	verbose mv ${origsrcdir}/testdata-${TESTDATA_REV} testdata
	verbose mv ${origsrcdir}/sjpeg-${SJPEG_REV} third_party/sjpeg
	verbose mv ${origsrcdir}/skcms-${SKCMS_REV} third_party/skcms
}

inherit cmake

CYGCMAKE_ARGS="
	-DBUILD_TESTING:BOOL=ON
	-DCMAKE_GTEST_DISCOVER_TESTS_DISCOVERY_MODE:STRING=PRE_TEST
	-DJPEGXL_ENABLE_DOXYGEN:BOOL=OFF
	-DJPEGXL_FORCE_SYSTEM_BROTLI:BOOL=ON
	-DJPEGXL_FORCE_SYSTEM_GTEST:BOOL=ON
	-DJPEGXL_FORCE_SYSTEM_LCMS2:BOOL=ON
	-DJPEGXL_FORCE_SYSTEM_HWY:BOOL=ON
	-DJPEGXL_ENABLE_TCMALLOC:BOOL=OFF
"

# the tests take about 21 minutes on the runner
YACP_CHECK_TIMEOUT_MINUTES=30

src_test() {
	cd ${B}
	PATH=${B}/lib:${PATH} ninja_test
}

DOCS="
	CHANGELOG.md
	PATENTS
"

PKG_NAMES="
	libjxl
	libjxl${PV[1]}.${PV[2]}
	libjxl-devel
"
libjxl_CONTENTS="
	usr/bin/*.exe
	usr/share
"
libjxl0_13_CONTENTS="
	usr/bin/cyg*-${PV[1]}.${PV[2]}.dll
"
libjxl_devel_CONTENTS="
	usr/include
	usr/lib
"
libjxl_SUMMARY="${SUMMARY} (utilities)"
libjxl0_13_SUMMARY="${SUMMARY} (runtime)"
libjxl_devel_SUMMARY="${SUMMARY} (development)"
