HOMEPAGE="https://github.com/libyal/${PN}"
SRC_URI="https://github.com/libyal/${PN}/archive/refs/tags/${PV}.tar.gz"

CATEGORY="Libs"
SUMMARY="Library and tools to access the Microsoft Internet Explorer (MSIE) Cache File (index.dat) files"
DESCRIPTION="libmsiecf is a library to access the Microsoft Internet Explorer (MSIE) Cache
File (index.dat) files."

LICENSE="LGPL-3.0-or-later"
LICENSE_SPDX="SPDX-License-Identifier: LGPL-3.0-or-later"
LICENSE_URI="COPYING.LESSER"

CYGPORT_USE_UNSTABLE_API=1
src_patch_hook()
{
	cd ${origsrcdir}/${SRC_DIR}
	chmod u+x tests/*.{py,sh}
}

BUILD_REQUIRES="
	gettext-devel
	libbfio-devel
	libcdata-devel
	libcerror-devel
	libcfile-devel
	libclocale-devel
	libcnotify-devel
	libcpath-devel
	libcsplit-devel
	libcthreads-devel
	libfdatetime-devel
	libfguid-devel
	libfole-devel
	libfvalue-devel
	libuna-devel
	python3-devel
"

CYGCONF_ARGS="
	--enable-python
"

src_test()
{
	cd ${B}
	pushd tests
		for f in ${S}/tests/*.{py,sh}
		do
			cp -f ${f} .
		done
		cp -f ${B}/pymsiecf/.libs/pymsiecf.dll .
	popd
	CHECK_WITH_STDERR=1 PYTHON=python3 PATH=${B}/${PN}/.libs:${B}/pymsiecf/.libs:${PATH} cygtest
	rm -f tests/*.{py,sh} tests/pymsiecf.dll
}

DOCS="
	COPYING.LESSER
"

PKG_NAMES="
	${PN}
	${PN}1
	${PN}-devel
	python312-${PN}
"
libmsiecf_CONTENTS="
	usr/bin/*.exe
	usr/share/doc
	usr/share/man/man1
"
libmsiecf1_CONTENTS="
	usr/bin/cyg*-1.dll
"
libmsiecf_devel_CONTENTS="
	usr/include
	usr/lib/lib*.dll.a
	usr/lib/pkgconfig
	usr/share/man/man3
"
python312_libmsiecf_CONTENTS="
	usr/lib/python3.12
"
libmsiecf_SUMMARY="${SUMMARY} (utilities)"
libmsiecf1_SUMMARY="${SUMMARY} (runtime)"
libmsiecf_devel_SUMMARY="${SUMMARY} (development)"
python312_libmsiecf_SUMMARY="${SUMMARY} (python312 bindings)"
