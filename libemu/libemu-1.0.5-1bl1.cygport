HOMEPAGE="https://github.com/buffer/${PN}"
SRC_URI="https://github.com/buffer/${PN}/archive/refs/tags/v${PV}.tar.gz"

CATEGORY="Libs"
SUMMARY="X86 emulation and shellcode detection"
DESCRIPTION="${SUMMARY}"

LICENSE="GPL-2.0-or-later"
LICENSE_SPDX="SPDX-License-Identifier: GPL-2.0-or-later"

CYGPORT_USE_UNSTABLE_API=1
src_patch_hook()
{
	cd ${origsrcdir}/${SRC_DIR}
	verbose sed -i -e "s/\[0\.2\.0\]/[${PV}]/" configure.ac
}

src_test()
{
	cd ${B}/testsuite
	export PATH=${B}/src/.libs:${PATH}
	verbose ./testsuite.exe
}

PKG_NAMES="
	${PN}
	${PN}2
	${PN}-devel
"
libemu_CONTENTS="
	usr/bin/*.exe
	usr/share/doc
"
libemu2_CONTENTS="
	usr/bin/cygemu-2.dll
"
libemu_devel_CONTENTS="
	usr/include
	usr/lib
	usr/share/man/man3
"
libemu_SUMMARY="${SUMMARY} (utilities)"
libemu2_SUMMARY="${SUMMARY} (runtime)"
libemu_devel_SUMMARY="${SUMMARY} (development)"
