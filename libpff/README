  /usr/share/man/man1/pffinfo.1.gz

(libpff1)
  /usr/bin/cygpff-1.dll

(libpff-devel)
  /usr/include/libpff.h
  /usr/include/libpff/codepage.h
  /usr/include/libpff/definitions.h
