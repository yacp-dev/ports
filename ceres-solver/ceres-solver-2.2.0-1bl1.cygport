HOMEPAGE="https://github.com/ceres-solver/${PN}"
SRC_URI="https://github.com/ceres-solver/${PN}/archive/refs/tags/${PV}.tar.gz"

CATEGORY="Math"
SUMMARY="Nonlinear Least Squares Minimizer"
DESCRIPTION="Solving nonlinear least squares problems comes up in a broad range of areas
across science and engineering - from fitting curves in statistics, to
constructing 3D models from photographs in computer vision. Ceres Solver is a
portable C++ library that allows for modeling and solving large complicated
nonlinear least squares problems."

LICENSE="BSD-3-Clause AND Apache-2.0"
LICENSE_SPDX="SPDX-License-Identifier: BSD-3-Clause AND Apache-2.0"
LICENSE_URI="LICENSE"

BUILD_REQUIRES="
	eigen3
	libcholmod-devel
	libcxsparse-devel
	libgflags-devel
	libglog-devel
	liblapack-devel
	libspqr-devel
	libsuitesparseconfig-devel
"

CYGCMAKE_ARGS="
	-DBUILD_SHARED_LIBS:BOOL=ON
"

inherit cmake

src_test()
{
	cd ${B}
	ctest
}

PKG_NAMES="
	${PN}
	libceres4
	libceres-devel
"
ceres_solver_CONTENTS="
	usr/share
"
libceres4_CONTENTS="
	usr/bin/cyg*-4.dll
"
libceres_devel_CONTENTS="
	usr/include
	usr/lib
"
ceres_solver_SUMMARY="${SUMMARY} (licensing & readmes)"
libceres4_SUMMARY="${SUMMARY} (runtime)"
libceres_devel_SUMMARY="${SUMMARY} (development)"
