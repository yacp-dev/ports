HOMEPAGE="https://github.com/lightvector/KataGo"
SRC_URI="
	https://github.com/lightvector/KataGo/archive/refs/tags/v${PV}.tar.gz
"
SRC_DIR="KataGo-${PV}"

CATEGORY="Science"
SUMMARY="GTP engine and self-play learning in Go"
DESCRIPTION="KataGo has begun its first public distributed training run! See
https://katagotraining.org/ for more details, to download the latest and
strongest neural nets, or to learn how to contribute if you want to help
KataGo improve further!"

LICENSE="MIT AND Apache-2.0 AND BSD-3-Clause AND CC0-1.0"
LICENSE_SPDX="SPDX-License-Identifier: MIT AND Apache-2.0 AND BSD-3-Clause AND CC0-1.0"
LICENSE_URI="LICENSE"

BUILD_REQUIRES="
	libOpenCL-devel
	libzip-devel
	zlib-devel
"

inherit cmake

CYGCMAKE_ARGS="
	-DUSE_BACKEND:STRING=OPENCL
	-DNO_GIT_REVISION:BOOL=ON
"

src_compile()
{
	CYGCMAKE_SOURCE=${S}/cpp
	cd ${B}
	: ${CYGCMAKE_GENERATOR=Ninja}
	cygcmake
	cygninja
}

src_test()
{
	cd ${B}
	./katago version
	./katago runtests
}

src_install()
{
	cd ${B}
	dobin katago.exe

	cd ${S}/cpp
	mkdir -p ${D}/usr/share/${PN}
	cp -R configs ${D}/usr/share/${PN}

	verbose install -Dm644 ${S}/cpp/external/clblast/LICENSE \
		${D}/usr/share/doc/${PN}/LICENSE.clblast
}
