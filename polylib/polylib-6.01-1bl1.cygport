HOMEPAGE="https://icps.u-strasbg.fr/${PN}/"
SRC_URI="https://icps.u-strasbg.fr/${PN}/${PN}_src/${P}.tar.gz"
PATCH_URI="
	https://sources.debian.org/data/main/p/polylib/6.01+dfsg-2/debian/patches/eliminate-first-variables.patch
	https://aur.archlinux.org/cgit/aur.git/plain/fix-tests.patch?h=polylib&id=0526c55ab3c17ca73878c03aa493a02ea11f8ffc
"

CATEGORY="Libs"
SUMMARY="Library of polyhedral functions"
DESCRIPTION="The Polyhedral Library (PolyLib for short) operates on objects made up of
unions of polyhedra of any dimension."

LICENSE="MIT"
LICENSE_SPDX="SPDX-License-Identifier: MIT"
LICENSE_URI="COPYING"

BUILD_REQUIRES="
	libgmp-devel
"

CYGCONF_ARGS="
	--with-libgmp
"

DOCS="
	doc/Changes
	doc/*.gz
"

DIFF_EXCLUDES="
	polylib.h
"

PKG_NAMES="
	${PN}
	lib${PN}gmp10
	lib${PN}gmp-devel
"
polylib_CONTENTS="
	usr/bin/*.exe
	usr/share
"
libpolylibgmp10_CONTENTS="
	usr/bin/cyg*-10.dll
"
libpolylibgmp_devel_CONTENTS="
	usr/include
	usr/lib
"
polylib_SUMMARY="${SUMMARY} (utilities)"
libpolylibgmp10_SUMMARY="${SUMMARY} (runtime)"
libpolylibgmp_devel_SUMMARY="${SUMMARY} (development)"
