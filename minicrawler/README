  cygwin-3.6.12-1
  libcares2-1.34.9-1
  libgcc1-14.4.0-1
  libiconv2-1.19-2
  libicu76-76.1-2
  libminicrawler-url5-devel-5.2.7-1bl1
  libminicrawler-url5_5-5.2.7-1bl1
  libminicrawler5-devel-5.2.7-1bl1
  libminicrawler5_5-5.2.7-1bl1
  libnghttp2_14-1.69.0-1
  libssl3-3.5.9-1
  libstdc++6-14.4.0-1
  libtpl0-1.6.1-1bl2
