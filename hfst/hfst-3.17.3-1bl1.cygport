HOMEPAGE="https://github.com/${PN}/${PN}"
SRC_URI="https://github.com/${PN}/${PN}/archive/refs/tags/v${PV}.tar.gz"

CATEGORY="Libs"
SUMMARY="Helsinki Finite-State Technology (library and application suite)"
DESCRIPTION="This package contains a bridging library for multiple FST libraries and
toolkits and set of tools for processing of finite-state automate especially
for linguistic systems."

LICENSE="Apache-2.0 AND GPL-2.0-or-later AND GPL-3.0-or-later AND LGPL-3.0-or-later"
LICENSE_SPDX="SPDX-License-Identifier: Apache-2.0 AND GPL-2.0-or-later AND GPL-3.0-or-later AND LGPL-3.0-or-later"
LICENSE_URI="COPYING"

BUILD_REQUIRES="
	bison
	flex
	libfoma-devel
	libfst-devel
	libicu-devel
	libreadline-devel
	python3-devel
	zlib-devel
"

export CPPFLAGS="${CPPFLAGS} -D_GNU_SOURCE"

CYGCONF_ARGS="
	--disable-python-bindings
	--enable-expand-equivalences
	--enable-proc
	--enable-shuffle
	--enable-tagger
	--enable-train-tagger
	--enable-traverse
	--enable-twolc-script
	--with-readline
	--without-c++11
"

src_test()
{
	cd ${B}
	cygmake check
}

DIFF_EXCLUDES="
	*.hfst
	*.lo
	*.Po
	*.Plo
"

PKG_NAMES="
	${PN}
	lib${PN}57
	lib${PN}-devel
	lib${PN}_c57
	lib${PN}_c-devel
	python312-${PN}
"
hfst_CONTENTS="
	usr/bin/h*
	usr/share
"
libhfst57_CONTENTS="
	usr/bin/cyghfst-57.dll
"
libhfst_devel_CONTENTS="
	usr/include/hfst/[A-Zhips]*
	usr/lib/libhfst.dll.a
	usr/lib/pkgconfig/hfst.pc
"
libhfst_c57_CONTENTS="
	usr/bin/cyghfst_c-57.dll
"
libhfst_c_devel_CONTENTS="
	usr/include/hfst/libhfst_c.h
	usr/lib/libhfst_c.dll.a
	usr/lib/pkgconfig/hfst_c.pc
"
python312_hfst_CONTENTS="
	usr/lib/python3.12
"
hfst_SUMMARY="${SUMMARY} (utilities)"
libhfst57_SUMMARY="${SUMMARY} (runtime)"
libhfst_devel_SUMMARY="${SUMMARY} (development)"
libhfst_c57_SUMMARY="${SUMMARY} (runtime / c)"
libhfst_c_devel_SUMMARY="${SUMMARY} (development / c)"
python312_hfst_SUMMARY="${SUMMARY} (python312 bindings)"
