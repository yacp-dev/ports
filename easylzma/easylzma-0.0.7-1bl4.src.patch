--- origsrc/easylzma-0.0.7/CMakeLists.txt	2009-02-24 21:32:36.000000000 +0000
+++ src/easylzma-0.0.7/CMakeLists.txt	2026-11-28 13:04:24.326897100 +0000
@@ -52,3 +52,20 @@ ENDIF (WIN32)
 ADD_SUBDIRECTORY(src)
 ADD_SUBDIRECTORY(elzma)
 ADD_SUBDIRECTORY(test)
+
+include(GNUInstallDirs)
+file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/easylzma.pc"
+"prefix=${CMAKE_INSTALL_PREFIX}
+exec_prefix=\${prefix}
+libdir=\${exec_prefix}/${CMAKE_INSTALL_LIBDIR}
+includedir=\${prefix}/${CMAKE_INSTALL_INCLUDEDIR}
+
+Name: easylzma
+Description: C library and command line tools for LZMA compression and decompression
+Version: ${EASYLZMA_MAJOR}.${EASYLZMA_MINOR}.${EASYLZMA_MICRO}
+Libs: -L\${libdir} -leasylzma
+Cflags: -I\${includedir}
+")
+install(FILES "${CMAKE_CURRENT_BINARY_DIR}/easylzma.pc"
+        DESTINATION ${CMAKE_INSTALL_LIBDIR}/pkgconfig)
+
