HOMEPAGE="https://github.com/kumaran-14/${PN}"
SRC_URI="https://github.com/kumaran-14/${PN}/archive/refs/tags/${PV}.tar.gz"

CATEGORY="Games"
SUMMARY="Classic ping-pong game written in c++17 and played in terminal"
DESCRIPTION="${SUMMARY}"

LICENSE="LicenseRef-terminal-pong"
LICENSE_SPDX="SPDX-License-Identifier: LicenseRef-terminal-pong"

BUILD_REQUIRES="
	libncurses-devel
"

inherit cmake

src_test()
{
	cd ${B}
	verbose ./pong.exe --version
}

src_install()
{
	cd ${B}
	dobin pong.exe
}
