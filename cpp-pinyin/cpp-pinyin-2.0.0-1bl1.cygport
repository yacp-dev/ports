HOMEPAGE="https://github.com/wolfgitpr/${PN}"
SRC_URI="https://github.com/wolfgitpr/${PN}/archive/refs/tags/v${PV}.tar.gz"

CATEGORY="Libs"
SUMMARY="Lightweight Chinese/Cantonese to Pinyin library"
DESCRIPTION="cpp-pinyin is a lightweight Chinese/Cantonese to Pinyin library."

LICENSE="Apache-2.0 AND CC-BY-SA-4.0 AND CC-BY-SA-3.0"
LICENSE_SPDX="SPDX-License-Identifier: Apache-2.0 AND CC-BY-SA-4.0 AND CC-BY-SA-3.0"
LICENSE_URI="LICENSE"

BUILD_REQUIRES="
	git
	python3
"

DIFF_EXCLUDES="version.props"

inherit cmake

export CPPFLAGS="${CPPFLAGS} -D_GNU_SOURCE"

CYGCMAKE_ARGS="
	-DCPP_PINYIN2_BUILD_TESTS=ON
"

src_test()
{
	cd ${B}
	export PATH=${B}/bin:${PATH}
	cat > ${T}/probe.cpp <<'PROBE'
#include <cpp-pinyin2/dialects/ManTone.h>
#include <cstdio>
using cpp_pinyin::v2::ManTone;
#define STEP(x) do { std::fprintf(stderr, "step %s\n", #x); std::fflush(stderr); auto r = (x); std::fprintf(stderr, "  ok len=%zu\n", r.size()); } while (0)
#include <string>
int main(int argc, char **argv) {
	for (const char *o = argv[1]; *o; ++o) {
		std::fprintf(stderr, "op %c\n", *o); std::fflush(stderr);
		std::u16string r;
		switch (*o) {
		case 'i': r = ManTone::toneToInitials(u"zhong", false, false); break;
		case 'f': r = ManTone::toneToFinals(u"zhong", false, false); break;
		case 'y': r = ManTone::toneToInitials(u"y\u012b", false, false); break;
		case 'g': r = ManTone::toneToFinals(u"gu\u012b", false, false); break;
		case 'n': r = ManTone::toneToInitials(u"\u0144", false, false); break;
		case 'z': r = ManTone::toneToInitials(u"", false, false); break;
		}
	}
	return 0;
}
PROBE
	cat > ${T}/probe2.cpp <<'PROBE2'
#include <cpp-pinyin2/dialects/ManTone.h>
#include <cstdio>
int main() {
	std::u16string r = cpp_pinyin::v2::ManTone::toneToInitials(u"y", false, false);
	std::fprintf(stderr, "got len=%zu\n", r.size());
	return 0;
}
PROBE2
	cat > ${T}/lib4.cpp <<'L4'
#include <string>
#define EXP __declspec(dllexport)
EXP std::u16string f_empty() { return {}; }
EXP std::u16string f_nonempty() { return std::u16string(u"zh"); }
EXP std::u16string f_ctor() { return std::u16string(); }
EXP std::string g_empty() { return {}; }
EXP std::wstring w_empty() { return {}; }
L4
	cat > ${T}/exe4.cpp <<'E4'
#include <string>
#include <cstdio>
#define IMP __declspec(dllimport)
IMP std::u16string f_empty();
IMP std::u16string f_nonempty();
IMP std::u16string f_ctor();
IMP std::string g_empty();
IMP std::wstring w_empty();
int main(int, char **argv) {
	std::fprintf(stderr, "mode %s\n", argv[1]);
	switch (argv[1][0]) {
	case 'e': { auto r = f_empty(); std::fprintf(stderr, "len %zu\n", r.size()); } break;
	case 'n': { auto r = f_nonempty(); std::fprintf(stderr, "len %zu\n", r.size()); } break;
	case 'c': { auto r = f_ctor(); std::fprintf(stderr, "len %zu\n", r.size()); } break;
	case 's': { auto r = g_empty(); std::fprintf(stderr, "len %zu\n", r.size()); } break;
	case 'w': { auto r = w_empty(); std::fprintf(stderr, "len %zu\n", r.size()); } break;
	case 'l': { auto *r = new std::u16string(f_empty()); std::fprintf(stderr, "leak len %zu\n", r->size()); } break;
	}
	std::fprintf(stderr, "end of scope\n");
	return 0;
}
E4
	g++ --version | head -1
	g++ -O2 -S ${T}/lib4.cpp -o - 2>&1 | grep -A22 "^_Z7f_emptyv:" | head -40
	g++ -O2 -S ${T}/exe4.cpp -o - 2>&1 | grep -B2 -A12 "_Z7f_emptyv" | head -60
	for fl in "-O2" "-O0" "-O2 -fno-stack-protector"
	do
	for ef in "-O2" "-O0" "-O2 -fno-stack-protector"
	do
		g++ $fl -shared ${T}/lib4.cpp -o ${T}/cyglib4.dll -Wl,--out-implib,${T}/liblib4.dll.a 2>&1 | tail -5
		g++ $ef ${T}/exe4.cpp -o ${T}/e4.exe ${T}/liblib4.dll.a 2>&1 | tail -5
		PATH=${T}:${PATH} ${T}/e4.exe e 2>&1 | tail -1
		echo "DIAG dll[$fl] exe[$ef] exit ${PIPESTATUS[0]}"
	done
	done
	ninja_test
}

PKG_NAMES="
	cpp-pinyin
	libcpp-pinyin2_2
	libcpp-pinyin2-devel
"
cpp_pinyin_CONTENTS="
	usr/share
"
libcpp_pinyin2_2_CONTENTS="
	usr/bin/cygcpp-pinyin2-2.dll
"
libcpp_pinyin2_devel_CONTENTS="
	usr/include
	usr/lib
"
cpp_pinyin_SUMMARY="${SUMMARY} (licensing & readmes)"
libcpp_pinyin2_2_SUMMARY="${SUMMARY} (runtime)"
libcpp_pinyin2_devel_SUMMARY="${SUMMARY} (development)"
