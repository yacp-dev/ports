HOMEPAGE="https://github.com/rscada/${PN}"
SRC_URI="https://github.com/rscada/${PN}/archive/refs/tags/${PV}.tar.gz"

CATEGORY="Libs"
SUMMARY="Meter-bus library and utility programs"
DESCRIPTION="libmbus is an open source library for the M-bus (Meter-Bus) protocol."

LICENSE="BSD-3-Clause"
LICENSE_SPDX="SPDX-License-Identifier: BSD-3-Clause"
LICENSE_URI="LICENSE"

DIFF_EXCLUDES="
	test
"

PKG_NAMES="
	libmbus
	libmbus0
	libmbus-devel
"
libmbus_CONTENTS="
	usr/bin/*.exe
	usr/share
"
libmbus0_CONTENTS="
	usr/bin/cyg*-0.dll
"
libmbus_devel_CONTENTS="
	usr/include
	usr/lib
"
libmbus_SUMMARY="${SUMMARY} (utilities)"
libmbus0_SUMMARY="${SUMMARY} (runtime)"
libmbus_devel_SUMMARY="${SUMMARY} (development)"

src_test() {
	cd ${B}
	verbose make -C test LDFLAGS="-L${B}/mbus/.libs" mbus_parse_hex.exe
	export PATH=${B}/mbus/.libs:${PATH}
	cd ${S}/test
	verbose sh generate-xml.sh test-frames ${B}/test/mbus_parse_hex.exe
}
