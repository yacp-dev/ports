HOMEPAGE="https://github.com/reo7sp/${PN}"
SRC_URI="https://github.com/reo7sp/${PN}/archive/refs/tags/v${PV}.tar.gz"

CATEGORY="Libs"
SUMMARY="C++ library for Telegram bot API"
DESCRIPTION="${SUMMARY}"

LICENSE="MIT"
LICENSE_SPDX="SPDX-License-Identifier: MIT"
LICENSE_URI="LICENSE"

BUILD_REQUIRES="
	libboost-devel
	libcurl-devel
	libgtest-devel
	nlohmann_json
"

export CPPFLAGS="${CPPFLAGS} -D_GNU_SOURCE"

inherit cmake

src_test()
{
	cd ${B}
	PATH=${B}:${PATH} ninja_test
}

CYGCMAKE_ARGS="
	-DBUILD_SHARED_LIBS:BOOL=ON
	-DCMAKE_GTEST_DISCOVER_TESTS_DISCOVERY_MODE:STRING=PRE_TEST
	-DENABLE_TESTS:BOOL=ON
	-DVERSION:STRING=${PV}
"

PKG_NAMES="
	tgbot-cpp
	libTgBot${PV}
	libTgBot-devel
"
tgbot_cpp_CONTENTS="
	usr/share
"
libTgBot1_13_CONTENTS="
	usr/bin/cygTgBot-${PV}.dll
"
libTgBot_devel_CONTENTS="
	usr/include
	usr/lib
"
tgbot_cpp_SUMMARY="${SUMMARY} (licensing & readmes)"
libTgBot1_13_SUMMARY="${SUMMARY} (runtime)"
libTgBot_devel_SUMMARY="${SUMMARY} (development)"
