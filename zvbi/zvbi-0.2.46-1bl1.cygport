HOMEPAGE="https://github.com/zapping-vbi/${PN}/"
SRC_URI="https://github.com/zapping-vbi/${PN}/archive/refs/tags/v${PV}.tar.gz"
PATCH_URI="
	https://sources.debian.org/data/main/${PN:0:1}/${PN}/${PV}-1/debian/patches/disable-test-pdc-on-debian.patch
	https://src.fedoraproject.org/rpms/${PN}/raw/248fd3065aa8d1657ed23b425d8648d0acefffd4/f/${PN}-0.2.24-tvfonts.patch
	https://src.fedoraproject.org/rpms/${PN}/raw/248fd3065aa8d1657ed23b425d8648d0acefffd4/f/${PN}-0.2.25-openfix.patch
"

CATEGORY="Libs"
SUMMARY="Raw VBI, Teletext and Closed Caption decoding library"
DESCRIPTION="ZVBI provides functions to capture and decode VBI data. The vertical blanking
interval (VBI) is an interval in a television signal that temporarily suspends
transmission of the signal for the electron gun to move back up to the first
line of the television screen to trace the next screen field. The vertical
blanking interval can be used to carry data, since anything sent during the VBI
would naturally not be displayed; various test signals, closed captioning, and
other digital data can be sent during this time period."

LICENSE="GPL-2.0-or-later AND GPL-2.0-only AND LGPL-2.0-or-later AND MIT"
LICENSE_SPDX="SPDX-License-Identifier: GPL-2.0-or-later AND GPL-2.0-only AND LGPL-2.0-or-later AND MIT"
LICENSE_URI="COPYING.md"

BUILD_REQUIRES="
	gettext-devel
	libiconv-devel
	libintl-devel
	libpng-devel
	libX11-devel
	zlib-devel
"

CYGCONF_ARGS="
	--enable-maintainer-mode
"

# The .src.patch touches src/Makefile.am, which makes make regenerate
# network-table.h by downloading networks.xml with wget. Keep the shipped one.
src_compile() {
	cd ${S}
	cygautoreconf
	lndirs
	cd ${B}
	cygconf
	touch ${S}/src/network-table.h
	cygmake
}

DIFF_EXCLUDES="
	_videodev.h
	_videodev2.h
	_videodev2k.h
	*.po
	stamp-po
	zvbi.pot
"

PKG_NAMES="
	${PN}
	lib${PN}0
	lib${PN}-devel
"
zvbi_CONTENTS="
	usr/bin/*.exe
	usr/share/doc
	usr/share/man
"
libzvbi0_CONTENTS="
	usr/bin/cyg*-0.dll
	usr/share/locale
"
libzvbi_devel_CONTENTS="
	usr/include
	usr/lib
"
zvbi_SUMMARY="${SUMMARY} (utilities)"
libzvbi0_SUMMARY="${SUMMARY} (runtime)"
libzvbi_devel_SUMMARY="${SUMMARY} (development)"
