     const char *sym = janet_getcstring(argv, 1);
     if (anative->closed) janet_panic("native object already closed");
+#ifdef __CYGWIN__
+    /* dlopen(NULL) on Cygwin only covers the executable itself */
+    void *value = anative->is_self ? dlsym(RTLD_DEFAULT, sym) : symbol_clib(anative->clib, sym);
