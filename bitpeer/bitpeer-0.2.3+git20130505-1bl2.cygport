HOMEPAGE="https://github.com/TvdW/${PN}"
GIT_URI="https://github.com/TvdW/${PN}.git"
GIT_REV="ebb0c96faf39a821ca2075afc0593af535893ade"

CATEGORY="Net"
SUMMARY="Experimental Bitcoin relay server"
DESCRIPTION="Bitpeer is an experimental Bitcoin relay server. Its event-driven
architecture makes it extremely fast, and it was designed to be very
lightweight."

LICENSE="BSD-3-Clause"
LICENSE_SPDX="SPDX-License-Identifier: BSD-3-Clause"
LICENSE_URI="LICENSE.txt"

BUILD_REQUIRES="
	libevent-devel
	libssl-devel
"

inherit git

src_test()
{
	cd ${B}
	# upstream has no tests: check that the program starts
	# (without arguments it prints its usage and exits with 1;
	# HOME is redirected because it creates ~/.bitpeer first)
	local rc=0 out
	out=$(HOME=${B} ./${PN}.exe 2>&1) || rc=$?
	echo "${out}"
	[ ${rc} -eq 1 ] && echo "${out}" | grep -q '^Usage:'
}
