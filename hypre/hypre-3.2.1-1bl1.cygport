HOMEPAGE="https://github.com/hypre-space/${PN}"
SRC_URI="https://github.com/hypre-space/${PN}/archive/refs/tags/v${PV}.tar.gz"

CATEGORY="Libs"
SUMMARY="Parallel solvers for sparse linear systems featuring multigrid methods"
DESCRIPTION="HYPRE is a library of high performance preconditioners and solvers featuring
multigrid methods for the solution of large, sparse linear systems of
equations on massively parallel computers."

LICENSE="(Apache-2.0 OR MIT) AND BSD-3-Clause"
LICENSE_SPDX="SPDX-License-Identifier: (Apache-2.0 OR MIT) AND BSD-3-Clause"
LICENSE_URI="COPYRIGHT"

BUILD_REQUIRES="
	libevent-devel
	libhwloc-devel
	libopenmpi-devel
	zlib-devel
"

inherit cmake

# The CI runner has fewer cores than the tests request MPI ranks
export OMPI_MCA_rmaps_base_oversubscribe=1

src_compile()
{
	CYGCMAKE_SOURCE=${S}/src
	cd ${B}
	: ${CYGCMAKE_GENERATOR=Ninja}
	cygcmake
	cygninja
}

src_test()
{
	cd ${B}
	PATH=${B}/bin:${PATH} ctest
}

CYGCMAKE_ARGS="
	-DBUILD_SHARED_LIBS:BOOL=ON
	-DCMAKE_INSTALL_INCLUDEDIR:STRING=/usr/include/${PN}
	-DHYPRE_ENABLE_BIGINT:BOOL=ON
	-DHYPRE_ENABLE_MIXEDINT:BOOL=ON
	-DHYPRE_ENABLE_PERSISTENT_COMM:BOOL=ON
	-DHYPRE_BUILD_TESTS:BOOL=ON
"

src_install()
{
	cd ${B}
	ninja_install

	cd ${D}
	pushd usr/bin
		for exe in *.exe
		do
			verbose mv ${exe} hypre-${exe}
		done
	popd
}

DOCS="
	CHANGELOG
	LICENSE-*
	NOTICE
	SUPPORT.md
"

DIFF_EXCLUDES="
	test
	*.c
"

PKG_NAMES="
	hypre
	libHYPRE302
	libHYPRE-devel
"
hypre_CONTENTS="
	usr/bin/hypre-*.exe
	usr/share
"
libHYPRE302_CONTENTS="
	usr/bin/cyg*-302.dll
"
libHYPRE_devel_CONTENTS="
	usr/include
	usr/lib
"
hypre_SUMMARY="${SUMMARY} (utilities)"
libHYPRE302_SUMMARY="${SUMMARY} (runtime)"
libHYPRE_devel_SUMMARY="${SUMMARY} (development)"
libHYPRE_devel_REQUIRES="
	libevent-devel
	libhwloc-devel
	libopenmpi-devel
	zlib-devel
"
