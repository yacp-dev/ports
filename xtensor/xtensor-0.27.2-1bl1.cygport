HOMEPAGE="https://github.com/xtensor-stack/${PN}"
SRC_URI="https://github.com/xtensor-stack/${PN}/archive/refs/tags/${PV}.tar.gz"

CATEGORY="Devel"
SUMMARY="C++ tensors with broadcasting and lazy computing"
DESCRIPTION="${SUMMARY}"

LICENSE="BSD-3-Clause"
LICENSE_SPDX="SPDX-License-Identifier: BSD-3-Clause"
LICENSE_URI="LICENSE"

BUILD_REQUIRES="
	doctest
	libbenchmark-devel
	nlohmann_json
	xsimd
	xtl
"

export CPPFLAGS="${CPPLFAGS} -D_GNU_SOURCE"

inherit cmake

# GCC can't realign the stack for 32/64-byte AVX2/AVX512 spills on x86_64
# Windows (GCC PR 54412), so vmovdqa to the stack faults in the tests built
# with -march=native; have the assembler emit unaligned moves instead.
CXXFLAGS+=" -Wa,-muse-unaligned-vector-move"

CYGCMAKE_ARGS="
	-DBUILD_BENCHMARK:BOOL=ON
	-DBUILD_TESTS:BOOL=ON
	-DDOWNLOAD_GBENCHMARK:BOOL=OFF
	-DXTENSOR_USE_OPENMP:BOOL=ON
	-DXTENSOR_USE_XSIMD:BOOL=ON
"

xtensor_REQUIRES="xsimd"
