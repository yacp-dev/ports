  /usr/share/man/man1/grail-test-atomic.1.gz
  /usr/share/man/man1/grail-test-edge.1.gz
  /usr/share/man/man1/grail-test-propagation.1.gz

(libgrail6)
  /usr/bin/cyggrail-6.dll

(libgrail-devel)
  /usr/include/oif/grail.h
  /usr/lib/libgrail.dll.a
  /usr/lib/pkgconfig/grail.pc

