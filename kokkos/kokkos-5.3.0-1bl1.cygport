HOMEPAGE="https://github.com/${PN}/${PN}"
SRC_URI="https://github.com/${PN}/${PN}/archive/refs/tags/${PV}.tar.gz"

CATEGORY="Libs"
SUMMARY="C++ Performance Portability Programming EcoSystem"
DESCRIPTION="Kokkos Core implements a programming model in C++ for writing performance
portable applications targeting all major HPC platforms. For that purpose it
provides abstractions for both parallel execution of code and data management.
Kokkos is designed to target complex node architectures with N-level memory
hierarchies and multiple types of execution resources. It currently can use
CUDA, HPX, OpenMP and Pthreads as backend programming models with several
other backends in development."

LICENSE="Apache-2.0 WITH LLVM-exception AND BSD-3-Clause"
LICENSE_SPDX="SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception AND BSD-3-Clause"
LICENSE_URI="LICENSE"

BUILD_REQUIRES="
	libgtest-devel
	libhwloc-devel
"

inherit cmake

CYGCMAKE_ARGS="
	-DBUILD_SHARED_LIBS:BOOL=ON
	-DCMAKE_INSTALL_INCLUDEDIR:STRING=/usr/include/kokkos
	-DKokkos_ENABLE_HWLOC:BOOL=ON
	-DKokkos_ENABLE_TESTS:BOOL=ON
"

src_test()
{
	cd ${B}
	PATH=${B}:${B}/bin:${B}/core/src:${B}/containers/src:${B}/core/unit_test:${PATH} ninja_test
}

src_install()
{
	cd ${B}
	ninja_install

	rm -rf ${D}/usr/lib/cmake/mdspan
}

DOCS="
	*.md
	docs/*.md
"

PKG_NAMES="
	kokkos
	libkokkos${PV[1]}.${PV[2]}
	libkokkos-devel
"
kokkos_CONTENTS="
	usr/bin/[hkn]*
	usr/share
"
libkokkos5_3_CONTENTS="
	usr/bin/cyg*-5.3.dll
"
libkokkos_devel_CONTENTS="
	usr/include
	usr/lib
"
kokkos_SUMMARY="${SUMMARY} (utilities)"
libkokkos5_3_SUMMARY="${SUMMARY} (runtime)"
libkokkos_devel_SUMMARY="${SUMMARY} (development)"

libkokkos_devel_REQUIRES="libhwloc-devel"
