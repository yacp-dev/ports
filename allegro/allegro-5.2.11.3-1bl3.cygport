HOMEPAGE="https://liballeg.org/"
SRC_URI="https://github.com/liballeg/${PN}5/releases/download/${PV}/${P}.7z"
PATCH_URI="
	allegro-5.2.11.3-interface-include-dirs.patch
"
SRC_DIR=${PN}

CATEGORY="Libs"
SUMMARY="Game programming library"
DESCRIPTION="Allegro is a cross-platform library mainly aimed at video game and multimedia
programming. It handles common, low-level tasks such as creating windows,
accepting user input, loading data, drawing images, playing sounds, etc. and
generally abstracting away the underlying platform. However, Allegro is not a
game engine: you are free to design and structure your program as you like."

LICENSE="Zlib AND BSD-3-Clause"
LICENSE_SPDX="SPDX-License-Identifier: Zlib AND BSD-3-Clause"
LICENSE_URI="LICENSE.txt"

BUILD_REQUIRES="
	flac-devel
	libdumb-devel
	libfreetype-devel
	libGL-devel
	libGLU-devel
	libglib2.0-devel
	libgtk3-devel
	libjpeg-devel
	libogg-devel
	libopenal-devel
	libopenmpt-devel
	libopusfile-devel
	libphysfs-devel
	libpng-devel
	libpulse-devel
	libtheora-devel
	libvorbis-devel
	libwebp-devel
	libX11-devel
	libXcursor-devel
	libXi-devel
	libXinerama-devel
	libXrandr-devel
	libXss-devel
	p7zip
"

inherit cmake

CYGCMAKE_ARGS="
	-DWANT_DOCS_HTML:BOOL=OFF
"

# test_driver: failed to create display
src_test()
{
	cd ${B}
	# PATH=${B}/lib:${PATH} cygninja run_tests
}

DOCS="
	CHANGES*.txt
	README*.txt
"

PKG_NAMES="
	${PN}
	lib${PN}${PV[1]}.${PV[2]}
	lib${PN}-devel
"
allegro_CONTENTS="
	usr/share
"
liballegro5_2_CONTENTS="
	usr/bin/cyg*-5.2.dll
"
liballegro_devel_CONTENTS="
	usr/include
	usr/lib
"
allegro_SUMMARY="${SUMMARY} (licensing & readmes)"
liballegro5_2_SUMMARY="${SUMMARY} (runtime)"
liballegro_devel_SUMMARY="${SUMMARY} (development)"
liballegro_devel_REQUIRES="
	flac-devel
	libdumb-devel
	libfreetype-devel
	libGLU-devel
	libjpeg-devel
	libopenal-devel
	libopenmpt-devel
	libopusfile-devel
	libphysfs-devel
	libtheora-devel
	libwebp-devel
	libXcursor-devel
	libXinerama-devel
	libXrandr-devel
	libXss-devel
"
