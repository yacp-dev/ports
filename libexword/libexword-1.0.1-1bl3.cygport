HOMEPAGE="https://github.com/brijohn/${PN}"
SRC_URI="https://github.com/brijohn/${PN}/archive/refs/tags/rel${PV}.tar.gz"
SRC_DIR="${PN}-rel${PV}"

CATEGORY="Libs"
SUMMARY="Library for transfering files over USB to casio EX-word electronic dictionaries"
DESCRIPTION="libexword is a library that implements the low-level OBEX commands used to
communicate Casio EX-word dictionaries."

LICENSE="GPL-2.0-or-later"
LICENSE_SPDX="SPDX-License-Identifier: GPL-2.0-or-later"
LICENSE_URI="https://www.gnu.org/licenses/old-licenses/gpl-2.0.txt"

BUILD_REQUIRES="
	libiconv-devel
	libreadline-devel
	libusb1.0-devel
"

DOCS="
	models.txt
	protocol.txt
"

# gcc 14 made implicit function declarations an error; the source relies on them
export CFLAGS="${CFLAGS} -Wno-error=implicit-function-declaration"

PKG_NAMES="
	${PN}
	${PN}1
	${PN}-devel
"
libexword_CONTENTS="
	usr/bin/*.exe
	usr/share
"
libexword1_CONTENTS="
	usr/bin/cyg*-1.dll
"
libexword_devel_CONTENTS="
	usr/include
	usr/lib
"
libexword_SUMMARY="${SUMMARY} (utilities)"
libexword1_SUMMARY="${SUMMARY} (runtime)"
libexword_devel_SUMMARY="${SUMMARY} (development)"

src_test() {
	# no upstream tests: check the interactive shell starts and exits
	cd ${B}/src
	export PATH=${B}/src/.libs:${PATH}
	verbose bash -c 'echo exit | timeout 60 ./exword.exe | grep -q "^Exword dictionary tool\."'
}

src_install() {
	cd ${B}
	cyginstall

	# upstream installs models.txt again, which DOCS already provides
	verbose rm -rf ${D}/usr/share/exword
}
