HOMEPAGE="https://github.com/jmcnamara/${PN}"
SRC_URI="https://github.com/jmcnamara/${PN}/archive/refs/tags/v${PV}.tar.gz"

CATEGORY="Libs"
SUMMARY="C library for creating Excel XLSX files"
DESCRIPTION="Libxlsxwriter is a C library that can be used to write text, numbers, formulas
and hyperlinks to multiple worksheets in an Excel 2007+ XLSX file."

LICENSE="BSD-2-Clause AND BSD-3-Clause AND Zlib"
LICENSE_SPDX="SPDX-License-Identifier: BSD-2-Clause AND BSD-3-Clause AND Zlib"
LICENSE_URI="License.txt"

BUILD_REQUIRES="
	libssl-devel
	python3-pytest
	zlib-devel
"

inherit cmake

CYGCMAKE_ARGS="
	-DBUILD_EXAMPLES:BOOL=ON
	-DBUILD_SHARED_LIBS:BOOL=ON
	-DBUILD_TESTS:BOOL=ON
	-DIOAPI_NO_64:BOOL=ON
	-DUSE_OPENSSL_MD5:BOOL=ON
	-DUSE_STANDARD_TMPFILE:BOOL=ON
"

src_test()
{
	cd ${B}
	# ctest runs plain "pytest", but python312-pytest installs only pytest-3.12
	mkdir -p ${T}/bin
	ln -sf /usr/bin/pytest-3.12 ${T}/bin/pytest
	PATH=${B}:${T}/bin:${PATH} ctest --output-on-failure
}

DOCS="
	License.txt
	Readme.md
"

PKG_NAMES="
	${PN}
	${PN}11
	${PN}-devel
"
libxlsxwriter_CONTENTS="
	usr/share
"
libxlsxwriter11_CONTENTS="
	usr/bin/cyg*-11.dll
"
libxlsxwriter_devel_CONTENTS="
	usr/include
	usr/lib
"
libxlsxwriter_SUMMARY="${SUMMARY} (licensing & readmes)"
libxlsxwriter11_SUMMARY="${SUMMARY} (runtime)"
libxlsxwriter_devel_SUMMARY="${SUMMARY} (development)"
