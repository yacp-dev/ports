+/* Cygwin: lib*.so can't be dlopen'ed, so link a test program against lib */
+
+static int _check_dynamic_lib(const char *lib,const char *func)
+{
+	string str;
+	FILE *fp;
+	int ret;
+
+	fp = fopen("build/conftest.c", "w");
+	if(!fp) return 0;
+
+	if(func)
+		fprintf(fp, "char %s(void);\nint main(void){ %s(); return 0; }\n", func, func);
+	else
+		fprintf(fp, "int main(void){ return 0; }\n");
+
+	fclose(fp);
+
+	if(str_alloc(&str)) return 0;
+
+	str_settext(&str, cc_str);
+	str_addtext(&str, " -o build/conftest build/conftest.c ");
