HOMEPAGE="https://github.com/sharkdp/${PN}"
SRC_URI="https://github.com/sharkdp/${PN}/archive/refs/tags/v${PV}.tar.gz"

CATEGORY="Utils"
SUMMARY="A cat(1) clone with wings"
DESCRIPTION="A cat(1) clone with syntax highlighting and Git integration."

LICENSE="Apache-2.0 OR MIT"
LICENSE_SPDX="SPDX-License-Identifier: Apache-2.0 OR MIT"
LICENSE_URI="LICENSE-MIT"

BUILD_REQUIRES="
	cargo
"

src_compile()
{
	:
}

# rustc forks to run the linker, which fails on CI when the proc-macro
# DLLs it has loaded share an address ("address space needed by ...
# is already occupied"). Give the DLLs the first pass built distinct
# bases and run cargo again; the second pass reuses what was built.
cargo_retry()
{
	"$@" || {
		find "${CARGO_TARGET_DIR}" -name '*.dll' > "${B}/dlls.txt"
		rebase -b 0x400000000 -T "${B}/dlls.txt"
		"$@"
	}
}

src_install()
{
	export CARGO_HOME="${B}/cargo-home"
	export CARGO_TARGET_DIR="${B}/cargo-target"

	cargo_retry cargo install \
		--path "${S}" \
		--root "${D}/usr" \
		--force \
		--no-track
}
