HOMEPAGE="https://github.com/cisco/${PN}"
SRC_URI="https://github.com/cisco/${PN}/archive/refs/tags/v${PV}.tar.gz"

CATEGORY="Libs"
SUMMARY="Client-side implementation of the draft ACVP protocol"
DESCRIPTION="${SUMMARY}"

LICENSE="Apache-2.0 AND BSD-2-Clause AND MIT AND Unlicense"
LICENSE_SPDX="SPDX-License-Identifier: Apache-2.0 AND BSD-2-Clause AND MIT AND Unlicense"
LICENSE_URI="LICENSE"

BUILD_REQUIRES="
	libcurl-devel
	libssl-devel
"

CYGCONF_ARGS="
	--enable-maintainer-mode
	--with-libcurl-dir=/usr
	--with-ssl-dir=/usr
	--enable-unit-tests
"

# upstream's tarball ships generated files; autoreconf recreates them
DIFF_EXCLUDES="
	Makefile.in
	aclocal.m4
	configure
"

PKG_NAMES="
	libacvp
	libacvp0
	libacvp-devel
"
libacvp_CONTENTS="
	usr/bin/*.exe
	usr/share
"
libacvp0_CONTENTS="
	usr/bin/cyg*-0.dll
"
libacvp_devel_CONTENTS="
	usr/include
	usr/lib
"
libacvp_SUMMARY="${SUMMARY} (utilities)"
libacvp0_SUMMARY="${SUMMARY} (runtime)"
libacvp_devel_SUMMARY="${SUMMARY} (development)"

# test/Makefile.am installs its headers into ${D} itself (runtestdir is empty)
src_install() {
	cd ${B}
	cyginstall
	rm -f ${D}/*.h
}

src_test() {
	# the tests open json/... relative to the working directory
	cd ${S}/test
	verbose ${B}/test/runtest
}
