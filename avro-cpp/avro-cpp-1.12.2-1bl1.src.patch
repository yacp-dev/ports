@@ -0,0 +1,10 @@
+prefix=@prefix@
+exec_prefix=@exec_prefix@
+libdir=@libdir@
+includedir=@includedir@
+
+Name: avro-cpp
+Description: Data serialization system (C++)
+Version: @AVRO_VERSION_MAJOR@.@AVRO_VERSION_MINOR@.@AVRO_VERSION_PATCH@
+Libs: -L${libdir} -lavrocpp
+Cflags: -I${includedir}
