HOMEPAGE="https://web.archive.org/web/20171202030104/http://gpe.linuxtogo.org/"
SRC_URI="https://mucross.com/downloads/tonga-demo/sources/GPL/libhandoff/${P}.tar.bz2"

CATEGORY="Libs"
SUMMARY="Facilitate limiting a program to a single instance per user"
DESCRIPTION="${SUMMARY}"

LICENSE="GPL-2.0-or-later"
LICENSE_SPDX="SPDX-License-Identifier: GPL-2.0-or-later"
LICENSE_URI="https://www.gnu.org/licenses/old-licenses/gpl-2.0.txt"

BUILD_REQUIRES="
	gtk-doc
	libglib2.0-devel
"

PKG_NAMES="
	${PN}
	${PN}0
	${PN}-devel
"
libhandoff_CONTENTS="
	usr/share
"
libhandoff0_CONTENTS="
	usr/bin/cyg*-0.dll
"
libhandoff_devel_CONTENTS="
	usr/include
	usr/lib
"

libhandoff_SUMMARY="${SUMMARY} (licensing & readmes)"
libhandoff0_SUMMARY="${SUMMARY} (runtime)"
libhandoff_devel_SUMMARY="${SUMMARY} (development)"
