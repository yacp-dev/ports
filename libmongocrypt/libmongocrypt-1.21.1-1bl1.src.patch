+#elif defined(__CYGWIN__)
+
+#include <errno.h>
+#include <stdlib.h>
+#include <sys/cygwin.h>
+#include <windows.h>
+
+mcr_dll_path_result mcr_dll_path(mcr_dll dll) {
+    // dlopen() returns the module handle on Cygwin
+    const DWORD size = 32768;
+    wchar_t *wpath = calloc(size, sizeof(wchar_t));
+    if (!wpath) {
+        return (mcr_dll_path_result){.error_string = mstr_copy_cstr(strerror(errno))};
+    }
+    DWORD len = GetModuleFileNameW((HMODULE)dll._native_handle, wpath, size);
+    if (len == 0 || len == size) {
+        free(wpath);
+        return (mcr_dll_path_result){.error_string = mstr_copy_cstr("GetModuleFileNameW() failed")};
+    }
+    char *path = cygwin_create_path(CCP_WIN_W_TO_POSIX, wpath);
+    free(wpath);
+    if (!path) {
+        return (mcr_dll_path_result){.error_string = mstr_copy_cstr(strerror(errno))};
+    }
+    mstr ret = mstr_copy_cstr(path);
+    free(path);
+    return (mcr_dll_path_result){.path = ret};
+}
+
+bool mcr_dll_path_supported(void) {
+    return true;
+}
+
