HOMEPAGE="https://seasip.info/Unix/Zxcc/"
SRC_URI="https://www.seasip.info/Unix/Zxcc/${P}.tar.gz"
PATCH_URI="
	https://raw.githubusercontent.com/pld-linux/zxcc/2046effb54da0b8025afed2b20d59c1f2d02124b/zxcc-system-libs.patch
"

CATEGORY="Utils"
SUMMARY="Two-purpose CP/M 2/3 emulator"
DESCRIPTION="ZXCC is a two-purpose CP/M 2/3 emulator."

LICENSE="GPL-2.0-or-later"
LICENSE_SPDX="SPDX-License-Identifier: GPL-2.0-or-later"
LICENSE_URI="COPYING"

BUILD_REQUIRES="
	libcpmio-devel
	libcpmredir-devel
"

CYGPORT_USE_UNSTABLE_API=1
src_patch_hook()
{
	cd ${origsrcdir}/${SRC_DIR}
	rm -f aclocal.m4 configure
	find . -name Makefile.in | xargs rm -f
}

CFLAGS+=" -std=gnu17"

CYGCONF_ARGS="
	--with-readline
"

src_test()
{
	cd ${B}/bin
	# upstream has no tests: check that zxcc starts, i.e. that
	# cygcpmio and cygcpmredir load (without arguments it says no
	# CP/M program was given and exits with 1)
	local rc=0 out
	out=$(./zxcc.exe 2>&1) || rc=$?
	echo "${out}"
	[ ${rc} -eq 1 ] && echo "${out}" | grep -q 'No CP/M program name provided'
}

KEEPDIRS="
	/usr/lib/cpm/include80
	/usr/lib/cpm/lib80
"
