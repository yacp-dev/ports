HOMEPAGE="https://www.${PN}.com/"
SRC_URI="https://github.com/xroche/${PN}/releases/download/${PV}/${PN}-${PV}.tar.gz"

CATEGORY="Net"
SUMMARY="HTTrack Website Copier, copy websites to your computer"
DESCRIPTION="HTTrack is an offline browser utility, allowing you to download a World Wide
website from the Internet to a local directory, building recursively all
directories, getting html, images, and other files from the server to your
computer."

LICENSE="GPL-3.0-or-later AND MPL-2.0 AND BSD-3-Clause"
LICENSE_SPDX="SPDX-License-Identifier: GPL-3.0-or-later AND MPL-2.0 AND BSD-3-Clause"
LICENSE_URI="COPYING"

BUILD_REQUIRES="
	autoconf-archive
	libbrotli-devel
	libiconv-devel
	libssl-devel
	libzstd-devel
	zlib-devel
"

export CPPFLAGS="${CPPFLAGS} -DIOAPI_NO_64"

CYGCONF_ARGS="
	--enable-maintainer-mode
"

PKG_NAMES="
	httrack
	libhttrack3
	libhttrack-devel
"
httrack_CONTENTS="
	etc
	usr/bin/*.exe
	usr/bin/w*
	usr/share
"
libhttrack3_CONTENTS="
	usr/bin/cyg*-3.dll
"
libhttrack_devel_CONTENTS="
	usr/include
	usr/lib
"
httrack_SUMMARY="${SUMMARY} (utilities)"
libhttrack3_SUMMARY="${SUMMARY} (runtime)"
libhttrack_devel_SUMMARY="${SUMMARY} (development)"
