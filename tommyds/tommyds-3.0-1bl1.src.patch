+prefix=@prefix@
+exec_prefix=@exec_prefix@
+libdir=@libdir@
+includedir=@includedir@
+
+Name: tommyds
+Description: C library of hashtables and tries designed to store objects with high performance
+Version: @PROJECT_VERSION@
+Libs: -L${libdir} -ltommyds
+Cflags: -I${includedir}
