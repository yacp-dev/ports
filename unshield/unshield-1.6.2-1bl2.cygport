HOMEPAGE="https://github.com/twogood/${PN}"
GIT_URI="https://github.com/twogood/${PN}.git"
GIT_TAG="${PV}"
PATCH_URI="
	https://sources.debian.org/data/main/u/unshield/1.6.2-2/debian/patches/gcc15.patch
	https://src.fedoraproject.org/rpms/unshield/raw/f76ee6f6981c203ca3f5cd7908cde912f363ca37/f/0001-Validate-the-file-table-against-the-header-size.patch
"

CATEGORY="Libs"
SUMMARY="Tool and library to extract CAB files from InstallShield installers"
DESCRIPTION="${SUMMARY}"

LICENSE="MIT"
LICENSE_SPDX="SPDX-License-Identifier: MIT"
LICENSE_URI="LICENSE"

BUILD_REQUIRES="
	libiconv-devel
	libssl-devel
	zlib-devel
"

inherit cmake
inherit git

src_test()
{
	cd ${B}
	PATH=${B}/lib:${PATH} ninja_test
}

PKG_NAMES="
	unshield
	libunshield1
	libunshield-devel
"
unshield_CONTENTS="
	usr/bin/*.exe
	usr/share
"
libunshield1_CONTENTS="
	usr/bin/cyg*-1.dll
"
libunshield_devel_CONTENTS="
	usr/include
	usr/lib
"
unshield_SUMMARY="${SUMMARY} (licensing & readmes)"
libunshield1_SUMMARY="${SUMMARY} (runtime)"
libunshield_devel_SUMMARY="${SUMMARY} (development)"

libunshield_devel_REQUIRES="unshield"
