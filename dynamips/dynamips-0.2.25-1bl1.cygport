HOMEPAGE="https://github.com/GNS3/${PN}"
SRC_URI="https://github.com/GNS3/${PN}/archive/refs/tags/v${PV}.tar.gz"

CATEGORY="Net"
SUMMARY="Cisco 7200/3600/3725/3745/2600/1700 Router Emulator"
DESCRIPTION="${SUMMARY}"

LICENSE="GPL-2.0-or-later"
LICENSE_SPDX="SPDX-License-Identifier: GPL-2.0-or-later"
LICENSE_URI="COPYING"

BUILD_REQUIRES="
	libelf-devel
"

inherit cmake

src_test()
{
	cd ${B}
	# without an IOS image it prints its usage and exits 1
	{ ./stable/${PN}.exe 2>&1 || true; } | grep -F "(version ${PV}-" \
		|| error "${PN}.exe did not report version ${PV}"
}
