+	str_addtext(&str, " -l");
+	str_addtext(&str, lib + 3);
+	str_addtext(&str, " > /dev/null 2>&1");
+
+	fflush(stdout);
+	ret = (system(str.buf) == 0);
+
+	remove("build/conftest.c");
+	remove("build/conftest");
+	remove("build/conftest.exe");
+	str_free(&str);
+
+	return ret;
+}
