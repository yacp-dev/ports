  /usr/lib/libvsmbr.dll.a
  /usr/lib/pkgconfig/libvsmbr.pc
  /usr/share/man/man3/libvsmbr.3.gz

(python312-libvsmbr)
  /usr/lib/python3.12/site-packages/pyvsmbr.dll

