HOMEPAGE="https://github.com/mozilla/${PN}"
GIT_URI="https://github.com/mozilla/${PN}.git"
GIT_REV="767aab25013acefbdcc6d68a2a7a2c9081303e3f"

CATEGORY="Libs"
SUMMARY="WebM demuxer"
DESCRIPTION="nestegg is a WebM demuxer library."

LICENSE="ISC"
LICENSE_SPDX="SPDX-License-Identifier: ISC"
LICENSE_URI="LICENSE"

inherit git

CYGCONF_ARGS="
	--disable-doc
"

src_install()
{
	cd ${B}
	cyginstall

	sed -i -e "s|^Version: .*|Version: ${PV%%+*}|" ${D}/usr/lib/pkgconfig/nestegg.pc
}

DOCS="
	README.md
"

PKG_NAMES="
	${PN}
	lib${PN}0
	lib${PN}-devel
"
nestegg_CONTENTS="
	usr/share
"
libnestegg0_CONTENTS="
	usr/bin/cyg*-0.dll
"
libnestegg_devel_CONTENTS="
	usr/include
	usr/lib
"

nestegg_SUMMARY="${SUMMARY} (licensing & readmes)"
libnestegg0_SUMMARY="${SUMMARY} (runtime)"
libnestegg_devel_SUMMARY="${SUMMARY} (development)"
