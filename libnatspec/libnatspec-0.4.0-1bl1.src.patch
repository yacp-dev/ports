+/*! Internal: libiconv does not know some of the names used in the tables
+   (glibc spellings): ISO88595, KOI8R, IBM866, IBM874, MAC-CYRILLIC, MACUKRAINIAN.
+   Writes the name libiconv uses to buf, or returns NULL if there is none */
+static const char *libiconv_name(const char *name, char *buf, size_t size)
+{
+	size_t len;
+	if (!name)
+		return NULL;
+	len = strlen(name);
+	if (len + 3 > size)
+		return NULL;
+	if (!strncasecmp(name, "ISO8859", 7) && isdigit((unsigned char)name[7]))
+		snprintf(buf, size, "ISO-8859-%s", name + 7);
+	else if (!strncasecmp(name, "KOI8", 4) && isalpha((unsigned char)name[4]) && !name[5])
+		snprintf(buf, size, "KOI8-%c", name[4]);
+	else if (!strncasecmp(name, "IBM", 3) && isdigit((unsigned char)name[3]))
+		snprintf(buf, size, "CP%s", name + 3);
+	else if (!strcasecmp(name, "MAC-CYRILLIC"))
+		snprintf(buf, size, "MACCYRILLIC");
+	else if (!strcasecmp(name, "MACUKRAINIAN"))
+		snprintf(buf, size, "MACUKRAINE");
+	else
+		return NULL;
+	return buf;
+}
+
+/*! Internal: iconv_open(), then again with the names libiconv knows */
+static iconv_t open_iconv(const char *tocode, const char *fromcode)
+{
+	char tobuf[64], frombuf[64];
+	const char *to, *from;
+	iconv_t cd = iconv_open(tocode, fromcode);
+	if (cd != (iconv_t)-1)
+		return cd;
+	to = libiconv_name(tocode, tobuf, sizeof(tobuf));
+	from = libiconv_name(fromcode, frombuf, sizeof(frombuf));
+	if (!to && !from)
+		return cd;
+	return iconv_open(to ? to : tocode, from ? from : fromcode);
+}
+
