HOMEPAGE="https://github.com/${PN}/${PN}"
SRC_URI="https://github.com/${PN}/${PN}/archive/refs/tags/v${PV}.tar.gz"

CATEGORY="Science"
SUMMARY="Framework for the simulation of distributed applications"
DESCRIPTION="SimGrid is a scientific instrument to study the behavior of large-scale
distributed systems such as Grids, Clouds, HPC or P2P systems. It can be used
to evaluate heuristics, prototype applications or even assess legacy MPI
applications."

LICENSE="LGPL-2.1-only AND BSD-3-Clause AND LicenseRef-simgrid"
LICENSE_SPDX="SPDX-License-Identifier: LGPL-2.1-only AND BSD-3-Clause AND LicenseRef-simgrid"
LICENSE_URI="COPYING"

BUILD_REQUIRES="
	eigen3
	gcc-fortran
	libboost-devel
	libgvc-devel
"

export CXXFLAGS="${CXXFLAGS} -fpermissive"

inherit cmake

# with LTO, ld fails: "cannot export ...: symbol wrong type (4 vs 3)"
CYGCMAKE_ARGS="
	-Denable_lto=OFF
"

# building the tests and running them takes 31 minutes
YACP_CHECK_TIMEOUT_MINUTES=45

src_test()
{
	cd ${B}
	cygninja tests
	PATH=${B}/lib:${PATH} cygninja test
}

PKG_NAMES="
	simgrid
	libsimgrid4.1
	libsimgrid-devel
"
simgrid_CONTENTS="
	usr/bin/[gst]*
	usr/lib/${PN}/*.exe
	usr/share
"
libsimgrid4_1_CONTENTS="
	usr/bin/cyg*-4.1.dll
"
libsimgrid_devel_CONTENTS="
	usr/include
	usr/lib/lib*.dll.a
	usr/lib/pkgconfig
"
simgrid_SUMMARY="${SUMMARY} (utilities)"
libsimgrid4_1_SUMMARY="${SUMMARY} (runtime)"
libsimgrid_devel_SUMMARY="${SUMMARY} (development)"
