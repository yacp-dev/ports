HOMEPAGE="https://www.unix-ag.uni-kl.de/~auerswal/${PN}/"
SRC_URI="https://www.unix-ag.uni-kl.de/~auerswal/${PN}/${P}.tar.bz2"
PATCH_URI="https://sources.debian.org/data/main/s/ssocr/2.25.1-2/debian/patches/cross.patch"

CATEGORY="Utils"
SUMMARY="Seven Segment Optical Character Recognition"
DESCRIPTION="Seven Segment Optical Character Recognition or ssocr for short is a program to
recognize digits of a seven segment display."

LICENSE="GPL-3.0-or-later"
LICENSE_SPDX="SPDX-License-Identifier: GPL-3.0-or-later"
LICENSE_URI="COPYING"

BUILD_REQUIRES="
	libImlib2-devel
"

src_compile()
{
	cd ${B}
	lndirs
	cygmake
}

src_test()
{
	cd ${B}
	# --version exits with 42 (ssocr.c), not 0
	verbose ./${PN}.exe --version || [ $? -eq 42 ]
}

src_install()
{
	cd ${B}
	dobin ${PN}.exe
	doman ${PN}.1
}
