--- origsrc/libredwg/bindings/perl/Makefile.PL.in	2026-10-26 14:35:20.000000000 +0000
+++ src/libredwg/bindings/perl/Makefile.PL.in	2026-10-26 14:35:39.325926900 +0000
@@ -10,19 +10,18 @@ my $ccopts = ccopts;
 chomp($ccopts);
 
 # we are in bindings/perl. didn't check for out-of-dir configure
+my $libs = '-lredwg';
 if (-d '../../bindings' &&
-    -d '../../src/.libs' &&
-    -d '../../include') {
+    -d '../../src/.libs') {
   # needs to be in front to prefer over installed (old) /usr/local/include
   $ccopts = "-I../../include $ccopts";
   $ldopts = "-L../../src/.libs $ldopts";
   $lddlflags = "-L../../src/.libs $lddlflags";
+  $libs = "-L../../src/.libs $libs";
 } # else link to the installed libredwg
 
 # swig_perl.c is 9MB, too big
 $ccopts =~ s/-O\d //;
-$ldopts .= " -lredwg";
-$lddlflags .= " -lredwg";
 
 WriteMakefile (
   NAME         => 'LibreDWG',
@@ -30,7 +29,7 @@ WriteMakefile (
   ($ccopts ? (CCFLAGS => $ccopts) : ()),
   ($ldopts ? (LDFLAGS => $ldopts) : ()),
   ($lddlflags ? (LDDLFLAGS => $lddlflags) : ()),
-  #LIBS => ['-lredwg'],
+  LIBS => [$libs],
   OPTIMIZE => '',
   clean => { FILES => 'MYMETA.json MYMETA.yml' },
   ($] >= 5.005
