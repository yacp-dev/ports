HOMEPAGE="https://github.com/Viskores/viskores"
SRC_URI="https://github.com/Viskores/viskores/archive/refs/tags/v${PV}.tar.gz"

CATEGORY="Libs"
SUMMARY="Visualization library for many-threaded devices"
DESCRIPTION="Viskores is a toolkit of scientific visualization algorithms for emerging
processor architectures. Viskores supports the fine-grained concurrency for
data analysis and visualization algorithms required to drive extreme scale
computing by providing abstract models for data and execution that can be
applied to a variety of algorithms across many different processor
architectures."

LICENSE="BSD-3-Clause AND BSD-3-Clause-LBNL AND MIT AND Zlib"
LICENSE_SPDX="SPDX-License-Identifier: BSD-3-Clause AND BSD-3-Clause-LBNL AND MIT AND Zlib"
LICENSE_URI="LICENSE.txt"

export CPPFLAGS="${CPPFLAGS} -D_GNU_SOURCE"
export CXXFLAGS="${CXXFLAGS} -Wa,-mbig-obj"

CYGCMAKE_ARGS="
	-DBUILD_SHARED_LIBS:BOOL=ON
	-DViskores_ENABLE_TESTING:BOOL=OFF
	-DViskores_INSTALL_CONFIG_DIR:STRING=lib/cmake/${PN}
	-DViskores_INSTALL_CMAKE_MODULE_DIR:STRING=lib/cmake/${PN}
	-DViskores_INSTALL_SHARE_DIR:STRING=share/${PN}
"

inherit cmake

src_install()
{
	cd ${B}
	ninja_install

	verbose rm -f ${D}/usr/share/${PN}/ViskoresLICENSE.txt
	verbose rm -f ${D}/usr/share/${PN}/ViskoresREADME.md
	verbose sed -i -e "s|^Version: .*|Version: ${PV}|" ${D}/usr/lib/pkgconfig/viskores.pc
}

PKG_NAMES="
	${PN}
	lib${PN}${PV[1]}.${PV[2]}
	lib${PN}-devel
"
viskores_CONTENTS="
	usr/share/doc
"
libviskores1_2_CONTENTS="
	usr/bin/cyg*-${PV[1]}.${PV[2]}.dll
"
libviskores_devel_CONTENTS="
	usr/include
	usr/lib
	usr/share/${PN}
"
viskores_SUMMARY="${SUMMARY} (licensing & readmes)"
libviskores1_2_SUMMARY="${SUMMARY} (runtime)"
libviskores_devel_SUMMARY="${SUMMARY} (development)"
