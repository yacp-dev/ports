HOMEPAGE="https://github.com/GrammarSoft/${PN}"
SRC_URI="https://github.com/GrammarSoft/${PN}/archive/refs/tags/v${PV}.tar.gz"

CATEGORY="Science"
SUMMARY="Tools for the 3rd edition of the Constraint Grammar formalism"
DESCRIPTION="${SUMMARY}"

LICENSE="GPL-3.0-or-later AND ICU"
LICENSE_SPDX="SPDX-License-Identifier: GPL-3.0-or-later AND ICU"
LICENSE_URI="COPYING"

BUILD_REQUIRES="
	libboost-devel
	libicu-devel
	libsqlite3-devel
	python3-devel
	rapidjson-devel
	swig
"

export CPPFLAGS="${CPPFLAGS} -D_GNU_SOURCE"
export LDFLAGS="${LDFLAGS} -Wl,--allow-multiple-definition"

inherit cmake

CYGCMAKE_ARGS="
	-DENABLE_PYTHON_BINDINGS:BOOL=ON
	-DCMAKE_POLICY_VERSION_MINIMUM:STRING=3.5
"

src_test()
{
	cd ${B}
	PATH=${B}/src:${PATH} ninja_test
}

DOCS="
	TODO
	license.icu.txt
"

src_install()
{
	cd ${B}
	ninja_install

	cd ${S}
	docinto newsletters
	dodoc newsletters/*
	insinto /usr/share/file/
	doins ${PN}.magic
}

PKG_NAMES="
	cg3
	libcg3_1
	libcg3-devel
	python312-cg3
"
cg3_CONTENTS="
	usr/bin/cg*
	usr/bin/vislcg3.exe
	usr/share
"
libcg3_1_CONTENTS="
	usr/bin/cyg*-1.dll
"
libcg3_devel_CONTENTS="
	usr/include
	usr/lib/*.dll.a
	usr/lib/pkgconfig
"
python312_cg3_CONTENTS="
	usr/lib/python3.12
"
cg3_SUMMARY="${SUMMARY} (utilities)"
libcg3_1_SUMMARY="${SUMMARY} (runtime)"
libcg3_devel_SUMMARY="${SUMMARY} (development)"
python312_cg3_SUMMARY="${SUMMARY} (python312 bindings)"
