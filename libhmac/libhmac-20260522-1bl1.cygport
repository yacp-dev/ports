HOMEPAGE="https://github.com/libyal/${PN}"
SRC_URI="https://github.com/libyal/${PN}/archive/refs/tags/${PV}.tar.gz"

CATEGORY="Libs"
SUMMARY="Library to support various Hash-based Message Authentication Codes (HMAC)"
DESCRIPTION="libhmac is a library to support various Hash-based Message Authentication
Codes (HMAC)."

LICENSE="LGPL-3.0-or-later"
LICENSE_SPDX="SPDX-License-Identifier: LGPL-3.0-or-later"
LICENSE_URI="COPYING.LESSER"

BUILD_REQUIRES="
	gettext-devel
	libcerror-devel
	libcfile-devel
	libclocale-devel
	libcnotify-devel
	libcpath-devel
	libcsplit-devel
	libcthreads-devel
	libssl-devel
	libuna-devel
	python3-devel
	zlib-devel
"

CYGPORT_USE_UNSTABLE_API=1
src_patch_hook()
{
	cd ${origsrcdir}/${SRC_DIR}
	chmod -R u+x tests/*.{py,sh}
}

CYGCONF_ARGS="
	--enable-python
"

src_test()
{
	cd ${B}
	pushd tests
		for sh in ${S}/tests/*.{py,sh}
		do
			cp -f ${sh} .
		done
	popd
	pushd pyhmac/.libs
		python_tag=$(python3 -c 'import sysconfig; print(sysconfig.get_config_var("EXT_SUFFIX"))')
		cp -a pyhmac.dll pyhmac${python_tag}
		cp -a pyhmac.dll ${B}/tests/
		cp -a pyhmac${python_tag} ${B}/tests/
	popd
	PATH="${B}/libhmac/.libs:${B}/pyhmac/.libs:${PATH}" \
	PYTHON=python3 \
	CHECK_WITH_STDERR=1 \
	cygtest
	rm -f tests/*.{py,sh} tests/pyhmac*
}

src_install()
{
	cd ${B}
	cyginstall

	pushd ${D}/usr/lib/python3.12/site-packages
		python_tag=$(python3 -c 'import sysconfig; print(sysconfig.get_config_var("EXT_SUFFIX"))')
		cp -a pyhmac.dll pyhmac${python_tag}
	popd
}

DOCS="
	COPYING.LESSER
"

PKG_NAMES="
	${PN}
	${PN}1
	${PN}-devel
	python312-${PN}
"
libhmac_CONTENTS="
	usr/bin/*.exe
	usr/share/doc
	usr/share/man/man1
"
libhmac1_CONTENTS="
	usr/bin/cyg*-1.dll
"
libhmac_devel_CONTENTS="
	usr/include
	usr/lib/lib*.dll.a
	usr/lib/pkgconfig
	usr/share/man/man3
"
python312_libhmac_CONTENTS="
	usr/lib/python3.12
"
libhmac_SUMMARY="${SUMMARY} (utilities)"
libhmac1_SUMMARY="${SUMMARY} (runtime)"
libhmac_devel_SUMMARY="${SUMMARY} (development)"
python312_libhmac_SUMMARY="${SUMMARY} (python312 bindings)"
