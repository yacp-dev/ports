HOMEPAGE="https://github.com/openzim/${PN}"
SRC_URI="https://github.com/openzim/${PN}/archive/refs/tags/${PV}.tar.gz"

CATEGORY="Utils"
SUMMARY="Various ZIM command line tools"
DESCRIPTION="Various ZIM command line tools."

LICENSE="GPL-3.0-or-later AND BSD-3-Clause"
LICENSE_SPDX="SPDX-License-Identifier: GPL-3.0-or-later AND BSD-3-Clause"
LICENSE_URI="LICENSE"

BUILD_REQUIRES="
	file-devel
	libdocopt-devel
	libgumbo-devel
	libgtest-devel
	libicu-devel
	libzim-devel
	Mustache
	zlib-devel
"

export CPPFLAGS="${CPPFLAGS} -D_GNU_SOURCE"

inherit meson

CYGMESON_ARGS="
    -Dwerror=false
"

DIFF_EXCLUDES="
    *.html
"
