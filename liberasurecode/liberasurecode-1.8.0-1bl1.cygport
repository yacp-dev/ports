HOMEPAGE="https://github.com/openstack/${PN}"
SRC_URI="https://github.com/openstack/${PN}/archive/refs/tags/${PV}.tar.gz"
PATCH_URI="
	https://raw.githubusercontent.com/gentoo/gentoo/1601670a564b96ab3f89dfcaf8218e18cc255e4f/dev-libs/liberasurecode/files/liberasurecode-1.6.5-no-werror.patch
"

CATEGORY="Libs"
SUMMARY="Erasure Code API library written in C with pluggable backends"
DESCRIPTION="An API library for Erasure Code, written in C. It provides a number of
pluggable backends, such as Intel ISA-L library."

LICENSE="BSD-2-Clause"
LICENSE_SPDX="SPDX-License-Identifier: BSD-2-Clause"
LICENSE_URI="COPYING"

BUILD_REQUIRES="
	autoconf-archive
	zlib-devel
"

CYGCONF_ARGS="
	--disable-doxygen
	--disable-werror
	--enable-maintainer-mode
"

src_test()
{
	cd ${B}
	# tests linked with -static-libtool-libs get no libtool wrapper, so the
	# in-tree DLLs must be on PATH for them to start
	export PATH=${B}/src/.libs:${B}/src/builtin/null_code/.libs:${B}/src/builtin/xor_codes/.libs:${B}/src/builtin/rs_vand/.libs:${PATH}
	cygmake test
}

DIFF_EXCLUDES="
	config_${PN}.h
"

PKG_NAMES="
	${PN}
	${PN}1
	${PN}-devel
"
liberasurecode_CONTENTS="
	usr/share
"
liberasurecode1_CONTENTS="
	usr/bin/cyg*-1.dll
"
liberasurecode_devel_CONTENTS="
	usr/include
	usr/lib
"
liberasurecode_SUMMARY="${SUMMARY} (licensing & readmes)"
liberasurecode1_SUMMARY="${SUMMARY} (runtime)"
liberasurecode_devel_SUMMARY="${SUMMARY} (development)"
