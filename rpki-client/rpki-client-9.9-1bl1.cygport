HOMEPAGE="https://www.${PN}.org/"
SRC_URI="https://ftp.openbsd.org/pub/OpenBSD/${PN}/${P}.tar.gz"

CATEGORY="Net"
SUMMARY="OpenBSD portable rpki-client"
DESCRIPTION="${SUMMARY}"

LICENSE="ISC AND BSD-2-Clause AND BSD-3-Clause"
LICENSE_SPDX="SPDX-License-Identifier: ISC AND BSD-2-Clause AND BSD-3-Clause"
LICENSE_URI="LICENSE"

BUILD_REQUIRES="
	libexpat-devel
	libretls-devel
	libssl-devel
	zlib-devel
"

REQUIRES="rsync"

export CPPFLAGS="${CPPFLAGS} -D_GNU_SOURCE"

src_test()
{
	cd ${B}
	verbose ./src/${PN}.exe -V
}
