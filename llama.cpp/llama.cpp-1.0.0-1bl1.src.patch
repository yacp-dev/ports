 static std::string tts_norm_ref_path() {
+#ifdef LLAMA_TESTS_SOURCE_DIR
+    std::string path = LLAMA_TESTS_SOURCE_DIR "/test-jinja.cpp";
+#else
     std::string path = __FILE__;
