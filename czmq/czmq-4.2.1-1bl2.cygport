HOMEPAGE="https://${PN}.zeromq.org/"
SRC_URI="https://github.com/zeromq/${PN}/archive/v${PV}.tar.gz"

CATEGORY="Libs"
SUMMARY="High-level C Binding for ZeroMQ"
DESCRIPTION="CZMQ - High-level C Binding for ZeroMQ"

LICENSE="MPL-2.0 AND BSD-3-Clause"
LICENSE_SPDX="SPDX-License-Identifier: MPL-2.0 AND BSD-3-Clause"
LICENSE_URI="LICENSE"

BUILD_REQUIRES="
	libcurl-devel
	liblz4-devel
	libmicrohttpd-devel
	libuuid-devel
	libzmq-devel
"

CYGCONF_ARGS="
	--includedir=/usr/include/${PN}
	--without-docs
	--enable-drafts=yes
"

src_install()
{
	cd ${B}
	cyginstall

	cd ${S}
	dodoc README.txt
}

PKG_NAMES="
	${PN}
	lib${PN}4
	lib${PN}-devel
"
czmq_CONTENTS="
	usr/bin/*.exe
	usr/share/doc
"
libczmq4_CONTENTS="
	usr/bin/cygczmq-4.dll
"
libczmq_devel_CONTENTS="
	usr/include
	usr/lib
	usr/share/zproject
"
czmq_SUMMARY="${SUMMARY} (utilities)"
libczmq4_SUMMARY="${SUMMARY} (runtime)"
libczmq_devel_SUMMARY="${SUMMARY} (development)"
