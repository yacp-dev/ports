HOMEPAGE="https://mcmc-jags.sourceforge.io/"
SRC_URI="mirror://sourceforge/mcmc-jags/JAGS-${PV}.tar.gz"
SRC_DIR="JAGS-${PV}"

CATEGORY="Math"
SUMMARY="Just Another Gibbs Sampler"
DESCRIPTION="JAGS is Just Another Gibbs Sampler. It is a program for analysis of Bayesian
hierarchical models using Markov Chain Monte Carlo (MCMC) simulation not
wholly unlike BUGS."

LICENSE="GPL-2.0-or-later"
LICENSE_SPDX="SPDX-License-Identifier: GPL-2.0-or-later"
LICENSE_URI="COPYING"

BUILD_REQUIRES="
	cppunit
	gcc-fortran
	liblapack-devel
"

src_test()
{
	cd ${B}
	cygmake check
}

DIFF_EXCLUDES="
	libltdl
	m4
"

PKG_NAMES="
	${PN}
	libjags5
	libjags-devel
"
jags_CONTENTS="
	usr/bin/jags
	usr/lib/JAGS
	usr/libexec/*.exe
	usr/share
"
libjags5_CONTENTS="
	usr/bin/cyg*-5.dll
	usr/bin/cygjrmath-*.dll
"
libjags_devel_CONTENTS="
	usr/include
	usr/lib/lib*
	usr/lib/pkgconfig
"
jags_SUMMARY="${SUMMARY} (utilities)"
libjags5_SUMMARY="${SUMMARY} (runtime)"
libjags_devel_SUMMARY="${SUMMARY} (development)"
