--- origsrc/atf-atf-0.26/atf-c/detail/process.h	2026-09-21 20:40:05.000000000 +0000
+++ src/atf-atf-0.26/atf-c/detail/process.h	2026-10-24 23:37:19.832885700 +0000
@@ -35,6 +35,44 @@
 #include <atf-c/detail/list.h>
 #include <atf-c/error_fwd.h>
 
+#if defined(__CYGWIN__) && !defined(WEXITED)
+#include <sys/wait.h>
+
+#include <string.h>
+
+/* Cygwin has no waitid(2): emulate waitid(P_PID, pid, info, WEXITED),
+ * the only form ATF uses, with waitpid(2). */
+#define P_PID 1
+#define WEXITED 4
+
+static inline int
+atf_cygwin_waitid(int idtype, pid_t id, siginfo_t *info, int options)
+{
+    int status;
+    pid_t pid;
+
+    (void)idtype;
+    (void)options;
+
+    pid = waitpid(id, &status, 0);
+    if (pid == -1)
+        return -1;
+
+    memset(info, 0, sizeof(*info));
+    info->si_signo = SIGCHLD;
+    info->si_pid = pid;
+    if (WIFEXITED(status)) {
+        info->si_code = CLD_EXITED;
+        info->si_status = WEXITSTATUS(status);
+    } else {
+        info->si_code = WCOREDUMP(status) ? CLD_DUMPED : CLD_KILLED;
+        info->si_status = WTERMSIG(status);
+    }
+    return 0;
+}
+#define waitid atf_cygwin_waitid
+#endif
+
