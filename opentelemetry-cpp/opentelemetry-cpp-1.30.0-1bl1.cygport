HOMEPAGE="https://github.com/open-telemetry/${PN}"
GIT_URI="https://github.com/open-telemetry/${PN}.git"
GIT_TAG="v${PV}"

CATEGORY="Libs"
SUMMARY="OpenTelemetry C++ Client"
DESCRIPTION="${SUMMARY}"

LICENSE="Apache-2.0"
LICENSE_SPDX="SPDX-License-Identifier: Apache-2.0"
LICENSE_URI="LICENSE"

BUILD_REQUIRES="
	libbenchmark-devel
	libcurl-devel
	libgmock-devel
	libgtest-devel
	libopentracing-devel
	libprometheus-cpp-pull-devel
	libprotobuf-devel
	nlohmann_json
	zlib-devel
"

export CXXFLAGS="${CXXFLAGS} -fpermissive"

# the 1578 tests do not finish within the default 10 minutes on the runner
YACP_CHECK_TIMEOUT_MINUTES=30

inherit cmake
inherit git

CYGCMAKE_ARGS="
	-DBUILD_SHARED_LIBS:BOOL=ON
	-DOTELCPP_VERSIONED_LIBS:BOOL=ON
	-DOTELCPP_WITH_ASYNC_EXPORT_PREVIEW:BOOL=ON
	-DOTELCPP_WITH_ELASTICSEARCH:BOOL=ON
	-DOTELCPP_WITH_OPENTRACING:BOOL=ON
	-DOTELCPP_WITH_OTLP_FILE:BOOL=ON
	-DOTELCPP_WITH_OTLP_HTTP:BOOL=ON
	-DOTELCPP_WITH_OTLP_HTTP_COMPRESSION:BOOL=ON
	-DOTELCPP_WITH_PROMETHEUS:BOOL=ON
	-DOTELCPP_WITH_ZIPKIN:BOOL=ON
"

src_compile()
{
	cd ${B}
	: ${CYGCMAKE_GENERATOR=Ninja}
	cygcmake -DOTELCPP_PROTO_PATH=${S}/third_party/opentelemetry-proto
	cygninja
}

src_test()
{
	cd ${B}
	PATH=`find . -name '*.dll' | xargs dirname | sort | uniq | sed -e "s:.:${B}:" | tr '\n' ':'`:${PATH} ninja_test
}

DOCS="
	*.md
"

PKG_NAMES="
	opentelemetry-cpp
	libopentelemetry1
	libopentelemetry-devel
"
opentelemetry_cpp_CONTENTS="
	usr/share
"
libopentelemetry1_CONTENTS="
	usr/bin/cyg*-1.dll
"
libopentelemetry_devel_CONTENTS="
	usr/include
	usr/lib
"
opentelemetry_cpp_SUMMARY="${SUMMARY} (licensing & readmes)"
libopentelemetry1_SUMMARY="${SUMMARY} (runtime)"
libopentelemetry_devel_SUMMARY="${SUMMARY} (development)"
libopentelemetry_devel_REQUIRES="nlohmann_json libopentracing-devel"
