HOMEPAGE="https://github.com/LanguageMachines/${PN}"
SRC_URI="https://github.com/LanguageMachines/${PN}/archive/refs/tags/v${PV}.tar.gz"

CATEGORY="Text"
SUMMARY="Collection of tools to generate datafiles for Frog"
DESCRIPTION="${SUMMARY}"

LICENSE="GPL-3.0-or-later"
LICENSE_SPDX="SPDX-License-Identifier: GPL-3.0-or-later"
LICENSE_URI="COPYING"

BUILD_REQUIRES="
	autoconf-archive
	libfolia-devel
	libfrog-devel
	libicu-devel
	libmbt-devel
	libmbtserver-devel
	libticcutils-devel
	libtimbl-devel
	libucto-devel
"

DOCS="
	README.*
"

DIFF_EXCLUDES="
	*.m4
"

src_test() {
	cd ${B}/src
	verbose ./froggen.exe --version
}
