HOMEPAGE="https://github.com/jbboehr/${PN}"
GIT_URI="https://github.com/jbboehr/${PN}.git"
GIT_TAG="v${PV}"

CATEGORY="Libs"
SUMMARY="C++ implementation of Mustache"
DESCRIPTION="${SUMMARY}"

LICENSE="MIT"
LICENSE_SPDX="SPDX-License-Identifier: MIT"
LICENSE_URI="LICENSE.md"

BUILD_REQUIRES="
	libyaml-devel
	nlohmann_json
"

inherit cmake
inherit git

src_test()
{
	cd ${B}
	PATH=${B}/src:${PATH} ninja_test
}

src_install()
{
	cd ${B}
	ninja_install

	# the static library is built only for the test suite
	rm ${D}/usr/lib/libmustache.a
	rm ${D}/usr/lib/cmake/mustache/mustacheStaticTargets*.cmake
}

PKG_NAMES="
	libmustache
	libmustache6
	libmustache-devel
"
libmustache_CONTENTS="
	usr/bin/*.exe
	usr/share
"
libmustache6_CONTENTS="
	usr/bin/cyg*-6.dll
"
libmustache_devel_CONTENTS="
	usr/include
	usr/lib
"
libmustache_SUMMARY="${SUMMARY} (utilities)"
libmustache6_SUMMARY="${SUMMARY} (runtime)"
libmustache_devel_SUMMARY="${SUMMARY} (development)"
