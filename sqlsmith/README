  /usr/share/doc/sqlsmith/TODO.org
  /usr/share/doc/sqlsmith/ast.png
  /usr/share/doc/sqlsmith/boring_sqlstates.txt
  /usr/share/doc/sqlsmith/known.txt
  /usr/share/doc/sqlsmith/known_re.txt
  /usr/share/doc/sqlsmith/logo.png

