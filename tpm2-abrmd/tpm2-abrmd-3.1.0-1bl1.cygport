HOMEPAGE="https://github.com/tpm2-software/${PN}"
SRC_URI="https://github.com/tpm2-software/${PN}/archive/refs/tags/${PV}.tar.gz"

CATEGORY="Libs"
SUMMARY="TPM2 Access Broker & Resource Management Daemon implementing the TCG spec"
DESCRIPTION="This is a system daemon implementing the TPM2 access broker (TAB) & Resource
Manager (RM) spec from the TCG. The daemon (tpm2-abrmd) is implemented using
Glib and the GObject system. In this documentation and in the code we use
tpm2-abrmd and tabrmd interchangeably."

LICENSE="BSD-2-Clause"
LICENSE_SPDX="SPDX-License-Identifier: BSD-2-Clause"
LICENSE_URI="LICENSE"

BUILD_REQUIRES="
	autoconf-archive
	dbus
	libcmocka-devel
	libglib2.0-devel
	libtss2-mu-devel
	libtss2-rc-devel
	libtss2-sys-devel
	libtss2-tctildr-devel
	tpm2-tss-devel
"

CYGPORT_USE_UNSTABLE_API=1
src_patch_hook()
{
	cd ${origsrcdir}/${SRC_DIR}
	echo ${PV} > VERSION
}

CYGCONF_ARGS="
	--enable-unit
"

# glib/gobject/gio headers declare their functions dllimport on Cygwin, so the
# objects call them through __imp_g_*, which ld --wrap=g_* does not rewrite and
# the unit tests mocking g_* never reach their wrappers.
CFLAGS+=" -DGLIB_STATIC_COMPILATION -DGOBJECT_STATIC_COMPILATION -DGIO_STATIC_COMPILATION"

DIFF_EXCLUDES="
	*.m4
"

DOCS="
	*.md
	doc/*.md
"

PKG_NAMES="
	tpm2-abrmd
	libtss2-tcti-tabrmd0
	libtss2-tcti-tabrmd-devel
"
tpm2_abrmd_CONTENTS="
	etc
	usr/lib/systemd
	usr/sbin
	usr/share/dbus-*
	usr/share/doc
	usr/share/man/man8
"
libtss2_tcti_tabrmd0_CONTENTS="
	usr/bin/cyg*-0.dll
"
libtss2_tcti_tabrmd_devel_CONTENTS="
	usr/include
	usr/lib/lib*.dll.a
	usr/lib/pkgconfig
	usr/share/man/man[37]
"
tpm2_abrmd_SUMMARY="${SUMMARY} (utilities)"
libtss2_tcti_tabrmd0_SUMMARY="${SUMMARY} (runtime)"
libtss2_tcti_tabrmd_devel_SUMMARY="${SUMMARY} (development)"
