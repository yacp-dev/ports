  /usr/include/igloo/error.h
  /usr/include/igloo/feature.h
  /usr/include/igloo/igloo.h
  /usr/include/igloo/list.h
  /usr/include/igloo/prng.h
  /usr/include/igloo/ro.h
  /usr/include/igloo/rwlock.h
  /usr/include/igloo/sp.h
  /usr/include/igloo/tap.h
  /usr/include/igloo/time.h
  /usr/include/igloo/typedef.h
  /usr/include/igloo/types.h
  /usr/include/igloo/uuid.h
  /usr/lib/libigloo.dll.a
  /usr/lib/pkgconfig/igloo.pc

