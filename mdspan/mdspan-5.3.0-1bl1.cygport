HOMEPAGE="https://github.com/kokkos/${PN}"
SRC_URI="https://github.com/kokkos/${PN}/archive/refs/tags/${PV}.tar.gz"
SRC_DIR="${P}"

CATEGORY="Devel"
SUMMARY="Reference implementation of mdspan targeting C++23"
DESCRIPTION="${SUMMARY}"

LICENSE="Apache-2.0 WITH LLVM-exception"
LICENSE_SPDX="SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception"
LICENSE_URI="LICENSE"

BUILD_REQUIRES="
	libgmock-devel
	libgtest-devel
"

inherit cmake

# the tests are built with -Werror (COMPILE_WARNING_AS_ERROR on each target),
# which trips over warnings in upstream's test code; only the tests are compiled
CXXFLAGS+=" -w"

CYGCMAKE_ARGS="
	-DMDSPAN_ENABLE_TESTS:BOOL=ON
	-DMDSPAN_USE_SYSTEM_GTEST:BOOL=ON
"

DOCS="
	README.md
"
