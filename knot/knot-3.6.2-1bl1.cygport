HOMEPAGE="https://www.${PN}-dns.cz/"
SRC_URI="https://secure.nic.cz/files/${PN}-dns/${P}.tar.xz"

CATEGORY="Net"
SUMMARY="High-performance authoritative-only DNS server"
DESCRIPTION="Knot DNS is a high-performance authoritative-only DNS server which supports
all key features of the domain name system including zone transfers and
DNSSEC."

LICENSE="GPL-2.0-or-later AND LGPL-2.0-or-later AND LGPL-2.1-or-later AND BSD-3-Clause AND ISC AND MIT AND OLDAP-2.8"
LICENSE_SPDX="SPDX-License-Identifier: GPL-2.0-or-later AND LGPL-2.0-or-later AND LGPL-2.1-or-later AND BSD-3-Clause AND ISC AND MIT AND OLDAP-2.8"
LICENSE_URI="COPYING"

BUILD_REQUIRES="
	libdbus1-devel
	libedit-devel
	libfstrm-devel
	libgnutls-devel
	libhiredis-devel
	libidn2-devel
	liblmdb-devel
	libmaxminddb-devel
	libnghttp2-devel
	libngtcp2_crypto_gnutls-devel
	libprotobuf-c-devel
	liburcu-devel
	protobuf-c
"

CYGCONF_ARGS="
	--enable-dnstap
"

src_test()
{
	cd ${B}
	cygmake check
}

DIFF_EXCLUDES="
	doc
"

PKG_NAMES="
	${PN}
	lib${PN}17
	lib${PN}-devel
	libzscanner5
	libzscanner-devel
"
knot_CONTENTS="
	etc
	usr/bin/*.exe
	usr/include/${PN}
	usr/lib/knot
	usr/lib/pkgconfig/knotd.pc
	usr/sbin
	usr/share
"
libknot17_CONTENTS="
	usr/bin/cygknot-17.dll
"
libknot_devel_CONTENTS="
	usr/include/lib${PN}
	usr/lib/libknot.dll.a
	usr/lib/pkgconfig/libknot.pc
"
libzscanner5_CONTENTS="
	usr/bin/cygzscanner-5.dll
"
libzscanner_devel_CONTENTS="
	usr/include/libzscanner
	usr/lib/libzscanner.dll.a
	usr/lib/pkgconfig/libzscanner.pc
"
knot_SUMMARY="${SUMMARY} (utilities)"
libknot17_SUMMARY="${SUMMARY} (runtime / knot)"
libknot_devel_SUMMARY="${SUMMARY} (development / knot)"
libzscanner5_SUMMARY="${SUMMARY} (runtime / zscanner)"
libzscanner_devel_SUMMARY="${SUMMARY} (development / zscanner)"
