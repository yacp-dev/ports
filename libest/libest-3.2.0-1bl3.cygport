HOMEPAGE="https://github.com/cisco/${PN}"
SRC_URI="https://github.com/cisco/${PN}/archive/refs/tags/r${PV}.tar.gz"
SRC_DIR="${PN}-r${PV}"

CATEGORY="Security"
SUMMARY="Library that implements RFC 7030 (Enrollment over Secure Transport)"
DESCRIPTION="This project is a library that implements RFC 7030 (Enrollment over Secure
Transport). EST is used to provision certificates from a CA or RA. EST is a
replacement for SCEP, providing several security enhancements and support for
ECC certificates."

LICENSE="BSD-3-Clause AND BSD-4-Clause AND MIT AND ISC"
LICENSE_SPDX="SPDX-License-Identifier: BSD-3-Clause AND BSD-4-Clause AND MIT AND ISC"
LICENSE_URI="LICENSE"

BUILD_REQUIRES="
	libjsmn-devel
	libssl-devel
"

export CPPFLAGS="${CPPFLAGS} -DDISABLE_BACKTRACE"

CYGCONF_ARGS="
	--enable-maintainer-mode
"

DOCS="
	README.brski
"

# Upstream's test/UT needs CUnit, libcurl and local test servers, so only check
# that the examples start and print their usage (both exit with 255 after it).
src_test() {
	cd ${B}
	local rc=0
	verbose ./example/client/estclient.exe -? > usage.txt || rc=$?
	[ ${rc} -eq 255 ] || return 1
	verbose grep -q '^Usage:' usage.txt || return 1
	rc=0
	verbose ./example/server/estserver.exe -h 2> usage.txt || rc=$?
	[ ${rc} -eq 255 ] || return 1
	verbose grep -q 'EST server options' usage.txt
}

PKG_NAMES="
	${PN}
	${PN}${PV}p
	${PN}-devel
"
libest_CONTENTS="
	usr/bin/*.exe
	usr/share
"
libest3_2_0p_CONTENTS="
	usr/bin/cyg*-3-2-0p.dll
"
libest_devel_CONTENTS="
	usr/include
	usr/lib
"
libest_SUMMARY="${SUMMARY} (utilities)"
libest3_2_0p_SUMMARY="${SUMMARY} (runtime)"
libest_devel_SUMMARY="${SUMMARY} (development)"
