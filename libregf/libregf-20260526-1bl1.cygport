HOMEPAGE="https://github.com/libyal/${PN}"
SRC_URI="https://github.com/libyal/${PN}/archive/refs/tags/${PV}.tar.gz"

CATEGORY="Libs"
SUMMARY="Library and tools to access the Windows NT Registry File (REGF) format"
DESCRIPTION="libregf is a library to access the Windows NT Registry File (REGF) format."

LICENSE="LGPL-3.0-or-later"
LICENSE_SPDX="SPDX-License-Identifier: LGPL-3.0-or-later"
LICENSE_URI="COPYING.LESSER"

CYGPORT_USE_UNSTABLE_API=1
src_patch_hook()
{
	cd ${origsrcdir}/${SRC_DIR}
	chmod u+x tests/*.{py,sh}
}

BUILD_REQUIRES="
	gettext-devel
	libbfio-devel
	libcdata-devel
	libcerror-devel
	libcfile-devel
	libclocale-devel
	libcnotify-devel
	libcpath-devel
	libcsplit-devel
	libcthreads-devel
	libfcache-devel
	libfdata-devel
	libfdatetime-devel
	libfwnt-devel
	libuna-devel
	python3-devel
"

CYGCONF_ARGS="
	--enable-python
"

src_test()
{
	cd ${B}
	pushd tests
		for f in ${S}/tests/*.{py,sh}
		do
			ln -fs ${f} .
		done
		cp -f ${B}/pyregf/.libs/pyregf.dll ./pyregf.cpython-312-x86_64-cygwin.dll
		cp -f ${B}/pyregf/.libs/pyregf.dll ./pyregf.dll
	popd
	pushd pyregf/.libs
		cp -f pyregf.dll pyregf.cpython-312-x86_64-cygwin.dll
	popd
	CHECK_WITH_STDERR=1 PYTHON=python3 PATH="${B}/libregf/.libs:${B}/pyregf/.libs:${PATH}" cygtest
	rm -f tests/*.{py,sh} tests/*.dll pyregf/.libs/pyregf.cpython-312-x86_64-cygwin.dll
}

DOCS="
	COPYING.LESSER
"

PKG_NAMES="
	${PN}
	${PN}1
	${PN}-devel
	python312-${PN}
"
libregf_CONTENTS="
	usr/bin/*.exe
	usr/share/doc
	usr/share/man/man1
"
libregf1_CONTENTS="
	usr/bin/cyg*-1.dll
"
libregf_devel_CONTENTS="
	usr/include
	usr/lib/lib*.dll.a
	usr/lib/pkgconfig
	usr/share/man/man3
"
python312_libregf_CONTENTS="
	usr/lib/python3.12
"
libregf_SUMMARY="${SUMMARY} (utilities)"
libregf1_SUMMARY="${SUMMARY} (runtime)"
libregf_devel_SUMMARY="${SUMMARY} (development)"
python312_libregf_SUMMARY="${SUMMARY} (python312 bindings)"
