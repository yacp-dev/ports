HOMEPAGE="https://github.com/kimtg/${PN}"
SRC_URI="https://github.com/kimtg/${PN}/archive/refs/tags/v${PV}.tar.gz"

CATEGORY="Interpreters"
SUMMARY="Implementation of the Arc programming language"
DESCRIPTION="${SUMMARY}"

LICENSE="Apache-2.0"
LICENSE_SPDX="SPDX-License-Identifier: Apache-2.0"
LICENSE_URI="https://www.apache.org/licenses/LICENSE-2.0.txt"

BUILD_REQUIRES="
	libreadline-devel
"

export CPPFLAGS="${CPPFLAGS} -DREADLINE"

inherit cmake

CYGCMAKE_ARGS="
	-DCMAKE_POLICY_VERSION_MINIMUM:STRING=3.5
	-DREADLINE:BOOL=ON
"

src_test()
{
	cd ${B}
	verbose ./${PN}.exe -v
}

src_install()
{
	cd ${B}
	dobin ./${PN}.exe
}
