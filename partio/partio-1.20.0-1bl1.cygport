HOMEPAGE="https://github.com/wdas/${PN}"
SRC_URI="https://github.com/wdas/${PN}/archive/refs/tags/v${PV}.tar.gz"

CATEGORY="Libs"
SUMMARY="Library for particle IO and manipulation"
DESCRIPTION="This is the initial source code release of partio a tool we used for particle
reading/writing. It started out as an abstraction for the commonalities in
particle models (i.e. accessing many attributes associated with an index or
entity)."

LICENSE="BSD-3-Clause AND MIT"
LICENSE_SPDX="SPDX-License-Identifier: BSD-3-Clause AND MIT"
LICENSE_URI="LICENSE"

BUILD_REQUIRES="
	libGL-devel
	libGLU-devel
	libglut-devel
	libgtest-devel
	python3-devel
	swig
	zlib-devel
"

export CPPFLAGS="${CPPFLAGS} -D_GNU_SOURCE"

inherit cmake

CYGCMAKE_ARGS="
	-DCMAKE_INSTALL_PREFIX_INITIALIZED_TO_DEFAULT:BOOL=OFF
	-DCMAKE_CXX_EXTENSIONS:BOOL=ON
	-DVERSION:STRING=${PV}
	-DWDAS_CXX_STANDARD:STRING=17
"

src_test()
{
	cd ${B}
	PYTHONPATH=${S}/src/tools:${B}/src/py:${PYTHONPATH} PATH=${B}/src/lib:${PATH} ninja_test
}

DIFF_EXCLUDES="
	.pytest_cache
"

PKG_NAMES="
	partio
	libpartio1
	libpartio-devel
	python312-partio
"
partio_CONTENTS="
	usr/bin/part*
	usr/share/doc
	usr/share/partio
"
libpartio1_CONTENTS="
	usr/bin/cyg*-1.dll
"
libpartio_devel_CONTENTS="
	usr/include
	usr/lib/*.dll.a
	usr/lib/pkgconfig
	usr/share/swig
"
python312_partio_CONTENTS="
	usr/lib/python3.12
"
partio_SUMMARY="${SUMMARY} (utilities)"
libpartio1_SUMMARY="${SUMMARY} (runtime)"
libpartio_devel_SUMMARY="${SUMMARY} (development)"
python312_partio_SUMMARY="${SUMMARY} (python312 bindings)"
