HOMEPAGE="https://github.com/libyal/${PN}"
SRC_URI="https://github.com/libyal/${PN}/archive/refs/tags/${PV}.tar.gz"

CATEGORY="Libs"
SUMMARY="Library and tools to access the Microsoft Outlook Nickfile (NK2) format"
DESCRIPTION="libnk2 is a library to access the Microsoft Outlook Nickfile (NK2) format."

LICENSE="LGPL-3.0-or-later"
LICENSE_SPDX="SPDX-License-Identifier: LGPL-3.0-or-later"
LICENSE_URI="COPYING.LESSER"

CYGPORT_USE_UNSTABLE_API=1
src_patch_hook()
{
	cd ${origsrcdir}/${SRC_DIR}
	chmod u+x tests/*.{py,sh}
}

export PYTHON=python3

BUILD_REQUIRES="
	gettext-devel
	libbfio-devel
	libcdata-devel
	libcerror-devel
	libcfile-devel
	libclocale-devel
	libcnotify-devel
	libcpath-devel
	libcsplit-devel
	libcthreads-devel
	libfdatetime-devel
	libfguid-devel
	libfmapi-devel
	libfvalue-devel
	libfwnt-devel
	libuna-devel
	python3-devel
"

CYGCONF_ARGS="
	--enable-python
"

src_test()
{
	cd ${B}
	pushd tests
		for f in ${S}/tests/*.{py,sh}
		do
			cp -f ${f} .
		done
		cp -f ${B}/pynk2/.libs/pynk2.dll .
	popd
	CHECK_WITH_STDERR=1 PYTHON=python3 PATH=${B}/${PN}/.libs:${B}/pynk2/.libs:${PATH} cygtest
	rm -f tests/*.{py,sh} tests/pynk2.dll
}

DOCS="
	COPYING.LESSER
"

PKG_NAMES="
	${PN}
	${PN}_1
	${PN}-devel
	python312-${PN}
"
libnk2_CONTENTS="
	usr/bin/*.exe
	usr/share/doc
	usr/share/man/man1
"
libnk2_1_CONTENTS="
	usr/bin/cyg*-1.dll
"
libnk2_devel_CONTENTS="
	usr/include
	usr/lib/lib*.dll.a
	usr/lib/pkgconfig
	usr/share/man/man3
"
python312_libnk2_CONTENTS="
	usr/lib/python3.12
"
libnk2_SUMMARY="${SUMMARY} (utilities)"
libnk2_1_SUMMARY="${SUMMARY} (runtime)"
libnk2_devel_SUMMARY="${SUMMARY} (development)"
python312_libnk2_SUMMARY="${SUMMARY} (python312 bindings)"
