HOMEPAGE="https://github.com/rnpgp/${PN}"
SRC_URI="https://github.com/rnpgp/${PN}/releases/download/v${PV}/${PN}-v${PV}.tar.gz"
SRC_DIR="${PN}-v${PV}"

CATEGORY="Libs"
SUMMARY="High performance C++ OpenPGP library"
DESCRIPTION="${SUMMARY}"

LICENSE="BSD-2-Clause AND Apache-2.0 AND MIT"
LICENSE_SPDX="SPDX-License-Identifier: BSD-2-Clause AND Apache-2.0 AND MIT"
LICENSE_URI="LICENSE.md"

# git: without it, cmake/version.cmake's execute_process() of
# GIT_EXECUTABLE-NOTFOUND fails to spawn, and project()'s next
# execute_process (uname -r) never returns.
BUILD_REQUIRES="
	asciidoctor
	git
	libbz2-devel
	libgtest-devel
	libjson-c-devel
	libssl-devel
	zlib-devel
"

export CPPFLAGS="${CPPFLAGS} -D_GNU_SOURCE"

inherit cmake

CYGCMAKE_ARGS="
	-DBUILD_SHARED_LIBS:BOOL=ON
	-DCRYPTO_BACKEND:STRING=openssl
	-DDOWNLOAD_GTEST:BOOL=OFF
"

src_test()
{
	cd ${B}
	PATH=${B}/src/lib:${PATH} ninja_test
}

PKG_NAMES="
	rnp
	librnp0
	librnp-devel
"
rnp_CONTENTS="
	usr/bin/*.exe
	usr/share/doc
	usr/share/man/man1
"
librnp0_CONTENTS="
	usr/bin/cyg*-0.dll
"
librnp_devel_CONTENTS="
	usr/include
	usr/lib
	usr/share/man/man3
"
rnp_SUMMARY="${SUMMARY} (utilities)"
librnp0_SUMMARY="${SUMMARY} (runtime)"
librnp_devel_SUMMARY="${SUMMARY} (development)"
