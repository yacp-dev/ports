HOMEPAGE="https://github.com/LemonBoy/bar"
SRC_URI="https://github.com/LemonBoy/bar/archive/refs/tags/v${PV}.tar.gz"
SRC_DIR="bar-${PV}"

CATEGORY="Utils"
SUMMARY="Featherweight lemon-scented bar"
DESCRIPTION="lemonbar (formerly known as bar) is a lightweight statusbar based on XCB.
Provides full UTF-8 support, basic formatting, RandR and Xinerama support and
EWMH compliance without wasting your precious memory."

LICENSE="MIT"
LICENSE_SPDX="SPDX-License-Identifier: MIT"
LICENSE_URI="LICENSE"

BUILD_REQUIRES="
	libxcb-randr-devel
	libxcb-devel
	libxcb-xinerama-devel
	perl
"

src_compile()
{
	cd ${B}
	lndirs
	# The Makefile appends to the environment CFLAGS; Xinerama code is built only with WITH_XINERAMA
	CFLAGS+=" -DWITH_XINERAMA"
	cygmake
	cygmake doc
}

DOCS="
	README.pod
"
