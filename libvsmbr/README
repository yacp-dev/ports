  /usr/share/doc/libvsmbr/COPYING.LESSER
  /usr/share/doc/libvsmbr/ChangeLog
  /usr/share/doc/libvsmbr/Master Boot Record (MBR) partition table format.asciidoc
  /usr/share/doc/libvsmbr/README
  /usr/share/man/man1/vsmbrinfo.1.gz

(libvsmbr1)
  /usr/bin/cygvsmbr-1.dll

(libvsmbr-devel)
  /usr/include/libvsmbr.h
