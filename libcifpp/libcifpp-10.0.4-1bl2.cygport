HOMEPAGE="https://github.com/PDB-REDO/${PN}"
SRC_URI="https://github.com/PDB-REDO/${PN}/archive/refs/tags/v${PV}.tar.gz"

CATEGORY="Libs"
SUMMARY="Library containing code to manipulate mmCIF and PDB files"
DESCRIPTION="${SUMMARY}"

LICENSE="BSD-2-Clause"
LICENSE_SPDX="SPDX-License-Identifier: BSD-2-Clause"
LICENSE_URI="LICENSE"

BUILD_REQUIRES="
	libCatch2-devel
	libpcre2-devel
	libsqlite3-devel
	zlib-devel
"

inherit cmake

CYGCMAKE_ARGS="
	-DBUILD_EXAMPLES:BOOL=OFF
	-DBUILD_SHARED_LIBS:BOOL=ON
	-DBUILD_TESTING:BOOL=ON
	-DCMAKE_SHARED_LINKER_FLAGS:STRING=-Wl,--export-all-symbols
	-DCMAKE_WINDOWS_EXPORT_ALL_SYMBOLS:BOOL=ON
"

src_test()
{
	cd ${B}
	PATH=${B}:${PATH} ninja_test
}

src_install()
{
	cd ${B}
	ninja_install

	verbose mv ${D}/usr/etc ${D}/etc
}

DOCS="
	changelog
"

DIFF_EXCLUDES="
	*.cif
	*.hpp
"

PKG_NAMES="
	libcifpp
	libcifpp${PV[1]}
	libcifpp-devel
"
libcifpp_CONTENTS="
	etc
	usr/share
"
libcifpp10_CONTENTS="
	usr/bin/cyg*-${PV[1]}.dll
"
libcifpp_devel_CONTENTS="
	usr/include
	usr/lib
"
libcifpp_SUMMARY="${SUMMARY} (licensing & readmes)"
libcifpp10_SUMMARY="${SUMMARY} (runtime)"
libcifpp_devel_SUMMARY="${SUMMARY} (development)"

libcifpp_devel_REQUIRES="
	libsqlite3-devel
	zlib-devel
"
