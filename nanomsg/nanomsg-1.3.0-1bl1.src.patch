@@ -172,6 +172,15 @@ int nn_usock_start (struct nn_usock *sel
     if (nn_slow (s < 0))
        return -errno;
 
+#if defined __CYGWIN__
+    /*  Cygwin's AF_UNIX handshake blocks accept() until the connecting
+        side, served by the same worker thread, sends its secret. */
+    if (domain == AF_UNIX) {
+        int rc = setsockopt (s, SOL_SOCKET, SO_PEERCRED, NULL, 0);
+        errno_assert (rc == 0);
+    }
+#endif
+
     nn_usock_init_from_fd (self, s);
 
     /*  Start the state machine. */
--- origsrc/nanomsg-1.3.0/src/transports/ipc/bipc.c	2026-10-04 20:33:39.000000000 +0000
+++ src/nanomsg-1.3.0/src/transports/ipc/bipc.c	2026-10-22 08:42:16.818347500 +0000
@@ -361,8 +361,16 @@ static int nn_bipc_listen (struct nn_bip
 #elif defined NN_HAVE_UNIX_SOCKETS
     fd = socket (AF_UNIX, SOCK_STREAM, 0);
     if (fd >= 0) {
+#if defined __CYGWIN__
+        /*  Cygwin's non-blocking connect() never fails with ECONNREFUSED
+            right away, so probe with a blocking one, without the AF_UNIX
+            handshake a nanomsg listener doesn't answer. */
+        rc = setsockopt (fd, SOL_SOCKET, SO_PEERCRED, NULL, 0);
+        errno_assert (rc == 0);
+#else
         rc = fcntl (fd, F_SETFL, O_NONBLOCK);
         errno_assert (rc != -1 || errno == EINVAL);
+#endif
         rc = connect (fd, (struct sockaddr*) &ss, addrlen);
         if (rc == -1 && errno == ECONNREFUSED)
             nn_ipc_unlink (addr);
