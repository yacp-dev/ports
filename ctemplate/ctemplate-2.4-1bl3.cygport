HOMEPAGE="https://github.com/OlafvdSpek/${PN}"
SRC_URI="https://github.com/OlafvdSpek/${PN}/archive/refs/tags/${P}.tar.gz"
PATCH_URI="
	https://sources.debian.org/data/main/c/ctemplate/2.4-4/debian/patches/upstream_Fixed-compilation-error-string-doesn-t-name-a-type.patch
	https://sources.debian.org/data/main/c/ctemplate/2.4-4/debian/patches/upstream_C-20-gcc10-fix-remove-hint-removed-typedef.patch
"
SRC_DIR="${PN}-${P}"

CATEGORY="Libs"
SUMMARY="Powerful but simple template language for C++"
DESCRIPTION="CTemplate is a simple but powerful template language for C++. It emphasizes
separating logic from presentation: it is impossible to embed application
logic in this template language."

LICENSE="BSD-3-Clause"
LICENSE_SPDX="SPDX-License-Identifier: BSD-3-Clause"
LICENSE_URI="COPYING"

PKG_NAMES="
	${PN}
	lib${PN}3
	lib${PN}-devel
"
ctemplate_CONTENTS="
	usr/bin/*.exe
	usr/bin/template-converter
	usr/share/doc/Cygwin
	usr/share/doc/${PN}/[ACNR]*
"
libctemplate3_CONTENTS="
	usr/bin/cyg*-3.dll
"
libctemplate_devel_CONTENTS="
	usr/include
	usr/lib
	usr/share/doc/${PN}/html
"
ctemplate_SUMMARY="${SUMMARY} (utilities)"
libctemplate3_SUMMARY="${SUMMARY} (runtime)"
libctemplate_devel_SUMMARY="${SUMMARY} (development)"

CYGPORT_USE_UNSTABLE_API=1
src_patch_hook()
{
	cd ${origsrcdir}/${SRC_DIR}
	verbose sed -i -e "s/\[2\.3\]/[${PV}]/" configure.ac
}
