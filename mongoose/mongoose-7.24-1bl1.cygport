HOMEPAGE="https://github.com/cesanta/${PN}"
SRC_URI="
	https://github.com/cesanta/${PN}/archive/refs/tags/${PV}.tar.gz
	CMakeLists.txt
"
PATCH_URI="
	mongoose-7.24-queue-printf-test.patch
"

CATEGORY="Libs"
SUMMARY="Embedded web server for C/C++"
DESCRIPTION="Mongoose is the most easy to use web server on the planet. A web server of
choice for Web developers (PHP, Ruby, Python, etc) and Web designers."

LICENSE="GPL-2.0-only"
LICENSE_SPDX="SPDX-License-Identifier: GPL-2.0-only"
LICENSE_URI="LICENSE"

BUILD_REQUIRES="
	libssl-devel
"

inherit cmake

PKG_NAMES="
	${PN}
	lib${PN}7.24
	lib${PN}-devel
"
mongoose_CONTENTS="
	usr/share
"
libmongoose7_24_CONTENTS="
	usr/bin/cyg*-7-24.dll
"
libmongoose_devel_CONTENTS="
	usr/include
	usr/lib
"
mongoose_SUMMARY="${SUMMARY} (licensing & readmes)"
libmongoose7_24_SUMMARY="${SUMMARY} (runtime)"
libmongoose_devel_SUMMARY="${SUMMARY} (development)"
