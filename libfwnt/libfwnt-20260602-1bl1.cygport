HOMEPAGE="https://github.com/libyal/${PN}"
SRC_URI="https://github.com/libyal/${PN}/archive/refs/tags/${PV}.tar.gz"

CATEGORY="Libs"
SUMMARY="Library for Windows NT data types"
DESCRIPTION="libfwnt is a library for Windows NT data types."

LICENSE="LGPL-3.0-or-later"
LICENSE_SPDX="SPDX-License-Identifier: LGPL-3.0-or-later"
LICENSE_URI="COPYING.LESSER"

BUILD_REQUIRES="
	gettext-devel
	libcdata-devel
	libcerror-devel
	libcnotify-devel
	libcthreads-devel
	python3-devel
"

export PYTHON=python3

CYGPORT_USE_UNSTABLE_API=1
src_patch_hook()
{
	cd ${origsrcdir}/${SRC_DIR}/tests
	chmod u+x *.sh *.py
}

CYGCONF_ARGS="
	--enable-python
"

src_test()
{
	cd ${B}
	pushd tests
		for sh in ${S}/tests/*.{py,sh}
		do
			cp -f ${sh} .
		done
	popd
	pushd pyfwnt/.libs
		python_tag=$(python3 -c 'import sysconfig; print(sysconfig.get_config_var("EXT_SUFFIX"))')
		cp -a pyfwnt.dll pyfwnt${python_tag}
		cp -a pyfwnt.dll ${B}/tests/
		cp -a pyfwnt${python_tag} ${B}/tests/
	popd
	PATH="${B}/libfwnt/.libs:${B}/pyfwnt/.libs:${PATH}" \
	PYTHON=python3 \
	CHECK_WITH_STDERR=1 \
	cygtest
	rm -f tests/*.{py,sh} tests/pyfwnt*
}

src_install()
{
	cd ${B}
	cyginstall

	pushd ${D}/usr/lib/python3.12/site-packages
		python_tag=$(python3 -c 'import sysconfig; print(sysconfig.get_config_var("EXT_SUFFIX"))')
		cp -a pyfwnt.dll pyfwnt${python_tag}
	popd
}

DOCS="
	COPYING.LESSER
"

PKG_NAMES="
	${PN}
	${PN}1
	${PN}-devel
	python312-${PN}
"
libfwnt_CONTENTS="
	usr/share/doc
"
libfwnt1_CONTENTS="
	usr/bin/cyg*-1.dll
"
libfwnt_devel_CONTENTS="
	usr/include
	usr/lib/${PN}.dll.a
	usr/lib/pkgconfig
	usr/share/man
"
python312_libfwnt_CONTENTS="
	usr/lib/python3.12
"
libfwnt_SUMMARY="${SUMMARY} (licensing & readmes)"
libfwnt1_SUMMARY="${SUMMARY} (runtime)"
libfwnt_devel_SUMMARY="${SUMMARY} (development)"
python312_libfwnt_SUMMARY="${SUMMARY} (python312 bindings)"
