HOMEPAGE="https://github.com/alibaba/${PN}"
SRC_URI="https://github.com/alibaba/${PN}/archive/refs/tags/v${PV}.tar.gz"

CATEGORY="Libs"
SUMMARY="C++ library for parallel graph processing"
DESCRIPTION="libgrape-lite is a C++ library from Alibaba for parallel graph processing."

LICENSE="Apache-2.0 AND Apache-2.0 WITH LLVM-exception AND BSL-1.0 AND MIT AND Zlib"
LICENSE_SPDX="SPDX-License-Identifier: Apache-2.0 AND Apache-2.0 WITH LLVM-exception AND BSL-1.0 AND MIT AND Zlib"
LICENSE_URI="LICENSE"

BUILD_REQUIRES="
	libgflags-devel
	libglog-devel
	libopenmpi-devel
	librdkafka++-devel
	librdkafka-devel
"

export CPPFLAGS="${CPPFLAGS} -D_GNU_SOURCE -DGLOG_USE_GLOG_EXPORT"

inherit cmake

CYGCMAKE_ARGS="
	-DBUILD_LIBGRAPELITE_DOCS:BOOL=OFF
	-DCMAKE_POLICY_VERSION_MINIMUM:STRING=3.5
"

DIFF_EXCLUDES="
	thirdparty
"

PKG_NAMES="
	libgrape-lite
	libgrape-lite0
	libgrape-lite-devel
"
libgrape_lite_CONTENTS="
	usr/bin/*.exe
	usr/share
"
libgrape_lite0_CONTENTS="
	usr/bin/cyg*-0.dll
"
libgrape_lite_devel_CONTENTS="
	usr/include
	usr/lib
"
libgrape_lite_SUMMARY="${SUMMARY} (utilities)"
libgrape_lite0_SUMMARY="${SUMMARY} (runtime)"
libgrape_lite_devel_SUMMARY="${SUMMARY} (development)"
