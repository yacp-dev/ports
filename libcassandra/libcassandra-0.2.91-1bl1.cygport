HOMEPAGE="https://github.com/matkor/${PN}"
SRC_URI="https://github.com/matkor/${PN}/archive/refs/tags/${PV}.tar.gz"
PATCH_URI="
	https://raw.githubusercontent.com/pld-linux/libcassandra/5c69e93a51f1adb728cb59c3e1af32246af097e9/libcassandra-ac.patch
	https://raw.githubusercontent.com/pld-linux/libcassandra/5c69e93a51f1adb728cb59c3e1af32246af097e9/libcassandra-boost-tr1-functional-compat.patch
"

CATEGORY="Libs"
SUMMARY="High level C++ client for Cassandra"
DESCRIPTION="A C++ wrapper library for the interface to cassandra generated by thrift. This library is based on the Java client hector."

LICENSE="BSD-3-Clause"
LICENSE_SPDX="SPDX-License-Identifier: BSD-3-Clause"
LICENSE_URI="COPYING"

BUILD_REQUIRES="
	libboost-devel
	libthrift-devel
"

export CPPFLAGS="${CPPFLAGS} -I/usr/include/thrift"
export CXXFLAGS="${CXXFLAGS} -std=gnu++14 -Wno-error=return-type"

DIFF_EXCLUDES="
	Makefile.in
	config.h.in
	config
"

PKG_NAMES="
	${PN}
	${PN}3
	${PN}-devel
	libgenthrift3
	libgenthrift-devel
"

libcassandra_CONTENTS="
	usr/share
"
libcassandra3_CONTENTS="
	usr/bin/cygcassandra-3.dll
"
libcassandra_devel_CONTENTS="
	usr/include/libcassandra
	usr/lib/libcassandra.*
	usr/lib/pkgconfig/libcassandra.pc
"
libgenthrift3_CONTENTS="
	usr/bin/cyggenthrift-3.dll
"
libgenthrift_devel_CONTENTS="
	usr/include/libgenthrift
	usr/lib/libgenthrift.*
	usr/lib/pkgconfig/libgenthrift.pc
"

libcassandra_SUMMARY="${SUMMARY} (licensing & readmes)"
libcassandra3_SUMMARY="${SUMMARY} (runtime)"
libcassandra_devel_SUMMARY="${SUMMARY} (development)"
libgenthrift3_SUMMARY="${SUMMARY} (runtime / genthrift)"
libgenthrift_devel_SUMMARY="${SUMMARY} (development / genthrift)"
