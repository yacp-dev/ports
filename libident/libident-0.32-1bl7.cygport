HOMEPAGE="https://www.remlab.net/files/${PN}/ident.3.html"
SRC_URI="https://www.remlab.net/files/${PN}/${P}.tar.bz2"
PATCH_URI="
	https://sources.debian.org/data/main/libi/libident/0.32-5/debian/patches/0001-PH-patch-id_parse.c.patch
	https://sources.debian.org/data/main/libi/libident/0.32-5/debian/patches/0002-PH-fix-support.c.patch
	https://raw.githubusercontent.com/gentoo/gentoo/4eb72a46071c8858ed00dcde39117d9766399cd1/net-libs/libident/files/libident-0.32-fix_c23.patch
"

CATEGORY="Libs"
SUMMARY="Small C library for RFC 1413 Identification protocol"
DESCRIPTION="LibIdent is a small C library for interfacing with RFC 1413 Identification
protocol servers, which are used for identifying users. LibIdent supports both
IPv4 and IPv6 addresses transparently."

LICENSE="LicenseRef-libident"
LICENSE_SPDX="SPDX-License-Identifier: LicenseRef-libident"
LICENSE_URI="COPYING"

CYGPORT_USE_UNSTABLE_API=1
src_patch_hook()
{
	cd ${origsrcdir}/${SRC_DIR}
	rm -f aclocal.m4 configure
	find . -name Makefile.in | xargs rm -f
}

CYGCONF_ARGS="
	--enable-testers
"

src_install()
{
	cd ${B}
	cyginstall
	${S}/admin/mkinstalldirs ${D}/etc/xinetd.d/
	install -m755 ${S}/identtestd-xinetd ${D}/etc/xinetd.d/identtestd
}

PKG_NAMES="
	${PN}
	${PN}0
	${PN}-devel
"
libident_CONTENTS="
	etc
	usr/sbin
	usr/share/doc
	usr/share/man/man8
"
libident0_CONTENTS="
	usr/bin/cyg*-0.dll
"
libident_devel_CONTENTS="
	usr/include
	usr/lib
	usr/share/man/man3
"
libident_SUMMARY="${SUMMARY} (utilities)"
libident0_SUMMARY="${SUMMARY} (runtime)"
libident_devel_SUMMARY="${SUMMARY} (development)"
