HOMEPAGE="https://github.com/libimobiledevice/${PN}"
SRC_URI="https://github.com/libimobiledevice/${PN}/archive/refs/tags/${PV}.tar.gz"

CATEGORY="Libs"
SUMMARY="Cross-platform protocol library to communicate with iOS devices"
DESCRIPTION="${SUMMARY}"

LICENSE="LGPL-2.1-or-later AND GPL-2.0-or-later AND Zlib AND MIT"
LICENSE_SPDX="SPDX-License-Identifier: LGPL-2.1-or-later AND GPL-2.0-or-later AND Zlib AND MIT"
LICENSE_URI="COPYING.LESSER"

BUILD_REQUIRES="
	libimobiledevice-glue1.0-devel
	libplist2.0-devel
	libreadline-devel
	libssl-devel
	libtatsu-devel
	libusbmuxd2.0-devel
"

export CPPFLAGS="${CPPFLAGS} -D_GNU_SOURCE"

CYGPORT_USE_UNSTABLE_API=1
src_patch_hook()
{
	cd ${origsrcdir}/${SRC_DIR}
	echo ${PV} > .tarball-version
}

CYGCONF_ARGS="
	--without-cython
"

DOCS="
	COPYING
	COPYING.LESSER
"

src_install()
{
	cd ${B}
	cyginstall

	cd ${S}
	insinto /usr/share/doc/${PN}/3rd_party/ed25519
	doins 3rd_party/ed25519/LICENSE
	insinto /usr/share/doc/${PN}/3rd_party/libsrp6a-sha512
	doins 3rd_party/libsrp6a-sha512/LICENSE
}

src_test()
{
	cd ${B}/tools
	verbose ./afcclient.exe --version
	verbose ./idevice_id.exe --version
	verbose ./idevicebackup.exe --version
	verbose ./idevicebackup2.exe --version
	verbose ./idevicebtlogger.exe --version
}

PKG_NAMES="
	libimobiledevice
	libimobiledevice1.0_6
	libimobiledevice1.0-devel
"
libimobiledevice_CONTENTS="
	usr/bin/*.exe
	usr/share
"
libimobiledevice1_0_6_CONTENTS="
	usr/bin/cyg*-6.dll
"
libimobiledevice1_0_devel_CONTENTS="
	usr/include
	usr/lib
"
libimobiledevice_SUMMARY="${SUMMARY} (utilities)"
libimobiledevice1_0_6_SUMMARY="${SUMMARY} (runtime)"
libimobiledevice1_0_devel_SUMMARY="${SUMMARY} (development)"
