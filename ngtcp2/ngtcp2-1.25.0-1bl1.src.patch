@@ -54,6 +54,11 @@
 #include "http.h"
 #include "template.h"
 
+#if defined(__CYGWIN__) && !defined(IPV6_RECVPKTINFO)
+// Winsock enables receiving IPV6_PKTINFO with IPV6_PKTINFO itself.
+#  define IPV6_RECVPKTINFO IPV6_PKTINFO
+#endif // __CYGWIN__ && !IPV6_RECVPKTINFO
+
 using namespace ngtcp2;
 using namespace std::literals;
 
@@ -2263,7 +2268,13 @@ std::span<const uint8_t> Server::send_pa
     cm->cmsg_len = CMSG_LEN(sizeof(in_pktinfo));
     auto addrin = reinterpret_cast<sockaddr_in *>(local_addr.addr);
     in_pktinfo pktinfo{
+#ifdef __CYGWIN__
+      // Cygwin's in_pktinfo has no ipi_spec_dst; Winsock takes the
+      // source address from ipi_addr.
+      .ipi_addr = addrin->sin_addr,
+#else  // !__CYGWIN__
       .ipi_spec_dst = addrin->sin_addr,
+#endif // !__CYGWIN__
     };
     memcpy(CMSG_DATA(cm), &pktinfo, sizeof(pktinfo));
 
