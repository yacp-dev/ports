HOMEPAGE="https://github.com/RafaelOstertag/${PN}"
SRC_URI="https://github.com/RafaelOstertag/${PN}/archive/refs/tags/v${PV}.tar.gz"

CATEGORY="Libs"
SUMMARY="Curses abstraction used by YAPET"
DESCRIPTION="libyacurs is a curses widget library for fast development of curses
applications."

LICENSE="GPL-3.0-or-later"
LICENSE_SPDX="SPDX-License-Identifier: GPL-3.0-or-later"
LICENSE_URI="COPYING"

BUILD_REQUIRES="
	gettext-devel
	libintl-devel
	libncurses-devel
	util-linux
"

DIFF_EXCLUDES="
	stamp-po
"

src_test()
{
	cd ${B}
	# the curses tests exit 77 (skip) unless stdin and stdout are ttys: CI has
	# none, so give them a pty
	TERM=${TERM:-xterm} verbose script -qec "make -k ${MAKEOPTS} check TESTS_ENVIRONMENT='timeout --foreground -k 5 60'" /dev/null
}

PKG_NAMES="
	libyacurs
	libyacurs0
	libyacurs-devel
"
libyacurs_CONTENTS="
	usr/share/doc
"
libyacurs0_CONTENTS="
	usr/bin/cyg*-0.dll
	usr/share/locale
"
libyacurs_devel_CONTENTS="
	usr/include
	usr/lib
"
libyacurs_SUMMARY="${SUMMARY} (licensing & readmes)"
libyacurs0_SUMMARY="${SUMMARY} (runtime)"
libyacurs_devel_SUMMARY="${SUMMARY} (development)"
