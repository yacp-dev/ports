HOMEPAGE="https://github.com/troglobit/${PN}"
SRC_URI="https://github.com/troglobit/${PN}/archive/refs/tags/v${PV}.tar.gz"

CATEGORY="Libs"
SUMMARY="Embeddable Multicast DNS Daemon"
DESCRIPTION="${SUMMARY}"

LICENSE="BSD-3-Clause"
LICENSE_SPDX="SPDX-License-Identifier: BSD-3-Clause"
LICENSE_URI="LICENSE"

BUILD_REQUIRES="
	libcmocka-devel
"
CYGCONF_ARGS="
	--enable-static
	--enable-tests
"

PKG_NAMES="
	mdnsd
	libmdnsd2
	libmdnsd-devel
"
mdnsd_CONTENTS="
	etc
	usr/bin/*.exe
	usr/sbin
	usr/share
"
libmdnsd2_CONTENTS="
	usr/bin/cygmdnsd-2.dll
"
libmdnsd_devel_CONTENTS="
	usr/include
	usr/lib
"
mdnsd_SUMMARY="${SUMMARY} (utilities)"
libmdnsd2_SUMMARY="${SUMMARY} (runtime)"
libmdnsd_devel_SUMMARY="${SUMMARY} (development)"

src_install()
{
	cd ${B}
	cyginstall
	rm -f ${D}/usr/lib/libmdnsd.{a,la}
}

src_test()
{
	local t

	cd ${B}/test
	for t in xht addr answer label sdtxt conflict
	do
		make check TESTS=${t} || error "unit test ${t} failed"
	done
}
