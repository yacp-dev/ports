+    enable_testing()
+    add_test(NAME efpmd_total_1a COMMAND efpmd ${CMAKE_CURRENT_SOURCE_DIR}/tests/total_1a.in WORKING_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}/tests)
+    set_tests_properties(efpmd_total_1a PROPERTIES PASS_REGULAR_EXPRESSION "COMPLETED SUCCESSFULLY")
+endif()
