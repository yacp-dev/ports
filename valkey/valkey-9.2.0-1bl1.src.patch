+# Cygwin's ps is not procps and ignores "j": procps-ng installs it as procps.
+proc ps_j pid {
+    if {[string match CYGWIN* $::tcl_platform(os)]} {
+        return [exec procps j $pid]
+    }
+    return [exec ps j $pid]
+}
+
 # Return true if the specified process is paused by pause_process.
